Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"S", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "knots"}], "}"}], ",", 
           RowBox[{"ib", "-", "1"}], ",", "x"}], "]"}], 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "knots"}], "}"}], ",", 
           RowBox[{"jb", "-", "1"}], ",", "x"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ib", ",", "1", ",", "NumBasis"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"jb", ",", "1", ",", "NumBasis"}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"V", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "knots"}], "}"}], ",", 
           RowBox[{"ib", "-", "1"}], ",", "x"}], "]"}], 
         RowBox[{"VHO", "[", "x", "]"}], 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "knots"}], "}"}], ",", 
           RowBox[{"jb", "-", "1"}], ",", "x"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ib", ",", "1", ",", "NumBasis"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"jb", ",", "1", ",", "NumBasis"}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"T", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", "1"}], "2"], 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", ",", "knots"}], "}"}], ",", 
           RowBox[{"ib", "-", "1"}], ",", "x"}], "]"}], 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"BSplineBasis", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"d", ",", "knots"}], "}"}], ",", 
               RowBox[{"jb", "-", "1"}], ",", "x"}], "]"}], ",", "x"}], "]"}],
            ",", "x"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ib", ",", "1", ",", "NumBasis"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"jb", ",", "1", ",", "NumBasis"}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"H", "=", 
    RowBox[{"T", "+", "V"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Eigensystem", "[", 
     RowBox[{"{", 
      RowBox[{"H", ",", "S"}], "}"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]], "Input",
