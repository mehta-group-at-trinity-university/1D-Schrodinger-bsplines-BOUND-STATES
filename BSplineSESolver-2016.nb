Cell["Evaluate the second cubic B-spline basis with given knots:", \
"ExampleText",
 CellID->964594262],

Cell[BoxData[
 RowBox[{
  RowBox[{"knots", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
     RowBox[{"1", "/", "3"}], ",", 
     RowBox[{"2", "/", "3"}], ",", "1", ",", "1", ",", "1", ",", "1"}], 
    "}"}]}], ";"}]], "Input",
 CellID->209421647],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BSplineBasis", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "knots"}], "}"}], ",", "2", ",", "0.5"}], 
  "]"}]], "Input",
