  RowBox[{
   RowBox[{"xfirst", "[", 
    RowBox[{"ib_", ",", "jb_"}], "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"knots", "[", 
      RowBox[{"[", "ib", "]"}], "]"}], ",", 
     RowBox[{"knots", "[", 
      RowBox[{"[", "jb", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
