Cell[TextData[{
 "How do we deal with integrals of b-splines with arbitrary functions, for \
example when calculating matrix elements of the potential energy?  Say ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "mn"], "=", 
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"\[DifferentialD]", "x"}], " ", 
      RowBox[{
       SubscriptBox["B", "m"], "(", "x", ")"}], 
      RowBox[{"V", "(", "x", ")"}], 
      RowBox[{
       SubscriptBox["B", "n"], "(", "x", ")"}]}]}]}], TraditionalForm]]],
 "."
}], "Text",
 CellChangeTimes->{{3.6727134545785913`*^9, 3.672713496991234*^9}, {
  3.6727135478599453`*^9, 3.672713608129211*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"x_", ",", "L_", ",", "V0_"}], "]"}], ":=", 
  FractionBox["V0", 
   SuperscriptBox[
    RowBox[{"Cosh", "[", 
     RowBox[{"x", "/", "L"}], "]"}], "2"]]}]], "Input",
 CellChangeTimes->{{3.672715219665303*^9, 3.672715297613167*^9}}],

