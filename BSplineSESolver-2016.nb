  RowBox[{
   RowBox[{"xlast", "[", 
    RowBox[{"ib_", ",", "jb_"}], "]"}], ":=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"knots", "[", 
      RowBox[{"[", 
       RowBox[{"ib", "-", "1", "+", "d", "+", "2"}], "]"}], "]"}], ",", 
     RowBox[{"knots", "[", 
      RowBox[{"[", 
       RowBox[{"jb", "-", "1", "+", "d", "+", "2"}], "]"}], "]"}]}], "]"}]}], 
