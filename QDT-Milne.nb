Notebook[{

Cell[CellGroupData[{
Cell["Milne\[CloseCurlyQuote]s phase amplitude method", "Section",
 CellChangeTimes->{{3.771928710476181*^9, 
  3.771928716426639*^9}},ExpressionUUID->"45538284-3e7d-4b84-92b8-\
b9a5ade87587"],

Cell["The Schrodinger equation ", "Text",
 CellChangeTimes->{{3.771928719785635*^9, 
  3.7719287230344467`*^9}},ExpressionUUID->"d37a35cf-a5f9-4fae-9e1a-\
15e43ae76484"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["\[HBar]", "2"]}], 
        RowBox[{"2", "\[Mu]"}]], 
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], "l", 
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}]}]}], "+", 
      RowBox[{"V", "(", "r", ")"}]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", 
   RowBox[{"E", " ", 
    RowBox[{"\[Psi]", "(", "r", ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719287271634817`*^9, 
  3.771928773519701*^9}},ExpressionUUID->"ef02c715-d860-43c6-a43e-\
5297a29192b6"],

Cell["is written as:", "Text",
 CellChangeTimes->{{3.7719288670148153`*^9, 
  3.771928874599354*^9}},ExpressionUUID->"cb10bbcf-9497-4db3-8fdc-\
c1fc7253484b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{"+", 
        FractionBox[
         RowBox[{"2", "\[Mu]"}], 
         SuperscriptBox["\[HBar]", "2"]]}]}], 
      RowBox[{"(", 
       RowBox[{"E", "-", 
        RowBox[{"V", "(", "r", ")"}], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[HBar]", "2"], "l", 
          RowBox[{"(", 
           RowBox[{"l", "+", "1"}], ")"}]}], 
         RowBox[{"2", "\[Mu]", " ", 
          SuperscriptBox["r", "2"]}]]}], ")"}]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.77192877942358*^9, 
  3.7719288628488483`*^9}},ExpressionUUID->"0d5ebbdc-d9e0-4e48-a6d7-\
86e9cd8ebf8a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["r", "2"]}]], 
      RowBox[{"+", 
       RowBox[{
        SuperscriptBox["k", "2"], "(", "r", ")"}]}]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719288818353357`*^9, 
  3.7719288944381647`*^9}},ExpressionUUID->"019bbbd0-299d-44f9-b012-\
7abf409e8c34"],

Cell[TextData[{
 "SInce we want ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", "r", ")"}], "\[Rule]", 
    FractionBox[
     RowBox[{"-", 
      SubscriptBox["C", "6"]}], 
     SuperscriptBox["r", "6"]]}], TraditionalForm]],ExpressionUUID->
  "eefd74c6-839c-47ac-871b-33c12734c911"],
 ", we move to scaled units where the unit of length is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "6"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Mu]", " ", 
       RowBox[{
        SubscriptBox["C", "6"], "/", 
        SuperscriptBox["\[HBar]", "2"]}]}], ")"}], 
     RowBox[{"1", "/", "4"}]]}], TraditionalForm]],ExpressionUUID->
  "b42998cf-d8b1-420f-9fa4-ccefa1688fd0"],
 " and energy is measured in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[HBar]", "2"], "/", "2"}], "\[Mu]", " ", 
    SubsuperscriptBox["\[Beta]", "6", "2"]}], TraditionalForm]],
  ExpressionUUID->"52087d3d-9354-4dc4-a8d8-5a45bc336e50"],
 "."
}], "Text",
 CellChangeTimes->{{3.7719305768590508`*^9, 3.771930577164357*^9}, {
  3.77193067464981*^9, 3.771930703076335*^9}, {3.771930766555253*^9, 
  3.7719308260616503`*^9}},ExpressionUUID->"41d63e23-b97e-42b2-9980-\
f5b35a1f3e2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"U", "(", "r", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "(", "r", ")"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], "l", 
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}]}], 
      RowBox[{"2", "\[Mu]", " ", 
       SuperscriptBox["r", "2"]}]]}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], 
      SuperscriptBox["r", "6"]], "+", 
     FractionBox[
      RowBox[{"l", "(", 
       RowBox[{"l", "+", "1"}], ")"}], 
      SuperscriptBox["r", "2"]]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771930579813835*^9, 3.771930607419386*^9}, {
  3.7719308387941647`*^9, 
  3.771930880214415*^9}},ExpressionUUID->"4e8cda0b-11f2-4750-ad55-\
2bda8f3d0d5e"],

Cell["So", "Text",
 CellChangeTimes->{{3.771930934515679*^9, 
  3.771930935893297*^9}},ExpressionUUID->"7f3040be-1500-4867-987b-\
4842daff6941"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["k", "2"], "(", "r", ")"}], "=", 
   RowBox[{"\[Epsilon]", "+", 
    FractionBox["1", 
     SuperscriptBox["r", "6"]], "-", 
    FractionBox[
     RowBox[{"l", "(", 
      RowBox[{"l", "+", "1"}], ")"}], 
     SuperscriptBox["r", "2"]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771930937742144*^9, 
  3.771930971195945*^9}},ExpressionUUID->"bf886b07-59d9-4d59-a10d-\
b636c191a08f"],

Cell["\<\
Milne showed [W.E. Milne, Phys. Rev. 35, 863 (1930); Am. Math. Mon. 40, 322 \
(1933)] that the solution can be written\
\>", "Text",
 CellChangeTimes->{{3.771928906064547*^9, 3.771928992063037*^9}, {
  3.77192943790174*^9, 
  3.7719294431702433`*^9}},ExpressionUUID->"f33d061f-986c-4522-9eb6-\
17d03ae68f66"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", "r", ")"}], "=", 
   RowBox[{"a", " ", 
    RowBox[{"\[Alpha]", "(", "r", ")"}], " ", 
    RowBox[{"sin", "(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "r"], 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"-", "2"}]], "(", 
         RowBox[{"r", "'"}], ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"r", "'"}]}]}]}], "+", "b"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771929447547657*^9, 
  3.77192949869608*^9}},ExpressionUUID->"5cc42425-dce7-4be7-a400-\
a81734b616f5"],

Cell[TextData[{
 "This result is valid provided that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "(", "r", ")"}], TraditionalForm]],ExpressionUUID->
  "bf986476-c5c4-4320-aa1c-b74252b09468"],
 " is any particular solution to Milne\[CloseCurlyQuote]s second-order, \
nonlinear differential equation:"
}], "Text",
 CellChangeTimes->{{3.771929512438842*^9, 
  3.77192954475016*^9}},ExpressionUUID->"88203622-9c4e-43dc-9091-\
ddfae6a5be40"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[Alpha]", "(", "r", ")"}]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["r", "2"]}]], "+", 
    RowBox[{
     RowBox[{
      SuperscriptBox["k", "2"], "(", "r", ")"}], 
     RowBox[{"\[Alpha]", "(", "r", ")"}]}]}], "=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["\[Alpha]", "3"], "(", "r", ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719295460807457`*^9, 
  3.771929588252511*^9}},ExpressionUUID->"37c8e982-7bee-4d27-805d-\
3986735f0e75"],

Cell[TextData[{
 "The WKB method approximates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "(", "r", ")"}], "\[TildeTilde]", 
    SuperscriptBox[
     RowBox[{"k", "(", "r", ")"}], 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "3ee14d2e-77f7-42b9-ac39-dc5569630734"],
 ", which would give ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "'"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], "2"], 
     SuperscriptBox["k", 
      RowBox[{
       RowBox[{"-", "3"}], "/", "2"}]], 
     RowBox[{"k", "'"}]}]}], TraditionalForm]],ExpressionUUID->
  "ea67b487-0db6-4442-a6cb-d28500233da3"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "''"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"-", "1"}], "2"], 
      SuperscriptBox["k", 
       RowBox[{
        RowBox[{"-", "3"}], "/", "2"}]], 
      RowBox[{"k", "''"}]}], "+", 
     RowBox[{
      FractionBox["3", "4"], 
      SuperscriptBox["k", 
       RowBox[{
        RowBox[{"-", "5"}], "/", "2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"k", "'"}], ")"}], "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"80f49f4b-6c99-41c3-a399-50a4df1a298e"],
 ".  which, when combined with the other terms in the Milne equation suggests \
that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", "''"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"-", "1"}], 
       SqrtBox[
        RowBox[{"k", "(", "r", ")"}]]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], 
         FractionBox[
          RowBox[{
           RowBox[{"k", "''"}], 
           RowBox[{"(", "r", ")"}]}], 
          RowBox[{"k", "(", "r", ")"}]]}], "-", 
        RowBox[{
         FractionBox["3", "4"], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"k", "'"}], "k"], ")"}], "2"]}]}], ")"}]}], "\[TildeTilde]",
      "0"}]}], TraditionalForm]],ExpressionUUID->
  "7181de95-f965-4926-a30a-3490d617cc74"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"k", "''"}], 
      RowBox[{"(", "r", ")"}]}], 
     RowBox[{"k", "(", "r", ")"}]], "\[TildeTilde]", 
    RowBox[{
     FractionBox["3", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"\[DifferentialD]", " ", 
         RowBox[{"ln", "(", 
          RowBox[{"k", "(", "r", ")"}], ")"}]}], 
        RowBox[{"\[DifferentialD]", "r"}]], ")"}], "2"]}]}], 
   TraditionalForm]],ExpressionUUID->"65fc57e7-2d6b-4e1b-a1e4-1ff8bed2530c"],
 "."
}], "Text",
 CellChangeTimes->{{3.7719296755830708`*^9, 3.771929889422716*^9}, {
  3.771929926819461*^9, 3.7719300017399683`*^9}, {3.7719300337935553`*^9, 
  3.7719300493095703`*^9}, {3.771930096221855*^9, 3.771930119005802*^9}, {
  3.771930347813863*^9, 3.771930379570208*^9}, {3.772654109973328*^9, 
