Cell[BoxData[
 RowBox[{
  RowBox[{"LowBindingtan\[Gamma]table", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "\[Epsilon]"}], ",", 
       RowBox[{"ArcTan", "[", 
        RowBox[{
         RowBox[{"QuantumDefectParametersBound", "[", 
          RowBox[{
           RowBox[{"ArcTan", "[", 
            RowBox[{"tanphi", "[", 
             RowBox[{"[", 
              RowBox[{"ltest", "+", "1"}], "]"}], "]"}], "]"}], ",", "ltest", 
           ",", "rf", ",", "\[Epsilon]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", 
       RowBox[{"-", "1"}], ",", "0.00001", ",", ".03"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.772738766391172*^9, 3.772738816111259*^9}, {
  3.7729220822205667`*^9, 
  3.772922151620688*^9}},ExpressionUUID->"c7f227d9-e4e1-40b4-a742-\
d451868ef58c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ltest", "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"abar", "[", "ltest", "]"}], 
        SqrtBox["\[Epsilon]"]}], ",", 
       FractionBox["\[Epsilon]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "ltest"}], "+", "3"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "ltest"}], "-", "1"}], ")"}]}]]}], "]"}], ",", 
     RowBox[{"{", 
