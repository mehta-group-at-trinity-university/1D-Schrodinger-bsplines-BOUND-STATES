Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{
        SqrtBox["R"], 
        RowBox[{"BesselJ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "4"]}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "L"}], "+", "1"}], ")"}]}], ",", "x"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"x", "\[Rule]", 
     FractionBox["1", 
      RowBox[{"2", 
       SuperscriptBox["R", "2"]}]]}]}], ",", 
   RowBox[{"R", ">", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.772366899471537*^9, 3.77236690693605*^9}, {
