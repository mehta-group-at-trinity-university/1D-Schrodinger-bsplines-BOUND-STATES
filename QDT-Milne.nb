 FormBox["", TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719296755830708`*^9, 3.771929889422716*^9}, {
  3.771929926819461*^9, 3.7719300017399683`*^9}, {3.7719300337935553`*^9, 
