Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Alpha]", "]"}], ";", 
  RowBox[{"\[Epsilon]test", "=", 
   RowBox[{"\[Epsilon]", "/.", "pos"}]}], ";", 
  RowBox[{"\[Alpha]rule", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
         RowBox[{
          RowBox[{"ksqr", "[", 
           RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}], 
          RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
        RowBox[{"BC1", "[", 
         RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
        RowBox[{"BC2", "[", 
         RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}]}], 
      "}"}], ",", "\[Alpha]", ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rx", ",", "rf"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]fun", "=", 
   RowBox[{"\[Alpha]", "/.", 
    RowBox[{"\[Alpha]rule", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhaseInt", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"\[Alpha]fun", "[", "rp", "]"}], 
            RowBox[{"-", "2"}]], "/.", "\[Alpha]rule"}], ",", 
          RowBox[{"{", 
           RowBox[{"rp", ",", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", 
              RowBox[{"i", "-", "1"}], "]"}], "]"}], ",", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "nr"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"phaseintfun", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rGrid", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"Total", "[", 
         RowBox[{"PhaseIntTable", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"ltest", "+", "1"}], ",", 
            RowBox[{"1", ";;", "i"}]}], "]"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", " ", 
         RowBox[{"SphericalBesselJ", "[", 
          RowBox[{"ltest", ",", 
           RowBox[{
            SqrtBox[
             RowBox[{"\[Epsilon]test", "+", 
              FractionBox["10", 
               SuperscriptBox["r0", "6"]]}]], "r"}]}], "]"}]}], ")"}], 
       RowBox[{
        FractionBox["1", 
         RowBox[{"r0", " ", 
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"ltest", ",", 
            RowBox[{
             SqrtBox[
              RowBox[{"\[Epsilon]test", "+", 
               FractionBox["10", 
                SuperscriptBox["r0", "6"]]}]], "r0"}]}], "]"}]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f0function", "[", 
           RowBox[{
            RowBox[{"\[Phi]vals", "[", 
             RowBox[{"[", 
              RowBox[{"ltest", "+", "1"}], "]"}], "]"}], ",", "\[Alpha]fun", ",",
             "phaseintfun", ",", "r0"}], "]"}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"Ksrfun", "[", 
             RowBox[{"[", 
              RowBox[{"ltest", "+", "1"}], "]"}], "]"}], "[", 
            "\[Epsilon]test", "]"}], 
           RowBox[{"g0function", "[", 
            RowBox[{
             RowBox[{"\[Phi]vals", "[", 
              RowBox[{"[", 
               RowBox[{"ltest", "+", "1"}], "]"}], "]"}], ",", "\[Alpha]fun", 
             ",", "phaseintfun", ",", "r0"}], "]"}]}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "r0"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"Plot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"f0function", "[", 
         RowBox[{
          RowBox[{"\[Phi]vals", "[", 
           RowBox[{"[", 
            RowBox[{"ltest", "+", "1"}], "]"}], "]"}], ",", "\[Alpha]fun", ",",
           "phaseintfun", ",", "r"}], "]"}], "-", 
        RowBox[{
         RowBox[{
          RowBox[{"Ksrfun", "[", 
           RowBox[{"[", 
            RowBox[{"ltest", "+", "1"}], "]"}], "]"}], "[", "\[Epsilon]test", 
          "]"}], 
         RowBox[{"g0function", "[", 
          RowBox[{
           RowBox[{"\[Phi]vals", "[", 
            RowBox[{"[", 
             RowBox[{"ltest", "+", "1"}], "]"}], "]"}], ",", "\[Alpha]fun", ",",
            "phaseintfun", ",", "r"}], "]"}]}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "r0", ",", "rf"}], "}"}]}], "]"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", ".4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".4"}], ",", ".4"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", "Large"}], ",", 
