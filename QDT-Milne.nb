Cell[BoxData[
 RowBox[{
  RowBox[{"tanphitableminus", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"-", 
