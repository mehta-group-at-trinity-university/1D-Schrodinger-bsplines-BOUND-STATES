  3.772846720851153*^9}},ExpressionUUID->"10c23c49-8fbf-4bbe-b83c-\
aafe0911e647"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"W", "(", 
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{
        SubscriptBox["j", "l"], "(", 
        RowBox[{
         SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
      SuperscriptBox["f", "0"]}], ")"}], 
    RowBox[{"W", "(", 
     RowBox[{
      SuperscriptBox["g", "0"], ",", 
      SuperscriptBox["f", "0"]}], ")"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"W", "(", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{
          SubscriptBox["j", "l"], "(", 
          RowBox[{
           SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
        SuperscriptBox["g", "0"]}], ")"}], 
      RowBox[{"W", "(", 
       RowBox[{
        SuperscriptBox["f", "0"], ",", 
        SuperscriptBox["g", "0"]}], ")"}]]}], 
    RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.77284665303404*^9, 3.7728466537974873`*^9}, {
   3.772846726237398*^9, 3.772846745830261*^9}, 
   3.77284682896213*^9},ExpressionUUID->"b7099b9d-3a68-4353-abfa-\
e511c282b3bb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}], "=", 
   SubscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"W", "(", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{
          SubscriptBox["j", "l"], "(", 
          RowBox[{
           SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
        SuperscriptBox["f", "0"]}], ")"}], 
      RowBox[{"W", "(", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{
          SubscriptBox["j", "l"], "(", 
          RowBox[{
           SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
        SuperscriptBox["g", "0"]}], ")"}]], ")"}], 
    RowBox[{"r", "=", 
     SubscriptBox["r", "0"]}]]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7728468342080507`*^9, 
  3.772846896584188*^9}},ExpressionUUID->"807b970e-9d03-4459-b3ea-\
572cdaa6c1a5"],

Cell[TextData[{
 "Now finally, at some sufficiently large ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "75eeb17e-1569-4fe8-986a-7dbd28a7a0c4"],
 ","
}], "Text",
