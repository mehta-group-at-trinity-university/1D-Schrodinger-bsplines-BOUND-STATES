   3.772540166523822*^9},ExpressionUUID->"327dd1a7-eeed-4cbe-be4e-\
1f594a823776"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", "\[Phi]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"-", " ", 
     RowBox[{"W", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Chi]", "-"], "(", "r", ")"}], ",", 
       RowBox[{
        SubsuperscriptBox["g", 
         RowBox[{"\[Phi]", "=", "0"}], "0"], "(", "r", ")"}]}], ")"}]}], 
    RowBox[{"W", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Chi]", "-"], "(", "r", ")"}], ",", 
      RowBox[{
       SubsuperscriptBox["f", 
        RowBox[{"\[Phi]", "=", "0"}], "0"], "(", "r", ")"}]}], ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771974693130657*^9, 3.771974793243772*^9}, {
  3.772197714212653*^9, 
  3.7721977248309593`*^9}},ExpressionUUID->"d02bbe0e-6c0c-4365-902d-\
3cc799507225"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]mprime", "[", 
    RowBox[{"L_", ",", "r_"}], "]"}], "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"\[Chi]minus", "[", 
      RowBox[{"L", ",", "r"}], "]"}], ",", "r"}], "]"}]}], ";", 
  RowBox[{"\[Chi]minustable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"\[Chi]minus", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"rGrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"\[Chi]minusprimetable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"\[Chi]mprime", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"rGrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]pprime", "[", 
    RowBox[{"L_", ",", "r_"}], "]"}], "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"\[Chi]plus", "[", 
      RowBox[{"L", ",", "r"}], "]"}], ",", "r"}], "]"}]}], ";", 
  RowBox[{"\[Chi]plustable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"\[Chi]plus", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"rGrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"\[Chi]plusprimetable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"\[Chi]mprime", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"rGrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.771974874491846*^9, 3.771974971009952*^9}, {
