  RowBox[{"\[Gamma]", " ", "=", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "l"}], "+", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "l"}], "-", "1"}], ")"}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772632784431376*^9, 
