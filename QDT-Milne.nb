 RowBox[{
  FractionBox["1", 
   RowBox[{"8", " ", 
    SqrtBox["\[Pi]"]}]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "3"}], " ", 
     SuperscriptBox["R", "2"], " ", 
     SqrtBox[
      SuperscriptBox["R", "3"]], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox["\[Pi]", "8"], "-", 
       FractionBox[
        RowBox[{"l", " ", "\[Pi]"}], "4"], "+", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox["R", "2"]}]]}], "]"}]}], "+", 
    RowBox[{"4", " ", "l", " ", 
     SuperscriptBox["R", "2"], " ", 
     SqrtBox[
      SuperscriptBox["R", "3"]], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox["\[Pi]", "8"], "-", 
       FractionBox[
        RowBox[{"l", " ", "\[Pi]"}], "4"], "+", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox["R", "2"]}]]}], "]"}]}], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["l", "2"], " ", 
     SuperscriptBox["R", "2"], " ", 
     SqrtBox[
      SuperscriptBox["R", "3"]], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox["\[Pi]", "8"], "-", 
       FractionBox[
        RowBox[{"l", " ", "\[Pi]"}], "4"], "+", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox["R", "2"]}]]}], "]"}]}], "+", 
    RowBox[{"16", " ", 
     SqrtBox[
      SuperscriptBox["R", "3"]], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{
       FractionBox["\[Pi]", "8"], "-", 
       FractionBox[
        RowBox[{"l", " ", "\[Pi]"}], "4"], "+", 
       FractionBox["1", 
        RowBox[{"2", " ", 
         SuperscriptBox["R", "2"]}]]}], "]"}]}]}], ")"}]}]], "Output",
