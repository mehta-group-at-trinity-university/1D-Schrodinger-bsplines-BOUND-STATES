Cell[TextData[{
 "Let\[CloseCurlyQuote]s consider just the bound state problem.  There are \
three regions.  At short range, we assume there is some known ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "sr"], "(", "r", ")"}], TraditionalForm]],
  ExpressionUUID->"776353ac-0768-44f4-ad52-d54c4bafd189"],
 ".  For the square-well problem"
}], "Text",
 CellChangeTimes->{{3.772846308062892*^9, 3.772846336901125*^9}, {
  3.772846392172838*^9, 
  3.77284640841835*^9}},ExpressionUUID->"dc64e450-b5d3-44c8-8b9c-\
2798e98c2ad4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "sr"], "(", "r", ")"}], "=", 
   RowBox[{"B", " ", "r", " ", 
    RowBox[{
     SubscriptBox["j", "l"], "(", 
     RowBox[{
      SubscriptBox["k", "in"], "r"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772846340214568*^9, 3.772846420242178*^9}, {
  3.772846487688902*^9, 
  3.772846531462401*^9}},ExpressionUUID->"615aea9f-08c8-4907-9eba-\
43dc825e56fd"],

Cell["At \[OpenCurlyDoubleQuote]long range\[CloseCurlyDoubleQuote]", "Text",
 CellChangeTimes->{{3.7728464263178883`*^9, 
  3.772846430906988*^9}},ExpressionUUID->"0bbbc3ca-14ac-4cfe-a205-\
73bff83f8b3c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "lr"], "(", "r", ")"}], "=", 
   RowBox[{"C", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["f", "0"], "-", 
      RowBox[{
       RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}], 
       SuperscriptBox["g", "0"]}]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772846433085009*^9, 3.772846481297495*^9}, 
   3.7728465114397583`*^9},ExpressionUUID->"e4f8a4fc-488b-4a3e-9675-\
c8119ac0d69c"],

Cell[TextData[{
 "Demanding that these be equal at some value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "5cc791d2-32b5-4b67-bff1-504e5ef05c44"],
 ", we have"
}], "Text",
 CellChangeTimes->{{3.772846538408745*^9, 
  3.772846551405429*^9}},ExpressionUUID->"3bc4694d-adb9-4619-aa3b-\
b5b872b6320f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"r", " ", 
    RowBox[{
     SubscriptBox["j", "l"], "(", 
     RowBox[{
      SubscriptBox["k", "in"], "r"}], ")"}]}], "=", 
   RowBox[{
    FractionBox["C", "B"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["f", "0"], "-", 
      RowBox[{
       RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}], 
       SuperscriptBox["g", "0"]}]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772846555921576*^9, 3.772846578565201*^9}, {
  3.772846642505055*^9, 
  3.772846642782159*^9}},ExpressionUUID->"6297a53e-2429-41ec-b252-\
9f348bdbb014"],

Cell["So, ", "Text",
 CellChangeTimes->{{3.7728465828524637`*^9, 
  3.772846583646*^9}},ExpressionUUID->"3c023d27-3a76-4204-90ce-02ca8b34b7e7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"W", "(", 
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{
       SubscriptBox["j", "l"], "(", 
       RowBox[{
        SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
     SuperscriptBox["f", "0"]}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["C", "B"]}], 
    RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}], 
    RowBox[{"W", "(", 
     RowBox[{
      SuperscriptBox["g", "0"], ",", 
      SuperscriptBox["f", "0"]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772846585215248*^9, 
  3.772846664997076*^9}},ExpressionUUID->"9aacbf30-68bf-4227-ae71-\
2e25a02db9ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["C", "B"]}], 
    RowBox[{"tan", "(", "\[Pi]\[Mu]", ")"}]}], "=", 
   FractionBox[
    RowBox[{"W", "(", 
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{
        SubscriptBox["j", "l"], "(", 
        RowBox[{
         SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
      SuperscriptBox["f", "0"]}], ")"}], 
    RowBox[{"W", "(", 
     RowBox[{
      SuperscriptBox["g", "0"], ",", 
      SuperscriptBox["f", "0"]}], ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772846787766983*^9, 
  3.772846800418254*^9}},ExpressionUUID->"90b4014c-e04d-49a0-8ebb-\
ae43338694df"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"W", "(", 
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{
        SubscriptBox["j", "l"], "(", 
        RowBox[{
         SubscriptBox["k", "in"], "r"}], ")"}]}], ",", " ", 
      SuperscriptBox["g", "0"]}], ")"}], 
    RowBox[{"W", "(", 
     RowBox[{
      SuperscriptBox["f", "0"], ",", 
      SuperscriptBox["g", "0"]}], ")"}]], "=", 
