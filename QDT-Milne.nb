Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumDefectParameters", "[", 
    RowBox[{"\[Phi]_", ",", "l_", ",", "rfinal_", ",", "\[Epsilon]_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rjl", ",", "rjlp", ",", "ryl", ",", "rylp", ",", "\[ScriptCapitalA]", ",",
        "\[ScriptCapitalG]", ",", "tan\[Eta]", ",", "g", ",", "gp", ",", "k", 
       ",", "\[Alpha]", ",", "rp", ",", "\[Alpha]rule", ",", "\[Alpha]fun", ",",
        "rx", ",", "phaseint", ",", "f0", ",", "g0", ",", "f0p", ",", "g0p", ",",
        "\[Alpha]p", ",", "\[Chi]m", ",", "\[Chi]mp", ",", "\[Gamma]", ",", 
       "Ksr", ",", "Wrjf0", ",", "Wryf0", ",", "Wgg0", ",", "Wgf0"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rx", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       SqrtBox["\[Epsilon]"]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rjl", "=", 
       RowBox[{"k", " ", "rfinal", " ", 
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"l", ",", 
          RowBox[{"k", " ", "rfinal"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rjlp", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"k", " ", "rp", " ", 
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"l", ",", 
             RowBox[{"k", " ", "rp"}]}], "]"}]}], ",", "rp"}], "]"}], "/.", 
        RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ryl", "=", " ", 
       RowBox[{"k", " ", "rfinal", " ", 
        RowBox[{"SphericalBesselY", "[", 
         RowBox[{"l", ",", 
          RowBox[{"k", " ", "rfinal"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rylp", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"k", " ", "rp", " ", 
           RowBox[{"SphericalBesselY", "[", 
            RowBox[{"l", ",", 
             RowBox[{"k", " ", "rp"}]}], "]"}]}], ",", "rp"}], "]"}], "/.", 
        RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{
        SqrtBox[
         FractionBox["k", 
          RowBox[{"\[Pi]", " "}]]], " ", "rfinal", " ", 
        RowBox[{"SphericalBesselY", "[", 
         RowBox[{"l", ",", 
          RowBox[{"k", " ", "rfinal"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gp", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SqrtBox[
            FractionBox["k", 
             RowBox[{"\[Pi]", " "}]]], "  ", "rp", " ", 
           RowBox[{"SphericalBesselY", "[", 
            RowBox[{"l", ",", 
             RowBox[{"k", " ", "rp"}]}], "]"}]}], ",", "rp"}], "]"}], "/.", 
        RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]rule", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
             RowBox[{
              RowBox[{"ksqr", "[", 
               RowBox[{"\[Epsilon]", ",", "l", ",", "r"}], "]"}], 
              RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
            RowBox[{"BC1", "[", 
             RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
            RowBox[{"BC2", "[", 
             RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}]}], "}"}], ",",
          "\[Alpha]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rx", ",", "rfinal"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]fun", "=", 
       RowBox[{"\[Alpha]", "/.", 
        RowBox[{"\[Alpha]rule", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phaseint", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[Alpha]fun", "[", "rp", "]"}], 
          RowBox[{"-", "2"}]], ",", 
         RowBox[{"{", 
          RowBox[{"rp", ",", "rx", ",", "rfinal"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]p", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Alpha]fun", "[", "rp", "]"}], ",", "rp"}], "]"}], "/.", 
        RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g0", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]}], 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f0", "=", 
       RowBox[{
        RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f0p", "=", 
       RowBox[{
        RowBox[{
         FractionBox["\[Alpha]p", 
          RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]], "f0"}], "-", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], "2"]], "g0"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"g0p", "=", 
       RowBox[{
        RowBox[{
         FractionBox["\[Alpha]p", 
          RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]], "g0"}], "+", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], "2"]], "f0"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Wrjf0", "=", 
       RowBox[{
        RowBox[{"rjl", " ", "f0p"}], " ", "-", " ", 
        RowBox[{"rjlp", " ", "f0"}]}]}], ";", "\[IndentingNewLine]", 
