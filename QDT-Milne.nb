Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuantumDefectSquare", "[", 
    RowBox[{
    "\[Phi]_", ",", "l_", ",", "r0_", ",", "V0_", ",", "\[Epsilon]_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Alpha]", ",", "rp", ",", "\[Alpha]rule", ",", "\[Alpha]fun", ",", 
       "rx", ",", "rf", ",", "phaseint", ",", "f0", ",", "g0", ",", "f0p", ",",
        "g0p", ",", "\[Alpha]p", ",", "\[Chi]m", ",", "\[Chi]mp", ",", 
       "logder", ",", "Ksr"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rx", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rf", "=", "r0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]rule", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
             RowBox[{
              RowBox[{"ksqr", "[", 
               RowBox[{"\[Epsilon]", ",", "l", ",", "r"}], "]"}], 
              RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
             FractionBox["1", 
              SuperscriptBox[
               RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", 
            "0"}], ",", 
           RowBox[{
            RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
            RowBox[{"BC1", "[", 
             RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
            RowBox[{"BC2", "[", 
             RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}]}], "}"}], ",",
          "\[Alpha]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rx", ",", "rf"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]fun", "=", 
       RowBox[{"\[Alpha]", "/.", 
        RowBox[{"\[Alpha]rule", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"phaseint", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[Alpha]fun", "[", "rp", "]"}], 
          RowBox[{"-", "2"}]], ",", 
         RowBox[{"{", 
          RowBox[{"rp", ",", "rx", ",", "r0"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]p", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Alpha]fun", "[", "rp", "]"}], ",", "rp"}], "]"}], "/.", 
        RowBox[{"rp", "\[Rule]", "r0"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g0", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Alpha]", "[", "r0", "]"}]}], 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f0", "=", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", "r0", "]"}], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f0p", "=", 
       RowBox[{
        RowBox[{
         FractionBox["\[Alpha]p", 
          RowBox[{"\[Alpha]fun", "[", "r0", "]"}]], "f0"}], "-", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]fun", "[", "r0", "]"}], "2"]], "g0"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g0p", "=", 
       RowBox[{
        RowBox[{
         FractionBox["\[Alpha]p", 
          RowBox[{"\[Alpha]fun", "[", "r0", "]"}]], "g0"}], "+", 
        RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]fun", "[", "r0", "]"}], "2"]], "f0"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Chi]m", "=", 
       RowBox[{"\[Chi]minus", "[", 
        RowBox[{"l", ",", "r0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Chi]mp", "=", 
       RowBox[{"\[Chi]mprime", "[", 
        RowBox[{"l", ",", "r0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logder", "=", 
       RowBox[{"logdersquare", "[", 
        RowBox[{"l", ",", "V0", ",", "r0", ",", "\[Epsilon]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Ksr", "=", 
       FractionBox[
        RowBox[{
         RowBox[{"logder", " ", "f0"}], "-", "f0p"}], 
        RowBox[{
         RowBox[{"logder", " ", "g0"}], "-", "g0p"}]]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Ksr", ",", 
        RowBox[{
         RowBox[{"ArcTan", "[", "Ksr", "]"}], "/", "\[Pi]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.772386151702784*^9, 3.772386178128147*^9}, {
