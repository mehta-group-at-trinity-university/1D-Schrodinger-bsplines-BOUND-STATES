Cell[TextData[{
 "\[LineSeparator]Now using ",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SuperscriptBox["f", "0"], "(", "r", ")"}]}], 
     RowBox[{"\[DifferentialD]", "r"}]], "=", 
