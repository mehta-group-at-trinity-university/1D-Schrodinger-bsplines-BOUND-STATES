     RowBox[{"\[Kappa]", " ", "a"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Kappa]", "3"], "a"}], "3"], "-", 
     FractionBox[
      SuperscriptBox["\[Kappa]", "2"], "3"]}], 
    RowBox[{"(", 
     RowBox[{"1", "-", " ", 
      RowBox[{"\[Kappa]", " ", "a"}]}], " ", ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772635080044779*^9, 
  3.772635109659458*^9}},ExpressionUUID->"374b7a7c-7ee8-4d8c-8cbb-\
55e3cb452dd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", "\[Gamma]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Kappa]", " ", "a"}], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Kappa]", "3"], "a"}], "3"], "-", 
      FractionBox[
       SuperscriptBox["\[Kappa]", "2"], "3"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "+", " ", 
       RowBox[{"\[Kappa]", " ", "a"}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Kappa]", " ", "a"}], ")"}], "2"], " ", "+"}], "..."}], 
     ")"}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772635112568015*^9, 
  3.772635184089616*^9}},ExpressionUUID->"8f1930d5-22e9-498a-867f-\
f4c402bfcdaa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", "\[Gamma]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Kappa]", " ", "a"}], "-", 
      FractionBox[
       SuperscriptBox["\[Kappa]", "2"], "3"], "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Kappa]", " ", "a"}], ")"}], "2"]}], "..."}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772635191903244*^9, 
  3.7726352677725897`*^9}},ExpressionUUID->"a84fc0b9-6eb2-4220-bfd5-\
417c35c0ee5c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", "\[Gamma]"}], "=", 
   RowBox[{
    RowBox[{"\[Kappa]", " ", "a"}], "+", 
    RowBox[{
     SuperscriptBox["\[Kappa]", "2"], "(", " ", 
     RowBox[{"a", "-", 
      FractionBox["1", "3"]}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772635276017239*^9, 
  3.772635315547591*^9}},ExpressionUUID->"f94cb935-ff0b-4251-a8ed-\
7bbec74211da"],

Cell[TextData[{
 "For arbitrary ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "2f011b93-f1e1-495a-969a-17d54d16c7ad"],
 " if we consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "r"}]], "\[Rule]", "0"}], 
   TraditionalForm]],ExpressionUUID->"8ebd533b-ff1d-437c-91ac-527d4f0c4f74"],
 " in the very large r limit, then the lhs becomes dominated by the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["r", 
    RowBox[{"l", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "fe4e4c53-40d9-43b3-accc-d9a5899086b6"],
 " terms"
}], "Text",
 CellChangeTimes->{{3.77263247073038*^9, 3.7726324772044907`*^9}, {
  3.772632527321116*^9, 
  3.772632588725657*^9}},ExpressionUUID->"55f1f827-ddc3-4f09-bd10-\
0ceb9c348221"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"tan", " ", "\[Gamma]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["a"]}], 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "/", "a"}], ")"}], 
         RowBox[{"l", "+", "1"}]], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "+", "1"}], ")"}], "!!"}]]}], ")"}]}], "+", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[Kappa]", "2"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "3"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "-", "1"}], ")"}]}]], 
      SqrtBox["a"], 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"r", "/", "a"}], ")"}], 
        RowBox[{"l", "+", "1"}]], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "l"}], "+", "1"}], ")"}], "!!"}]]}], ")"}]}], "=", 
   "0"}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772632545641911*^9, 3.772632551158654*^9}, {
  3.772632601234769*^9, 
  3.772632612995192*^9}},ExpressionUUID->"79593b62-c0d9-4895-8214-\
b06a04f2b0e7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", "\[Gamma]"}], " ", "=", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "l"}], "+", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "l"}], "-", "1"}], ")"}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772632625391103*^9, 
  3.772632692049059*^9}},ExpressionUUID->"43cf98ba-f39c-41ef-b496-\
54f561637f41"],

Cell[TextData[{
 "For small \[Gamma], ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"tan", " ", "\[Gamma]"}], "\[Rule]", "\[Gamma]"}], 
   TraditionalForm]],ExpressionUUID->"aab61628-e9b6-451d-bda6-149077a12791"]
}], "Text",
 CellChangeTimes->{{3.77263276534583*^9, 
  3.772632778951683*^9}},ExpressionUUID->"1816bca7-6816-498a-985d-\
246b8f6c2317"],

