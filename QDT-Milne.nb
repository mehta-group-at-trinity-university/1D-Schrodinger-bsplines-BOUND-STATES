 RowBox[{
  RowBox[{"Gplot2", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["k", "2"], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "L"}], "+", "3"}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "L"}], "-", "1"}], ")"}]}]]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"L", "+", "1"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"abar", "[", "ltest", "]"}], " ", "k"}], ")"}], 
         RowBox[{
          RowBox[{"4", "L"}], "+", "2"}]]}]}], "/.", 
