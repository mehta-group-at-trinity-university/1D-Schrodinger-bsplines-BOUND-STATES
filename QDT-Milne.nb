Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]test", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ltest", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rx", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rf", "=", "3.0"}], ";", 
  RowBox[{"\[Alpha]sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", "r", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "2"}], "}"}]}], "]"}], "+", 
         RowBox[{
          RowBox[{"ksqr", "[", 
           RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}], 
          RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
        RowBox[{"BC1", "[", 
         RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
        RowBox[{"BC2", "[", 
         RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}]}], 
      "}"}], ",", "\[Alpha]", ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rx", ",", "rf"}], "}"}]}], "]"}]}]}]}], "Input",
