      RowBox[{"Gamma", "[", 
       RowBox[{
        FractionBox["L", "2"], "+", 
        FractionBox["5", "4"]}], "]"}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"L", "+", 
        FractionBox["1", "2"]}], "]"}]}]], ")"}], 
   FractionBox["2", 
    RowBox[{
     RowBox[{"2", "L"}], "+", "1"}]]]}]], "Input",
