          RowBox[{"{", 
           RowBox[{"rp", ",", "rx", ",", "r"}], "}"}]}], "]"}], "]"}]}], ",", 
      
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], 
        SuperscriptBox[
         RowBox[{"ksqr", "[", 
          RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}], 
         RowBox[{"1", "/", "4"}]]], 
