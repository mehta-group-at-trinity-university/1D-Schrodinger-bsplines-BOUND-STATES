Cell[BoxData[
 RowBox[{
  RowBox[{"QuantumDefectParametersBound", "[", 
   RowBox[{"\[Phi]_", ",", "l_", ",", "rfinal_", ",", "\[Epsilon]_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "tan\[Gamma]", ",", "gbound", ",", "gboundp", ",", "k", ",", "\[Kappa]", 
      ",", "\[Alpha]", ",", "rp", ",", "\[Alpha]rule", ",", "\[Alpha]fun", ",",
       "rx", ",", "phaseint", ",", "f0", ",", "g0", ",", "f0p", ",", "g0p", ",",
       "\[Alpha]p", ",", "\[Gamma]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rx", "=", "0.05"}], ";", "\[IndentingNewLine]", 
     RowBox[{"k", "=", 
      SqrtBox["\[Epsilon]"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Kappa]", "=", 
      SqrtBox[
       RowBox[{"-", "\[Epsilon]"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gbound", "=", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{
          FractionBox["2", "\[Pi]"], "\[Kappa]", " ", "rp"}]], 
        RowBox[{"BesselK", "[", 
         RowBox[{
          RowBox[{"l", "+", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"\[Kappa]", " ", "rp"}]}], "]"}]}], "/.", 
       RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gboundp", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          SqrtBox[
           RowBox[{
            FractionBox["2", "\[Pi]"], "\[Kappa]", " ", "rp"}]], 
          RowBox[{"BesselK", "[", 
           RowBox[{
            RowBox[{"l", "+", 
             RowBox[{"1", "/", "2"}]}], ",", 
            RowBox[{"\[Kappa]", " ", "rp"}]}], "]"}]}], ",", "rp"}], "]"}], "/.", 
       RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"gbound", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Kappa]"}], " ", "rfinal"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gboundp", "=", 
        RowBox[{
         RowBox[{"-", "\[Kappa]"}], " ", "gbound"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]rule", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
            RowBox[{
             RowBox[{"ksqr", "[", 
              RowBox[{"\[Epsilon]", ",", "l", ",", "r"}], "]"}], 
             RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
            FractionBox["1", 
             SuperscriptBox[
              RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", "0"}],
           ",", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
           RowBox[{"BC1", "[", 
            RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
           RowBox[{"BC2", "[", 
            RowBox[{"\[Epsilon]", ",", "l", ",", "rx"}], "]"}]}]}], "}"}], ",",
         "\[Alpha]", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rx", ",", "rfinal"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]fun", "=", 
      RowBox[{"\[Alpha]", "/.", 
       RowBox[{"\[Alpha]rule", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"phaseint", "=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Alpha]fun", "[", "rp", "]"}], 
         RowBox[{"-", "2"}]], ",", 
        RowBox[{"{", 
         RowBox[{"rp", ",", "rx", ",", "rfinal"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]p", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Alpha]fun", "[", "rp", "]"}], ",", "rp"}], "]"}], "/.", 
       RowBox[{"rp", "\[Rule]", "rfinal"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g0", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]}], 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f0", "=", 
      RowBox[{
       RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Phi]", "+", "phaseint"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f0p", "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[Alpha]p", 
         RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]], "f0"}], "-", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], "2"]], "g0"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"g0p", "=", 
      RowBox[{
       RowBox[{
        FractionBox["\[Alpha]p", 
         RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}]], "g0"}], "+", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"\[Alpha]fun", "[", "rfinal", "]"}], "2"]], "f0"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"tan\[Gamma]", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"gbound", " ", "g0p"}], "-", 
         RowBox[{"gboundp", " ", "g0"}]}], 
        RowBox[{
         RowBox[{"gbound", " ", "f0p"}], " ", "-", " ", 
         RowBox[{"gboundp", " ", "f0"}]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", "tan\[Gamma]", "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
