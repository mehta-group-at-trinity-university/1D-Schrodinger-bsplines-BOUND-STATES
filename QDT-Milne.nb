 CellLabel->"In[3]:=",ExpressionUUID->"688f296d-5674-4882-a7b4-639db003bad7"],

Cell[BoxData[
 FractionBox["1", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["r", "6"]], "-", 
     FractionBox[
      RowBox[{"l", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "l"}], ")"}]}], 
      SuperscriptBox["r", "2"]], "+", "\[Epsilon]"}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.771931778380023*^9, 3.772207197679368*^9, 
  3.772548813272768*^9, 3.772920265603612*^9, 3.972422810757764*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"57c4d776-f379-4457-bf9a-c2405fcfa194"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BC2", "[", 
   RowBox[{"\[Epsilon]_", ",", "l_", ",", "r_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"D", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"ksqr", "[", 
       RowBox[{"\[Epsilon]", ",", "l", ",", "r"}], "]"}], 
      RowBox[{
       RowBox[{"-", "1"}], "/", "4"}]], ",", "r"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.771931647045597*^9, 3.771931729451317*^9}, 
   3.7719317910502253`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"86578f19-041a-4ebb-b87b-688661e2797d"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"-", "3"}], "+", 
    RowBox[{"l", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "l"}], ")"}], " ", 
     SuperscriptBox["r", "4"]}]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["r", "7"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["r", "6"]], "-", 
       FractionBox[
        RowBox[{"l", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "l"}], ")"}]}], 
        SuperscriptBox["r", "2"]], "+", "\[Epsilon]"}], ")"}], 
     RowBox[{"5", "/", "4"}]]}]]}]], "Output",
 CellChangeTimes->{3.7719316923722067`*^9, 3.771931794032496*^9, 
