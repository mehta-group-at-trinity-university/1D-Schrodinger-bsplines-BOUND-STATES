      RowBox[{
       SuperscriptBox["g", "0"], "(", "r", ")"}]}]}]}], TraditionalForm], "\n", 
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SuperscriptBox["g", "0"], "(", "r", ")"}]}], 
     RowBox[{"\[DifferentialD]", "r"}]], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"\[Alpha]", "'"}], 
        RowBox[{"(", "r", ")"}]}], 
       RowBox[{"\[Alpha]", "(", "r", ")"}]], 
      RowBox[{
       SuperscriptBox["g", "0"], "(", "r", ")"}]}], "+", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["\[Alpha]", "2"], "(", "r", ")"}]], " ", 
      RowBox[{
       SuperscriptBox["f", "0"], "(", "r", ")"}]}]}]}], TraditionalForm]}],
  ExpressionUUID->"82790483-f039-4819-97cb-c2b71fc75be5"]
