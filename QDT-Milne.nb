 RowBox[{
  RowBox[{"basepairs", "[", 
   RowBox[{
   "l_", ",", "\[Phi]_", ",", "\[Alpha]_", ",", "phaseint_", ",", "r_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
