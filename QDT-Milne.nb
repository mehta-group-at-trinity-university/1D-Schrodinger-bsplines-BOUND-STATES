              RowBox[{"-", "2"}]], "/.", "\[Alpha]sol"}], ",", 
            RowBox[{"{", 
             RowBox[{"rp", ",", 
              RowBox[{"rGrid", "[", 
               RowBox[{"[", 
                RowBox[{"i", "-", "1"}], "]"}], "]"}], ",", 
