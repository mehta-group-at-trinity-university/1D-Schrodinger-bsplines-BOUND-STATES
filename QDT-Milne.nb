Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]test", "=", 
   RowBox[{"(*", 
    RowBox[{"0.0", ";"}], "*)"}], 
   RowBox[{"6.547", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ltest", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rx", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rf", "=", "3.0"}], ";", 
  RowBox[{"\[Alpha]sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
          RowBox[{
           RowBox[{"ksqr", "[", 
            RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}], 
           RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
          FractionBox["1", 
           SuperscriptBox[
            RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
          RowBox[{"BC1", "[", 
           RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}]}], "/.", 
         
         RowBox[{"r", "\[Rule]", "rx"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
          RowBox[{"BC2", "[", 
           RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}]}], "/.", 
         
         RowBox[{"r", "\[Rule]", "rx"}]}]}], "}"}], ",", "\[Alpha]", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "rx", ",", "rf"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nr", "=", "200"}], ";", 
  RowBox[{"rGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rx", "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"i", "-", "1"}], 
          RowBox[{"nr", "-", "1"}]], ")"}], "3"], 
       RowBox[{"(", 
        RowBox[{"rf", "-", "rx"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   StyleBox["\[Alpha]table", "Input"], 
   StyleBox["=", "Input"], 
   RowBox[{
    StyleBox["Table", "Input"], 
    StyleBox["[", "Input"], 
    RowBox[{
     RowBox[{
      StyleBox["{", "Input"], 
      RowBox[{
       StyleBox[
        RowBox[{"rGrid", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "Input"], 
       StyleBox[",", "Input"], 
       RowBox[{
        StyleBox[
         RowBox[{
          RowBox[{"\[Alpha]", "[", "r", "]"}], "/.", "\[Alpha]sol"}], "Input"], 
        StyleBox["/.", "Input"], 
        RowBox[{
         StyleBox["r", "Input"], 
         StyleBox["\[Rule]", "Input"], 
         RowBox[{"rGrid", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhaseIntTable", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"\[Alpha]", "[", "rp", "]"}], 
            RowBox[{"-", "2"}]], "/.", "\[Alpha]sol"}], ",", 
          RowBox[{"{", 
           RowBox[{"rp", ",", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", 
              RowBox[{"i", "-", "1"}], "]"}], "]"}], ",", 
            RowBox[{"rGrid", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "nr"}], "}"}]}], "]"}]}], "}"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"ListPlot", "[", 
   RowBox[{"PhaseIntTable", ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f0table", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]table", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Phi]", "+", 
          RowBox[{"Total", "[", 
           RowBox[{"PhaseIntTable", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "i"}], "]"}], "]"}], "]"}]}], "]"}]}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g0table", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rGrid", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Alpha]table", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Phi]", "+", 
          RowBox[{"Total", "[", 
           RowBox[{"PhaseIntTable", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "i"}], "]"}], "]"}], "]"}]}], "]"}]}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nr"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.772210984072336*^9, 3.772211035220681*^9}, {
  3.7722110690689*^9, 3.772211086556254*^9}, {3.772211125971806*^9, 
  3.772211154112341*^9}, {3.772211670699223*^9, 3.7722116796443787`*^9}, {
  3.772212732132575*^9, 3.772212735007769*^9}, {3.7722127793770313`*^9, 
  3.772212814221148*^9}, {3.7722393708399153`*^9, 3.772239372555822*^9}, {
