Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{
        FractionBox["1", "2"], "+", "L"}]], "  ", 
      SqrtBox["R"]}], 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        FractionBox["1", "4"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", 
          RowBox[{"2", " ", "L"}]}], ")"}]}]}], "]"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["R", "2"], ")"}], 
     RowBox[{
      RowBox[{"+", 
       FractionBox["1", "4"]}], "+", 
      FractionBox["L", "2"]}]]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{
        FractionBox["1", "2"], "+", "L"}]], "  "}], 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        FractionBox["1", "4"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "-", 
          RowBox[{"2", " ", "L"}]}], ")"}]}]}], "]"}]], 
    SuperscriptBox[
     RowBox[{"(", "R", ")"}], 
     RowBox[{
      RowBox[{"+", "1"}], "+", "L"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772367015843486*^9, 
  3.772367079623004*^9}},ExpressionUUID->"8de58d08-bf57-42d9-b6b9-\
b0fc706466b6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Energy dependence of the QDT parameter \[Phi]?", "Subsection",
 CellChangeTimes->{{3.772278659793804*^9, 
  3.772278674201611*^9}},ExpressionUUID->"8eaceb56-960f-41a8-a965-\
0d9fc1346e43"],

Cell["\<\
Is there a way to determine the energy dependence of the parameter \[Phi] \
near threshold?  Perhaps we can derive an equation obeyed by the energy \
derivative of the Milne solution?\
\>", "Text",
 CellChangeTimes->{{3.772278675536562*^9, 
  3.772278715597543*^9}},ExpressionUUID->"55e1d458-3e93-421b-bf6e-\
93baf6bde161"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s start with the Schrodinger equation, considering ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Psi]", "(", 
    RowBox[{"E", ",", "r"}], ")"}], TraditionalForm]],ExpressionUUID->
  "99cde9c4-2574-42e7-af9c-8b5eeb43abed"]
}], "Text",
 CellChangeTimes->{{3.772278809070763*^9, 
  3.772278851861477*^9}},ExpressionUUID->"5e06cca1-5239-45d3-9a4a-\
f3743982db26"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox[
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["r", "2"]}]], 
       RowBox[{"+", 
        FractionBox[
         RowBox[{"2", "\[Mu]"}], 
         SuperscriptBox["\[HBar]", "2"]]}]}], 
      RowBox[{"(", 
       RowBox[{"E", "-", 
        RowBox[{"V", "(", "r", ")"}], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[HBar]", "2"], "l", 
          RowBox[{"(", 
           RowBox[{"l", "+", "1"}], ")"}]}], 
         RowBox[{"2", "\[Mu]", " ", 
          SuperscriptBox["r", "2"]}]]}], ")"}]}], ")"}], 
    RowBox[{"\[Psi]", "(", 
     RowBox[{"E", ",", "r"}], ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.77192877942358*^9, 3.7719288628488483`*^9}, {
  3.772278846732192*^9, 
  3.77227884972869*^9}},ExpressionUUID->"5d6cc0d7-5c55-4431-b671-\
ac8185a09bcf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", "E"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["r", "2"]}]], 
        RowBox[{"+", 
         FractionBox[
          RowBox[{"2", "\[Mu]"}], 
          SuperscriptBox["\[HBar]", "2"]]}]}], 
       RowBox[{"(", 
        RowBox[{"E", "-", 
         RowBox[{"V", "(", "r", ")"}], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], "l", 
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]]}], ")"}]}], ")"}]}], 
    RowBox[{"\[Psi]", "(", 
     RowBox[{"E", ",", "r"}], ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772278861099802*^9, 
  3.772278869786147*^9}},ExpressionUUID->"6715d10a-1456-4baa-9497-\
b1439f0adc0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["r", "2"]}]], 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{"\[Psi]", "(", 
          RowBox[{"E", ",", "r"}], ")"}]}], 
        RowBox[{"\[PartialD]", "E"}]], 
       RowBox[{"+", 
        FractionBox[
         RowBox[{"2", "\[Mu]"}], 
         SuperscriptBox["\[HBar]", "2"]]}]}]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"E", " ", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"\[Psi]", "(", 
           RowBox[{"E", ",", "r"}], ")"}]}], 
         RowBox[{"\[PartialD]", "E"}]]}], "+", 
       RowBox[{"\[Psi]", "(", 
        RowBox[{"E", ",", "r"}], ")"}], "-", 
       RowBox[{
        RowBox[{"V", "(", "r", ")"}], 
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{"\[Psi]", "(", 
            RowBox[{"E", ",", "r"}], ")"}]}], 
          RowBox[{"\[PartialD]", "E"}]], 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[HBar]", "2"], "l", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}], 
           RowBox[{"2", "\[Mu]", " ", 
            SuperscriptBox["r", "2"]}]]}]}], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"\[Psi]", "(", 
           RowBox[{"E", ",", "r"}], ")"}]}], 
         RowBox[{"\[PartialD]", "E"}]]}]}], ")"}]}], ")"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7722788771062393`*^9, 
  3.7722789868170547`*^9}},ExpressionUUID->"12f42764-7d27-457a-bd8e-\
fda10a9809a1"],

Cell["Which, at zero energy becomes:", "Text",
 CellChangeTimes->{{3.7722790010391493`*^9, 
  3.772279007166252*^9}},ExpressionUUID->"aa507480-8e86-4729-9577-\
0682f045936e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["r", "2"]}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{"\[Psi]", "(", 
         RowBox[{"E", ",", "r"}], ")"}]}], 
       RowBox[{"\[PartialD]", "E"}]]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Mu]"}], 
       SuperscriptBox["\[HBar]", "2"]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Psi]", "(", 
         RowBox[{"E", ",", "r"}], ")"}], "-", 
        RowBox[{
         RowBox[{"V", "(", "r", ")"}], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{"\[Psi]", "(", 
            RowBox[{"E", ",", "r"}], ")"}]}], 
          RowBox[{"\[PartialD]", "E"}]]}], "-", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["\[HBar]", "2"], "l", 
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}]}], 
          RowBox[{"2", "\[Mu]", " ", 
           SuperscriptBox["r", "2"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{"\[Psi]", "(", 
            RowBox[{"E", ",", "r"}], ")"}]}], 
          RowBox[{"\[PartialD]", "E"}]]}]}], ")"}]}]}], ")"}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772279011214623*^9, 
  3.7722790167038813`*^9}},ExpressionUUID->"ad039d79-ab3b-4b83-810e-\
249d5e7bd2aa"],

Cell[TextData[{
 "So it looks like we end up with a mixed equation that involves ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Psi]", 
    RowBox[{"(", 
     RowBox[{"E", ",", "r"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "9c757c90-3150-4ec1-a2a6-746bc64b2869"],
 "."
}], "Text",
 CellChangeTimes->{{3.772279125525936*^9, 
  3.7722791706050673`*^9}},ExpressionUUID->"e360a87e-bbf6-4779-abd1-\
99b3ef8ad7fd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["r", "2"]}]], 
      RowBox[{"+", 
       RowBox[{
        SuperscriptBox["k", "2"], "(", "r", ")"}]}]}], ")"}], 
    RowBox[{"\[Psi]", "(", "r", ")"}]}], "=", "0"}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719288818353357`*^9, 
  3.7719288944381647`*^9}},ExpressionUUID->"e830952c-7404-4f50-bf86-\
9f27c89048e1"],

Cell[TextData[{
 "SInce we want ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", "r", ")"}], "\[Rule]", 
    FractionBox[
     RowBox[{"-", 
      SubscriptBox["C", "6"]}], 
     SuperscriptBox["r", "6"]]}], TraditionalForm]],ExpressionUUID->
  "80a7c705-d190-46b3-b20e-d3c81980e554"],
 ", we move to scaled units where the unit of length is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "6"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", "\[Mu]", " ", 
       RowBox[{
        SubscriptBox["C", "6"], "/", 
        SuperscriptBox["\[HBar]", "2"]}]}], ")"}], 
     RowBox[{"1", "/", "4"}]]}], TraditionalForm]],ExpressionUUID->
  "cb1128b5-1081-4ff8-a384-1fa06ee58481"],
 " and energy is measured in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[HBar]", "2"], "/", "2"}], "\[Mu]", " ", 
    SubsuperscriptBox["\[Beta]", "6", "2"]}], TraditionalForm]],
  ExpressionUUID->"6a0babaa-4380-4be6-9e01-6877b00625fd"],
 "."
}], "Text",
 CellChangeTimes->{{3.7719305768590508`*^9, 3.771930577164357*^9}, {
  3.77193067464981*^9, 3.771930703076335*^9}, {3.771930766555253*^9, 
  3.7719308260616503`*^9}},ExpressionUUID->"b9e0cdf8-de72-4c36-a9c0-\
e4e57548814e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"U", "(", "r", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "(", "r", ")"}], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], "l", 
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}]}], 
      RowBox[{"2", "\[Mu]", " ", 
       SuperscriptBox["r", "2"]}]]}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], 
      SuperscriptBox["r", "6"]], "+", 
     FractionBox[
      RowBox[{"l", "(", 
       RowBox[{"l", "+", "1"}], ")"}], 
      SuperscriptBox["r", "2"]]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771930579813835*^9, 3.771930607419386*^9}, {
  3.7719308387941647`*^9, 
  3.771930880214415*^9}},ExpressionUUID->"90b3537f-607c-44d2-b889-\
d1ff41842846"],

Cell["So", "Text",
 CellChangeTimes->{{3.771930934515679*^9, 
  3.771930935893297*^9}},ExpressionUUID->"9d0a7d51-0e05-4d75-b56d-\
7e1269f18819"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["k", "2"], "(", "r", ")"}], "=", 
   RowBox[{"\[Epsilon]", "+", 
    FractionBox["1", 
     SuperscriptBox["r", "6"]], "-", 
    FractionBox[
     RowBox[{"l", "(", 
      RowBox[{"l", "+", "1"}], ")"}], 
     SuperscriptBox["r", "2"]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771930937742144*^9, 
  3.771930971195945*^9}},ExpressionUUID->"a0b396d3-315a-4393-b52b-\
3760e859d0f9"],

Cell["\<\
Milne showed [W.E. Milne, Phys. Rev. 35, 863 (1930); Am. Math. Mon. 40, 322 \
(1933)] that the solution can be written\
\>", "Text",
 CellChangeTimes->{{3.771928906064547*^9, 3.771928992063037*^9}, {
  3.77192943790174*^9, 
  3.7719294431702433`*^9}},ExpressionUUID->"34069d9b-d8ba-4c3e-8e3b-\
2f33a5c7fbe0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", "r", ")"}], "=", 
   RowBox[{"a", " ", 
    RowBox[{"\[Alpha]", "(", "r", ")"}], " ", 
    RowBox[{"sin", "(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "r"], 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"-", "2"}]], "(", 
         RowBox[{"r", "'"}], ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"r", "'"}]}]}]}], "+", "b"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.771929447547657*^9, 
  3.77192949869608*^9}},ExpressionUUID->"bd3ce45b-0643-4d19-9bda-\
3f3a163cfaca"],

Cell[TextData[{
 "This result is valid provided that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "(", "r", ")"}], TraditionalForm]],ExpressionUUID->
  "17bdd159-c781-476e-ad17-8ef192e47ed5"],
 " is any particular solution to Milne\[CloseCurlyQuote]s second-order, \
nonlinear differential equation:"
}], "Text",
 CellChangeTimes->{{3.771929512438842*^9, 
  3.77192954475016*^9}},ExpressionUUID->"d3b76961-ae84-4887-8301-\
35855f88e617"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[Alpha]", "(", "r", ")"}]}], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["r", "2"]}]], "+", 
    RowBox[{
     RowBox[{
      SuperscriptBox["k", "2"], "(", "r", ")"}], 
     RowBox[{"\[Alpha]", "(", "r", ")"}]}]}], "=", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["\[Alpha]", "3"], "(", "r", ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7719295460807457`*^9, 
  3.771929588252511*^9}},ExpressionUUID->"ddd3746c-8dd1-4bb2-bbad-\
bbfa2e949ac7"],

Cell["", "Text",
 CellChangeTimes->{{3.772300021414312*^9, 
  3.7723000248816833`*^9}},ExpressionUUID->"c16c85b8-950e-4ed0-bc1b-\
e69be4ec8f80"],

Cell[CellGroupData[{

