Cell["13./64", "Text",
 CellChangeTimes->{{3.772300558224275*^9, 
  3.7723005600628777`*^9}},ExpressionUUID->"dc75cbd7-73ce-4241-90ed-\
d43cc1ec1b98"],

Cell[TextData[{
 "The number of half wavelengths inside a well of depth ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "0"], TraditionalForm]],ExpressionUUID->
  "cae40f7e-2f59-48b0-8e3f-455dc651c0f3"],
 " for a zero-energy solution is ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "1c141bab-da05-47b2-b002-890de00a2cf8"],
 ":"
}], "Text",
 CellChangeTimes->{{3.7726476112915287`*^9, 3.772647630809424*^9}, {
  3.772647895037477*^9, 
  3.7726478961504498`*^9}},ExpressionUUID->"c4118358-8aed-4df7-83c8-\
8dbe17b4def6"],

