Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]test", "=", "0.01"}], ";", 
  RowBox[{"\[Alpha]sol", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]", "''"}], "[", "r", "]"}], "+", 
            RowBox[{
             RowBox[{"ksqr", "[", 
              RowBox[{"\[Epsilon]test", ",", "ltest", ",", "r"}], "]"}], 
             RowBox[{"\[Alpha]", "[", "r", "]"}]}], "-", 
            FractionBox["1", 
             SuperscriptBox[
              RowBox[{"\[Alpha]", "[", "r", "]"}], "3"]]}], "\[Equal]", "0"}],
           ",", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", "rx", "]"}], "\[Equal]", 
           RowBox[{"BC1", "[", 
            RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Alpha]", "'"}], "[", "rx", "]"}], "\[Equal]", 
           RowBox[{"BC2", "[", 
            RowBox[{"\[Epsilon]test", ",", "ltest", ",", "rx"}], "]"}]}]}], 
         "}"}], ",", "\[Alpha]", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rx", ",", "rf"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
