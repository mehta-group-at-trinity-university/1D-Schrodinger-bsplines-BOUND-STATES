deda3b6e987b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"U", "[", 
   RowBox[{"l_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"-", "1"}], 
    SuperscriptBox["r", "6"]], "+", 
   FractionBox[
    RowBox[{"l", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}], 
    SuperscriptBox["r", "2"]]}]}]], "Input",
 CellChangeTimes->{{3.771930561262809*^9, 3.7719305667251596`*^9}, {
  3.771930992430949*^9, 3.771931021523807*^9}, {3.77193108211688*^9, 
  3.771931115973343*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"1cdcf451-1446-4955-aed1-d1c980f8d95b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ksqr", "[", 
   RowBox[{"\[Epsilon]_", ",", "l_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"\[Epsilon]", "-", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], 
      SuperscriptBox["r", "6"]], "+", 
     FractionBox[
      RowBox[{"l", 
       RowBox[{"(", 
        RowBox[{"l", "+", "1"}], ")"}]}], 
      SuperscriptBox["r", "2"]]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.771930450830407*^9, 3.771930466572166*^9}, {
  3.771931122259883*^9, 3.771931153565*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"93be384b-ba11-4875-972a-c72c315b3cf0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BC1", "[", 
   RowBox[{"\[Epsilon]_", ",", "l_", ",", "r_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   SuperscriptBox[
    RowBox[{"ksqr", "[", 
     RowBox[{"\[Epsilon]", ",", "l", ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "4"}]], "]"}]}]], "Input",
