 RowBox[{"indepfplot", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f0table", ",", "g0table"}], "}"}], ",", 
    RowBox[{"Joined", "\[Rule]", "True"}], ",", 
