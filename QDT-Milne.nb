  3.771950302504794*^9}},ExpressionUUID->"6cc5f1cb-2d92-4841-bd40-\
0d3b0c6aeb9c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["f", "0"], "(", "r", ")"}], "=", 
   RowBox[{
    RowBox[{"\[Alpha]", "(", "r", ")"}], " ", 
    RowBox[{"sin", "(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        SubscriptBox["r", "x"], "r"], 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Alpha]", 
          RowBox[{"-", "2"}]], "(", 
         RowBox[{"r", "'"}], ")"}], 
        RowBox[{"\[DifferentialD]", 
         RowBox[{"r", "'"}]}]}]}], "+", "\[Phi]"}], ")"}]}]}], 
  TraditionalForm]], "EquationNumbered",
