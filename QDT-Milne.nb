Cell[BoxData[
 RowBox[{"p1keep", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Alpha]", "[", "r", "]"}], 
        RowBox[{"Sin", "[", 
