Cell[TextData[{
 "\[LineSeparator]\[LineSeparator]Now to determine what value of ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],ExpressionUUID->
  "1f994522-2ae3-45db-80e8-7469abb7cf21"],
 " gives the best base pair with the most linear independence. The expression \
we need is:"
}], "Text",
 CellChangeTimes->{{3.771974649841736*^9, 3.771974689857697*^9}, {
   3.7719756717890453`*^9, 3.771975672731577*^9}, 3.772034986945496*^9, {
