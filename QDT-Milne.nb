Cell[TextData[{
 "This calculation agrees with the small k form for G given in the Ruzic \
paper and thesis, but only for L>0.  For the L=0 case, both terms in the \
small k expression go as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "2"], TraditionalForm]],ExpressionUUID->
  "e699f41b-1a9f-4a8e-9e76-570386ad6246"],
 " and the numerical calculation does NOT agree.  Let\[CloseCurlyQuote]s work \
through the derivation to see if we can verify the expression."
}], "Text",
 CellChangeTimes->{{3.772554095455141*^9, 
  3.7725541831598673`*^9}},ExpressionUUID->"800cde40-5ffb-4852-84f9-\
6fd8e4c2251c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Derivation of small ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "94bf976e-de00-4900-8006-357ce19cab69"],
 " form for ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalG]", TraditionalForm]],ExpressionUUID->
  "02318777-5788-4cb0-add0-11b1a5d4dd4e"],
 "."
}], "Subsection",
 CellChangeTimes->{{3.772554186592013*^9, 
  3.7725541976314983`*^9}},ExpressionUUID->"18208021-db81-44e2-98f3-\
5d07e66b94c8"],

Cell["From the PRA [PRA 87 032706 (2013)] Eq. B11:", "Text",
 CellChangeTimes->{{3.7725542112919827`*^9, 3.7725542362165194`*^9}, {
  3.772555594000394*^9, 
  3.77255559907022*^9}},ExpressionUUID->"d7d896af-d573-4895-883b-\
6b35ff0a6060"],

Cell[BoxData[
 FormBox["f", TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772555601346018*^9, 
  3.7725556070210857`*^9}},ExpressionUUID->"a55ae8b8-6e7b-4b7b-bff1-\
188499316bf6"],

Cell[TextData[{
 "I\[CloseCurlyQuote]ll assume that their expressions for the asymptotic \
forms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["f", "^"], ",", 
    OverscriptBox["g", "^"]}], TraditionalForm]],ExpressionUUID->
  "e04d743c-1c60-41a5-8b45-19e92e2fc3b6"],
 " are correct (Eq. B19)"
}], "Text",
 CellChangeTimes->{{3.772556574647331*^9, 
  3.772556603028977*^9}},ExpressionUUID->"01fea02f-2f78-4ab7-90d7-\
14021a02f841"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["f", "^"], 
   OverscriptBox["\[RightArrow]", 
    RowBox[{
     RowBox[{"r", ">>", "1"}], ",", " ", 
     RowBox[{"E", "\[Rule]", "0"}]}]], 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SqrtBox["a"]}], 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "a"}], ")"}], 
       RowBox[{"l", "+", "1"}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "1"}], ")"}], "!!"}]]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "l"], 
     SqrtBox["a"], 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}], "!!"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "a"}], ")"}], "l"]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772556574647331*^9, 3.772556739340516*^9}, {
  3.7725579175791817`*^9, 
  3.772557917594326*^9}},ExpressionUUID->"ad415a22-76bb-4464-b250-\
f42d5ac36d0b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["g", "^"], 
   OverscriptBox["\[RightArrow]", 
    RowBox[{
     RowBox[{"r", ">>", "1"}], ",", " ", 
     RowBox[{"E", "\[Rule]", "0"}]}]], 
   RowBox[{
    RowBox[{
     SqrtBox["a"], 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}], "!!"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "a"}], ")"}], "l"]], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox[
        RowBox[{"E", " ", 
         SuperscriptBox["r", "2"]}], 
        RowBox[{
         RowBox[{"4", "l"}], "-", "2"}]], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "l"], "E"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "+", "3"}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "-", "1"}], ")"}]}]]}], ")"}]}], "-", 
    RowBox[{
     FractionBox["E", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "3"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "-", "1"}], ")"}]}]], 
     SqrtBox["a"], 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r", "/", "a"}], ")"}], 
       RowBox[{"l", "+", "1"}]], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "l"}], "+", "1"}], ")"}], "!!"}]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772556574647331*^9, 3.772556739340516*^9}, {
  3.7725579175791817`*^9, 
  3.7725580274137783`*^9}},ExpressionUUID->"883d19ea-be47-448b-b3b5-\
71a072217d3e"],

Cell[CellGroupData[{

Cell["Bound state case", "Subsubsection",
 CellChangeTimes->{{3.772555947574149*^9, 
  3.772555950102592*^9}},ExpressionUUID->"fcfd652c-a294-4cca-94f0-\
76677b95aca2"],

Cell["Starting with Eq. B24", "Text",
 CellChangeTimes->{{3.772555952178339*^9, 
  3.772555956894238*^9}},ExpressionUUID->"553e45fd-9ae0-4b08-a109-\
06f1d97199c1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"tan", " ", "\[Gamma]", " ", 
     OverscriptBox["f", "^"]}], "+", 
    OverscriptBox["g", "^"]}], 
   OverscriptBox["\[RightArrow]", 
    RowBox[{"r", " ", ">>", " ", "1"}]], 
   RowBox[{"D", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "r"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.772555960903441*^9, 3.772555980165422*^9}, {
  3.7725565225297403`*^9, 
  3.772556560904037*^9}},ExpressionUUID->"ed0b26e1-030b-4ffc-8fbb-\
5719a42b0d09"],

Cell["Plugging in the asymptotic forms:", "Text",
 CellChangeTimes->{{3.7726305400940447`*^9, 
  3.772630544416133*^9}},ExpressionUUID->"a4b08384-6da2-4866-bc08-\
4724389ee8cb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"tan", " ", "\[Gamma]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SqrtBox["a"]}], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "/", "a"}], ")"}], 
          RowBox[{"l", "+", "1"}]], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "l"}], "+", "1"}], ")"}], "!!"}]]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "l"], 
        SqrtBox["a"], 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "l"}], "-", "1"}], ")"}], "!!"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "/", "a"}], ")"}], "l"]]}]}], ")"}]}], "+", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SqrtBox["a"], 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "l"}], "-", "1"}], ")"}], "!!"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "/", "a"}], ")"}], "l"]], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[Kappa]", "2"]}], " ", 
           SuperscriptBox["r", "2"]}], 
          RowBox[{
           RowBox[{"4", "l"}], "-", "2"}]], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "l"], 
           SuperscriptBox["\[Kappa]", "2"]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "l"}], "+", "3"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "l"}], "-", "1"}], ")"}]}]]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["\[Kappa]", "2"], 
        RowBox[{
         RowBox[{"(", 
