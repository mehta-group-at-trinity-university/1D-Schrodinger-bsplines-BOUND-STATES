Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[DifferentialD]", 
     RowBox[{
      SuperscriptBox["f", "0"], "(", "r", ")"}]}], 
    RowBox[{"\[DifferentialD]", "r"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "'"}], 
     RowBox[{"(", "r", ")"}], 
     RowBox[{"sin", "(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Integral]", 
         SubscriptBox["r", "x"], "r"], 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Alpha]", 
