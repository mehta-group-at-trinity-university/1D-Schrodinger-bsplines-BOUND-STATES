Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", " "}], TraditionalForm]],ExpressionUUID->
  "c277ae9b-02f5-44ab-b820-fc5bae0a1397"],
 "is unknown anyhow, so is the product ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", " ", 
    RowBox[{"B", "/", "C"}]}], TraditionalForm]],ExpressionUUID->
  "734ca1ed-8694-4ec6-ab23-c86e5b896fdd"],
 ", therefore, just absorb ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "/", "C"}], TraditionalForm]],ExpressionUUID->
  "2a14e079-3097-45a9-bf52-54ca4f530d8b"],
 " into ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "9a87ce25-a79f-4758-b7a2-1f5f7da54579"],
 "."
}], "Text",
 CellChangeTimes->{{3.772847058999465*^9, 
  3.772847130375669*^9}},ExpressionUUID->"b0fd87b5-964e-425f-b9c4-\
f41f81d569d2"],

