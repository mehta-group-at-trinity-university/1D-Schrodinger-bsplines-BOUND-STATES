          RowBox[{"integrand", ",", 
           RowBox[{"{", 
            RowBox[{"rp", ",", "rx", ",", "r"}], "}"}]}], "]"}], "]"}]}], "/.",
        "\[Alpha]sol"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Alpha]", "[", "r", "]"}]}], 
        RowBox[{"Cos", "[", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{"integrand", ",", 
           RowBox[{"{", 
            RowBox[{"rp", ",", "rx", ",", "r"}], "}"}]}], "]"}], "]"}]}], "/.",
        "\[Alpha]sol"}], ",", 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"ksqr", "[", 
