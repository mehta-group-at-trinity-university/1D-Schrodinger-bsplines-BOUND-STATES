Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]plus", "[", 
    RowBox[{"L_", ",", "R_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox["R"], 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "4"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "L"}], "+", "1"}], ")"}]}], ",", 
      FractionBox["1", 
       RowBox[{"2", 
        SuperscriptBox["R", "2"]}]]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Chi]minus", "[", 
    RowBox[{"L_", ",", "R_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox["R"], 
    RowBox[{"BesselJ", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "4"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "L"}], "+", "1"}], ")"}]}], ",", 
      FractionBox["1", 
       RowBox[{"2", 
        SuperscriptBox["R", "2"]}]]}], "]"}]}]}], ";"}]}], "Input",
