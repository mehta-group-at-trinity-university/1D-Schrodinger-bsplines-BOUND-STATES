Cell[CellGroupData[{

Cell["Addition of short-range square well potential", "Subsection",
 CellChangeTimes->{{3.772300030925151*^9, 
  3.7723000365716267`*^9}},ExpressionUUID->"859ffa78-1caa-4969-be8e-\
59d728c610ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r0", "=", "0.2"}], ";", 
  RowBox[{"kin", "=", 
   RowBox[{
    SqrtBox[
     RowBox[{"V0", "+", "\[Epsilon]"}]], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Epsilon]", "\[Rule]", "0.0"}], ",", 
      RowBox[{"V0", "\[Rule]", 
       FractionBox["10", 
        SuperscriptBox["r0", "6"]]}]}], "}"}]}]}], ";", 
  RowBox[{
   RowBox[{"logdersquare", "[", 
    RowBox[{"l_", ",", "V0_", ",", "r0_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kin", ",", "r"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"kin", "=", 
       SqrtBox[
        RowBox[{"V0", "+", "\[Epsilon]"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"D", "[", " ", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"r", " ", 
           RowBox[{"SphericalBesselJ", "[", 
            RowBox[{"l", ",", 
             RowBox[{"kin", " ", "r"}]}], "]"}]}], "]"}], ",", "r"}], "]"}], "/.", 
       RowBox[{"r", "\[Rule]", "r0"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.772300040356511*^9, 3.772300062180213*^9}, 
   3.772366062232184*^9, {3.7723700138094997`*^9, 3.772370019317082*^9}, {
   3.772370203512179*^9, 3.7723702866601763`*^9}, {3.772371021899558*^9, 
