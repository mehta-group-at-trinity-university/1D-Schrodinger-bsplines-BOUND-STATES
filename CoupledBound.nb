Cell[BoxData[
 RowBox[{
  RowBox[{"Vmorse", "[", 
   RowBox[{"a_", ",", "re_", ",", "De_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"De", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"r", "-", "re"}], ")"}]}], "/", "a"}]]}], ")"}], "2"]}], 
   "-", "De"}]}]], "Input",
