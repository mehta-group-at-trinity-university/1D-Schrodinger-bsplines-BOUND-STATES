Cell["For a double integral we have", "Text",
 CellChangeTimes->{{3.802834610381749*^9, 
  3.802834614042926*^9}},ExpressionUUID->"242f17e4-a862-4a63-b200-\
28a68f45d63f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", "a", "b"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "c", "d"], 
     RowBox[{
      RowBox[{"f", "(", 
       RowBox[{"x", ",", "y"}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}], 
      RowBox[{"\[DifferentialD]", "y"}]}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "1"}], "1"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "1"}], "1"], 
      RowBox[{
       RowBox[{"f", "(", 
        RowBox[{
         RowBox[{"a", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "a"}], ")"}], "x"}]}], ",", 
         RowBox[{"c", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", "-", "c"}], ")"}], "y"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"b", "-", "a"}], ")"}], 
       RowBox[{"\[DifferentialD]", "x"}], " ", 
       RowBox[{"(", 
        RowBox[{"d", "-", "c"}], ")"}], 
       RowBox[{"\[DifferentialD]", "y"}]}]}]}], "\[TildeTilde]", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}]], "N"], 
     RowBox[{
      OverscriptBox[
       UnderscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}]], "N"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", "-", "a"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"d", "-", "c"}], ")"}], 
       SubscriptBox["w", "i"], 
       SubscriptBox["w", "j"], 
       RowBox[{"f", "(", 
        RowBox[{
         RowBox[{"a", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "a"}], ")"}], 
           SubscriptBox["x", "i"]}]}], ",", 
         RowBox[{"c", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", "-", "c"}], ")"}], 
           SubscriptBox["y", "i"]}]}]}], ")"}]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
