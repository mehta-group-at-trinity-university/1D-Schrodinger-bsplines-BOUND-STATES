Cell[CellGroupData[{

Cell["Lobatto nodes and weights", "Subsection",
 CellChangeTimes->{{3.762012532198215*^9, 3.762012544397738*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ea20a345-dbf9-4844-bce5-151b2a1b1e79"],

Cell[TextData[{
 "The free abscissa are the nodes of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"M", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "441aaf3a-a60d-464c-873c-37d14a8f485a"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"M", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "4188b18f-2b00-49cd-9fe9-6bafd7802e09"],
 " is a Legendre polynomial of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "acbccaea-b9ad-4d84-95ef-60c4f89552ec"],
 "."
}], "Text",
 CellChangeTimes->{{3.762012792186956*^9, 3.7620128296191683`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"c92f1567-f9f6-4599-a8f8-c266aa486e9a"],

Cell["First define the DVR basis functions:", "Text",
 CellChangeTimes->{{3.762013735335517*^9, 3.762013767761855*^9}, 
   3.762016503574559*^9, {3.762019304214798*^9, 3.7620193388007708`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"bb838f56-6608-4688-8f31-ca7783c19329"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Chi]GL", "[", 
   RowBox[{"nodes_", ",", "i_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{"nodes", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"nodes", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"nodes", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{"nodes", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"nodes", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"nodes", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"i", "+", "1"}], ",", 
       RowBox[{"M", "+", "2"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.762013570566304*^9, 3.762013662264132*^9}, {
   3.762013709989736*^9, 3.76201372720238*^9}, {3.76201891027323*^9, 
   3.762018914105336*^9}, {3.762037768262383*^9, 3.762037848070327*^9}, {
   3.762037878308598*^9, 3.762037967961276*^9}, {3.762038175156711*^9, 
   3.762038185241817*^9}, 3.762038228033945*^9, {3.762038836186309*^9, 
   3.76203883847405*^9}, {3.762039537469914*^9, 3.762039549812489*^9}},
 TextAlignment->Left,
 TextJustification->0.,
 CellLabel->"In[3]:=",ExpressionUUID->"f910e17d-e2f2-4bf3-8e3d-8cde7234667c"],

Cell["Calculate the weights, abscissa for the range 0,1", "Text",
 CellChangeTimes->{{3.76201937380667*^9, 3.762019391700808*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ace8b34c-a9b9-4de9-9539-25c1195a8fd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", "=", "20"}], ";", 
  RowBox[{"precision", "=", "20"}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xnodes", ",", "weights", ",", "errwn"}], "}"}], "=", 
   RowBox[{"NIntegrate`LobattoRuleData", "[", 
    RowBox[{
     RowBox[{"M", "+", "2"}], ",", "precision"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.7620190582536573`*^9, {3.7620192709495087`*^9, 3.762019272348468*^9}, {
   3.7620196724520206`*^9, 3.762019672567423*^9}, {3.76202011217623*^9, 
   3.7620201314907293`*^9}, {3.7620379763577538`*^9, 
   3.7620379917591553`*^9}, {3.762038030638401*^9, 3.76203807828283*^9}, {
   3.762039857925447*^9, 3.762039858396723*^9}, {3.762098431217011*^9, 
   3.762098431363913*^9}, {3.762443766552145*^9, 3.762443766601235*^9}, {
   3.769856773863278*^9, 3.769856774052491*^9}, {3.769864258198791*^9, 
   3.7698642583253813`*^9}, {3.803175453383328*^9, 3.803175454550722*^9}, {
   3.803207829906909*^9, 3.803207830086564*^9}, {3.803209872915124*^9, 
   3.803209873098298*^9}, {3.803209903761487*^9, 3.803209904076092*^9}, {
   3.80320996354633*^9, 3.8032099637813063`*^9}, 3.803219746507391*^9, {
   3.8032205789426622`*^9, 3.803220580131181*^9}, {3.803221720810457*^9, 
   3.803221721837069*^9}, {3.822064720053564*^9, 3.822064722229066*^9}, {
   3.822064826472148*^9, 3.822064826909421*^9}, {3.822065058294714*^9, 
   3.822065060028571*^9}, {3.823878196325526*^9, 3.82387819737047*^9}, {
   3.826293874419571*^9, 3.826293875930551*^9}},
 TextAlignment->Left,
 TextJustification->0.,
 CellLabel->"In[68]:=",ExpressionUUID->"d5bee92b-cc17-469e-b219-16c409bba7c1"],

Cell[BoxData[
 RowBox[{"xnodes", ";"}]], "Input",
 CellChangeTimes->{{3.802734990392516*^9, 3.8027349912880287`*^9}, 
   3.823878217217946*^9},
 CellLabel->"In[69]:=",ExpressionUUID->"04be4a20-3cc2-461a-8a7b-871c2decab13"],

