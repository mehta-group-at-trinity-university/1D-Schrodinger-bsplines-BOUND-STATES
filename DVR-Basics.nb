Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Energy", "[", 
   RowBox[{"l_", ",", "nr_", ",", "R0_"}], "]"}], ":=", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"BesselJZero", "[", 
     RowBox[{
      RowBox[{"l", "+", 
       RowBox[{"1", "/", "2"}]}], ",", "nr"}], "]"}], "2"], 
   RowBox[{"2", " ", 
    SuperscriptBox["R0", "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "n", ",", 
          RowBox[{"N", "[", 
           RowBox[{"Energy", "[", 
            RowBox[{"l", ",", "n", ",", "10.0"}], "]"}], "]"}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}],
     ",", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "<", 
      RowBox[{"#2", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], "&"}]}], "]"}], "//", 
  "MatrixForm"}], "\n", 
 RowBox[{
  RowBox[{"Rmax", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ltest", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", 
   SqrtBox[
    RowBox[{"2", 
     RowBox[{"N", "[", 
      RowBox[{"Energy", "[", 
       RowBox[{"ltest", ",", "1", ",", "Rmax"}], "]"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["R", "2"], 
      SuperscriptBox[
       RowBox[{"SphericalBesselJ", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"k", " ", "R"}]}], "]"}], "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"R", ",", "0", ",", "Rmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pex", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"3.2", " ", "R", 
      FractionBox[
       RowBox[{"SphericalBesselJ", "[", 
        RowBox[{"ltest", ",", 
         RowBox[{"k", " ", "R"}]}], "]"}], 
       SqrtBox["norm"]]}], ",", 
     RowBox[{"{", 
      RowBox[{"R", ",", "0", ",", "Rmax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pwfn", ",", "pex"}], "]"}]}], "Input",
