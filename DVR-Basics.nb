Notebook[{

Cell[CellGroupData[{
Cell["Discrete Variable Representation", "Title",
 CellChangeTimes->{{3.761752253494977*^9, 3.7617522786553926`*^9}, {
  3.7617523122353354`*^9, 3.7617523188702097`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"77edbf67-8056-41b0-9dcc-3b9a3eca2d3b"],

Cell[CellGroupData[{

Cell["Nirav Mehta", "Author",
 CellChangeTimes->{{3.761752321286232*^9, 3.761752327602989*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e1c9cfd7-4e56-4495-bbba-6d99a7c5571f"],

Cell["Trinity University", "Institution",
 CellChangeTimes->{{3.7617523292622223`*^9, 3.76175233464599*^9}, {
  3.761752454210527*^9, 3.761752454215096*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"cdb98aec-3686-4c58-9e83-15af38897532"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{3.7617524639946117`*^9, 3.7617524809131813`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"61116e06-c119-4242-a219-c23c95de4c11"],

Cell["\<\
These notes are based in part on lecture notes of Hans-Dieter Meyer.\
\>", "Text",
 CellChangeTimes->{{3.761753009810884*^9, 3.7617530276971416`*^9}, {
  3.7620427905759983`*^9, 3.762042791587822*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"82390865-0f6d-4d38-87f8-5e0674e94c83"],

Cell["\<\
These are basic notes serving as a record of my attempt to learn DVR methods. \
 Numerical methods are broadly divided into so-called \"spectral methods\" \
where one chooses an orthonormal basis (e.g. harmonic oscillator states) and \
calculates matrix elements for a Hamiltonian that can then be diagonalized, \
and \"grid methods\" where one uses the position eigenstates as the basis \
forming a grid.  In grid methods such as the finite-difference method, the \
potential energy operator is diagonal, while the kinetic energy is usually \
tri-diagonal (in the simplest approximation).  \
\>", "Text",
 CellChangeTimes->{{3.76175249076889*^9, 3.76175259369033*^9}, {
  3.761752638857181*^9, 3.761752725549191*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"803c5d6f-d938-4a2b-be5e-97d909107021"],

Cell["\<\
DVR is in some ways a mixture of grid and spectral methods, a \
\[OpenCurlyDoubleQuote]pseudo-spectral method\[CloseCurlyDoubleQuote].  \
\>", "Text",
 CellChangeTimes->{{3.76175249076889*^9, 3.76175259369033*^9}, {
  3.761752638857181*^9, 3.761752754018057*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3d5c17a5-47b3-4e56-b98e-22e87fac4cdc"],

Cell[TextData[{
 "Pseudo-spectral methods use a global basis set, say ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Phi]", "j"], "(", "x", ")"}], "}"}], TraditionalForm]],
  ExpressionUUID->"ba1e11bb-835e-4cae-aedf-611b2ebdcf90"],
 " and a set of grid points ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox["x", "\[Alpha]"], "}"}], TraditionalForm]],ExpressionUUID->
  "48c55f68-de57-425a-bcb7-e164ea3669b0"],
 ".  Both ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "1a6fe430-c4cc-4a6d-9430-0c8af16b60db"],
 " and ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "156fbff2-6ea9-4e4a-aefc-2f8b85f33ea6"],
 " run from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "..."}], "n"}], TraditionalForm]],ExpressionUUID->
  "3cd0a60c-ddff-4754-a86f-12fc61c37d74"],
 ".  "
}], "Text",
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e4093b3f-6389-4ac2-a534-b5f974ce03b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Collocation", "Section",
 CellChangeTimes->{{3.7617524639946117`*^9, 3.761752489093936*^9}, {
  3.7617530024762993`*^9, 3.761753004121537*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"1bfb76a1-92dd-4135-9732-e5562b20dc0d"],

Cell[TextData[{
 "Collocation is a simple method for determining the expansion coefficients \
for a wavefunction.  If one has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "(", "x", ")"}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], 
     RowBox[{
      SubscriptBox["a", "j"], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", "x", ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"90d3c305-c5b5-428a-a386-2338944ace19"],
 ", one ",
 StyleBox["could ",
  FontSlant->"Italic"],
 "use Fourier\[CloseCurlyQuote]s trick to determine the coefficients.  Or one \
could use ",
 StyleBox["collocation, ",
  FontSlant->"Italic"],
 "which amounts to requiring that the solution agree with the known \
wavefunction at ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a533fc19-8e03-48fb-8f06-8c5689eccb5f"],
 " distinct points:"
}], "Text",
 CellChangeTimes->{{3.7617527755405684`*^9, 3.7617528524680843`*^9}, {
  3.7617529402595778`*^9, 3.761752958977325*^9}, {3.761752989621334*^9, 
  3.7617529994475594`*^9}, {3.761753043081244*^9, 3.761753189961628*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f7380174-86ef-4776-b22a-a05578f311e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", 
    SubscriptBox["x", "\[Alpha]"], ")"}], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     SubscriptBox["a", "j"], 
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "(", 
      SubscriptBox["x", "\[Alpha]"], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753195770536*^9, 3.761753261134645*^9}, {
  3.761754647723222*^9, 3.761754674276692*^9}, {3.761755526672695*^9, 
  3.761755537917069*^9}, {3.7617555877037573`*^9, 3.761755593409643*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"4eecf957-932b-4009-8919-cc511d78eb13"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox["x", "\[Alpha]"], "\[Psi]"},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      SubscriptBox["a", "j"], 
      TemplateBox[{
        SubscriptBox["x", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "j"]},
       "BraKet"]}]}], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["x", "\[Alpha]"], 
        SubscriptBox["\[Phi]", "j"]},
       "BraKet"], 
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"], "\[Psi]"},
       "BraKet"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.76175559060386*^9, 3.761755594279319*^9}, {
  3.761759753189281*^9, 3.761759791544752*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"00897800-124a-41f0-b93e-132350aa3bc4"],

Cell["by defining", "Text",
 CellChangeTimes->{{3.761753223460235*^9, 3.7617532367352667`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"4dfd4f43-ebbb-4174-b5c3-2bf67fa59017"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["G", 
    RowBox[{"\[Alpha]", ",", "j"}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "j"], "(", 
     SubscriptBox["x", "\[Alpha]"], ")"}], "=", 
    TemplateBox[{
      SubscriptBox["x", "\[Alpha]"], 
      SubscriptBox["\[Phi]", "j"]},
     "BraKet"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753239088752*^9, 3.76175326909231*^9}, {
  3.761755500741241*^9, 3.761755509990152*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"1f4e84c0-037c-4095-bf9e-5c394eaecfd5"],

Cell["The above equation reads:", "Text",
 CellChangeTimes->{{3.761753273360153*^9, 3.7617532770190487`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f4d914ae-0cc4-4d15-9f61-799915df32e3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", 
    SubscriptBox["x", "\[Alpha]"], ")"}], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     SubscriptBox["a", "j"], 
     SubscriptBox["G", 
      RowBox[{"\[Alpha]", ",", "j"}]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753281439107*^9, 3.761753285783248*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3f08673e-3332-413c-86c5-456422515f9c"],

Cell["or in matrix form:", "Text",
 CellChangeTimes->{{3.761753292496297*^9, 3.761753295137658*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"21953c20-7941-4f2a-bb71-c940beccaf87"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[Psi]",
    FontWeight->"Bold"], "=", 
   RowBox[{
    StyleBox["G",
     FontWeight->"Bold"], " ", 
    StyleBox["a",
     FontWeight->"Bold"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753299395859*^9, 3.761753304819549*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"36dbaecf-5e97-4227-9c9d-224288398acd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["a",
    FontWeight->"Bold"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["G",
      FontWeight->"Bold"], 
     RowBox[{"-", "1"}]], 
    StyleBox["\[Psi]",
     FontWeight->"Bold"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753346361902*^9, 3.761753352935351*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"185031fb-a813-443b-9f24-58df4a2e791a"],

Cell[TextData[{
 "The matrix ",
 Cell[BoxData[
  FormBox[
   StyleBox["G",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "6ddebd25-7d4f-49cb-9946-26089c8038d7"],
 " serves as a linear transformation from the basis representation to the \
grid representation."
}], "Text",
 CellChangeTimes->{{3.761755626327157*^9, 3.761755653480781*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"7bbc8210-0842-4b86-b2c1-2c9d66039e26"],

Cell[TextData[{
 "In the grid representation, ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["V", "^"], TraditionalForm]],ExpressionUUID->
  "ce1575ec-7def-4498-8267-94a64aea90fc"],
 " is a diagonal matrix:"
}], "Text",
 CellChangeTimes->{{3.761753380709551*^9, 3.761753398678215*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"49692a33-6ebb-487f-b7b0-521f1a2925b5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["V", 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}]], "=", 
   RowBox[{
    RowBox[{"V", "(", 
     SubscriptBox["x", "\[Alpha]"], ")"}], 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753400487363*^9, 3.761753420688938*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"c0d280b4-58b9-4524-86cf-2a1ba15133e4"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["T", "^"], TraditionalForm]],ExpressionUUID->
  "f77a11d5-b936-4361-9bec-afc80f08f95a"],
 " denote a general operator.  It has matrix elements with respect to \
functions (in the basis representation):"
}], "Text",
 CellChangeTimes->{{3.7617534367210217`*^9, 3.7617534644206667`*^9}, {
  3.761905069881102*^9, 3.761905079429734*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"0cd5db99-612a-47d3-bcda-17f76d33e628"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"\[Phi]"},
     "Bra"], 
    OverscriptBox["T", "^"], 
    TemplateBox[{"\[Psi]"},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["a",
       FontWeight->"Bold"], "\[Phi]", "\[Dagger]"], 
     SuperscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      RowBox[{"(", "b", ")"}]], 
     SubscriptBox[
      StyleBox["a",
       FontWeight->"Bold"], "\[Psi]"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["G",
           FontWeight->"Bold"], 
          RowBox[{"-", "1"}]], 
         StyleBox["\[Phi]",
          FontWeight->"Bold"]}], ")"}], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["T",
        FontWeight->"Bold"], 
       RowBox[{"(", "b", ")"}]], 
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], 
       RowBox[{"-", "1"}]], 
      StyleBox["\[Psi]",
       FontWeight->"Bold"]}], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        StyleBox["\[Phi]",
         FontWeight->"Bold"], "\[Dagger]"], "(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["G",
          FontWeight->"Bold"], 
         SuperscriptBox["\[Dagger]", 
          RowBox[{"-", "1"}]]], 
        SuperscriptBox[
         StyleBox["T",
          FontWeight->"Bold"], 
         RowBox[{"(", "b", ")"}]], 
        SuperscriptBox[
         StyleBox["G",
          FontWeight->"Bold"], 
         RowBox[{"-", "1"}]]}], ")"}], 
      StyleBox["\[Psi]",
       FontWeight->"Bold"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761905088582479*^9, 3.761905105852026*^9}, {
  3.761905264238009*^9, 3.761905444878841*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d2710fed-817b-4bde-8c5c-f88b964b5e6b"],

Cell["Evidently,", "Text",
 CellChangeTimes->{{3.761905449467029*^9, 3.7619054520153933`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f3c45890-5d7b-4e2f-bd0a-da9791c79790"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], "g"], "=", 
   RowBox[{
    SuperscriptBox[
     StyleBox["G",
      FontWeight->"Bold"], 
     SuperscriptBox["\[Dagger]", 
      RowBox[{"-", "1"}]]], 
    SuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     RowBox[{"(", "b", ")"}]], 
    SuperscriptBox[
     StyleBox["G",
      FontWeight->"Bold"], 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761905449467029*^9, 3.761905473145555*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"00174343-4648-469f-822f-1846009e2409"],

Cell["where", "Text",
 CellChangeTimes->{{3.76190549932236*^9, 3.761905499821217*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"21d1d243-5525-4321-9284-48fd61ae0511"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["T", 
    RowBox[{"i", ",", "j"}], 
    RowBox[{"(", "b", ")"}]], "=", 
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Phi]", "i"]},
     "Bra"], 
    OverscriptBox["T", "^"], 
    TemplateBox[{
      SubscriptBox["\[Phi]", "j"]},
     "Ket"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761753466528256*^9, 3.761753524973431*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"46f6a8e4-4f8f-4a6e-ae16-585464c4bd11"],

Cell[TextData[{
 "If we choose the identity operator, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["T", "^"], "=", 
    OverscriptBox["1", "^"]}], TraditionalForm]],ExpressionUUID->
  "6e8e20fe-9593-420d-a3e4-3fd711fcb243"],
 ", then we obtain the overlap integral "
}], "Text",
 CellChangeTimes->{{3.7619055253154383`*^9, 3.7619055457797403`*^9}, {
  3.761905926884158*^9, 3.7619059461646967`*^9}, {3.761905982796564*^9, 
  3.761905983299981*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d2f671e0-3f30-4666-9034-0833b7b05900"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[Phi]", "\[Psi]"},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["\[Phi]",
       FontWeight->"Bold"], "\[Dagger]"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        StyleBox["G",
         FontWeight->"Bold"], " ", 
        SuperscriptBox[
         StyleBox["G",
          FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
      RowBox[{"-", "1"}]], 
     StyleBox["\[Psi]",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
     RowBox[{
      RowBox[{"\[Phi]", "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubscriptBox[
       RowBox[{"(", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           StyleBox["G",
            FontWeight->"Bold"], " ", 
           SuperscriptBox[
            StyleBox["G",
             FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
         RowBox[{"-", "1"}]], ")"}], 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
      RowBox[{"\[Psi]", "(", 
       SubscriptBox["x", "\[Beta]"], ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7619059355720882`*^9, 3.761906003163466*^9}, {
  3.761906060748638*^9, 3.761906199842936*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d6b219b1-fdc6-4a7a-bd61-f50e7250b621"],

Cell["\<\
which is similar to a quadrature rule, except for the double sum.  If we wish \
to evaluate this overlap integral (and other matrix elements) with \
quadrature, then we must require:\
\>", "Text",
 CellChangeTimes->{{3.76190620786384*^9, 3.761906260365539*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d89f8b5e-ddad-4d5f-9e98-6df30dd33b05"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        StyleBox["G",
         FontWeight->"Bold"], " ", 
        SuperscriptBox[
         StyleBox["G",
          FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
      RowBox[{"-", "1"}]], ")"}], 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}]], "=", 
   RowBox[{
    SubscriptBox["w", "\[Alpha]"], 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761906270041205*^9, 3.761906282038048*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"63ba373d-a0da-4263-ba3e-e29b93e761cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["G",
       FontWeight->"Bold"], " ", 
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}]], "=", 
   RowBox[{
    SubsuperscriptBox["w", "\[Alpha]", 
     RowBox[{"-", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761906197783437*^9, 3.761906198378976*^9}, {
  3.76190630496638*^9, 3.761906332149695*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"73f9dd8c-1e32-4959-a157-d957f2729061"],

Cell["so that", "Text",
 CellChangeTimes->{{3.761906390372971*^9, 3.761906391007944*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"6e5ad2c5-0090-4919-a901-3a9937a6c5c7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"\[Phi]", "\[Psi]"},
    "BraKet"], "=", 
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["w", "\[Alpha]"], 
     RowBox[{"\[Phi]", "\[Conjugate]"}], 
     RowBox[{"(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], 
     RowBox[{"\[Psi]", "(", 
      SubscriptBox["x", "\[Alpha]"], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761906396349736*^9, 3.761906419970889*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"6dd38a08-e8f7-421e-a282-8e35a6c23b8c"],

Cell[TextData[{
 "We can collect the weights into a diagonal matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["W",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["G",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "e8a4323f-555c-425b-b8ec-eced2abaa2ee"],
 " with matrix elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["W", "\[Alpha]\[Beta]"], "=", 
    RowBox[{
     SubscriptBox["\[Delta]", "\[Alpha]\[Beta]"], 
     RowBox[{
      SubscriptBox["w", "\[Alpha]"], "."}]}]}], TraditionalForm]],
  ExpressionUUID->"be31bff6-cdec-4bc7-b2cf-94f81081ec3c"]
}], "Text",
 CellChangeTimes->{{3.761906679165677*^9, 3.761906716058783*^9}, {
  3.7619069521036367`*^9, 3.761906952306253*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e2a7311a-86a4-467d-af04-83acf517e680"],

Cell["The grid representation of an operator can be written:", "Text",
 CellChangeTimes->{{3.761906826728364*^9, 3.76190683693259*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"58dcd3b2-3914-4b60-9f35-b34fcbb71eba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], "g"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["G",
       FontWeight->"Bold"], 
      SuperscriptBox["\[Dagger]", 
       RowBox[{"-", "1"}]]], 
     SuperscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      RowBox[{"(", "b", ")"}]], 
     SuperscriptBox[
      StyleBox["G",
       FontWeight->"Bold"], 
      RowBox[{"-", "1"}]]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], 
        SuperscriptBox["\[Dagger]", 
         RowBox[{"-", "1"}]]], "(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["G",
          FontWeight->"Bold"], 
         RowBox[{"-", "1"}]], 
        StyleBox["G",
         FontWeight->"Bold"]}], 
       StyleBox[")",
        FontWeight->"Bold"]}], " ", 
      SuperscriptBox[
       StyleBox["T",
        FontWeight->"Bold"], 
       RowBox[{"(", "b", ")"}]], 
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], 
       RowBox[{"-", "1"}]]}], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          StyleBox["G",
           FontWeight->"Bold"], " ", 
          SuperscriptBox[
           StyleBox["G",
            FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
        RowBox[{"-", "1"}]], 
       StyleBox["G",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        RowBox[{"(", "b", ")"}]], 
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], 
        RowBox[{"-", "1"}]]}], "=", 
      RowBox[{
       StyleBox["W",
        FontWeight->"Bold"], " ", 
       StyleBox["G",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        RowBox[{"(", "b", ")"}]], 
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], 
        RowBox[{"-", "1"}]]}]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761906838539555*^9, 3.761906935866973*^9}, {
  3.761906973379389*^9, 3.761906981384004*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"1d4b84bd-06d7-420b-b086-7ea04ca15683"],

Cell["Now, for the quadrature rule to work we must have", "Text",
 CellChangeTimes->{{3.761907070633947*^9, 3.761907088702003*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"5446758b-20fa-45de-bde1-56aa6f2060ce"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["G",
       FontWeight->"Bold"], " ", 
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}]], "=", 
   RowBox[{
    SubsuperscriptBox["w", "\[Alpha]", 
     RowBox[{"-", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{3.7619070903115873`*^9},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"11219760-5da6-4527-be99-c5cde4b629d5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", "j"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], 
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
     RowBox[{"(", 
      SubscriptBox["x", "\[Beta]"], ")"}]}]}], "=", 
   RowBox[{
    SubsuperscriptBox["w", "\[Alpha]", 
     RowBox[{"-", "1"}]], 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761907105868206*^9, 3.761907213161417*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"06d21724-6642-4fda-bf54-dc1c1c6e7502"],

Cell[TextData[{
 "It is not obvious that it is even ",
 StyleBox["possible ",
  FontSlant->"Italic"],
 "to find a basis with this property.  But we shall show that DVR provides a \
way to define such a basis and choose points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "d991a60f-ddad-4472-bf94-c352a8ec3cdf"],
 " so that the above equation is satisfied.  Let us for now assume that such \
functions and points exist and consider the consequences."
}], "Text",
 CellChangeTimes->{{3.761907228881158*^9, 3.761907338104094*^9}, {
  3.761907638203569*^9, 3.761907658195716*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e50271d1-8041-4d78-b312-785334263a4d"],

Cell[TextData[{
 "We can rescale ",
 Cell[BoxData[
  FormBox[
   StyleBox["G",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "98e8b436-2edc-4b98-b392-9d62e8b56d00"],
 "  so that it is unitary:"
}], "Text",
 CellChangeTimes->{{3.7619076996953773`*^9, 3.7619077153789997`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"6767c40e-e2d1-490a-8be2-6ec93e09f5e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["W",
    FontWeight->"Bold"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["G",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold"], "\[Dagger]"], 
       RowBox[{"-", "1"}]], 
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], 
       RowBox[{"-", "1"}]]}], "\[DoubleRightArrow]"}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761907101514811*^9, 3.761907103401927*^9}, {
  3.761907721514071*^9, 3.761907794070486*^9}, {3.7619078420175343`*^9, 
  3.7619078578429956`*^9}, {3.7619078881732616`*^9, 3.76190795053857*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f0d8abae-d88d-4939-9a67-f1d3d08c7cca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["1",
    FontWeight->"Bold"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["G",
       FontWeight->"Bold"], "\[Dagger]"], 
     StyleBox["W",
      FontWeight->"Bold"], " ", 
     StyleBox["G",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["W",
        FontWeight->"Bold"], 
       RowBox[{"1", "/", "2"}]], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["W",
        FontWeight->"Bold"], 
       RowBox[{"1", "/", "2"}]], " ", 
      StyleBox["G",
       FontWeight->"Bold"]}], "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["W",
           FontWeight->"Bold"], 
          RowBox[{"1", "/", "2"}]], 
         StyleBox["G",
          FontWeight->"Bold"]}], 
        StyleBox[")",
         FontWeight->"Bold"]}], "\[Dagger]"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      RowBox[{
       StyleBox["(",
        FontWeight->"Bold"], 
       RowBox[{
        SuperscriptBox[
         StyleBox["W",
          FontWeight->"Bold"], 
         RowBox[{"1", "/", "2"}]], " ", 
        StyleBox["G",
         FontWeight->"Bold"]}], 
       StyleBox[")",
        FontWeight->"Bold"]}]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{3.761907952244226*^9},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3c8dd49b-7cfc-4265-ae89-133a70d69804"],

Cell["So we define a unitary transformation:", "Text",
 CellChangeTimes->{{3.761907960199683*^9, 3.76190796645*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f33a4777-af2a-4717-8147-fb11c3652f18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["U",
      FontWeight->"Bold"], "\[Dagger]"], "=", 
    RowBox[{
     StyleBox["(",
      FontWeight->"Bold"], 
     RowBox[{
      SuperscriptBox[
       StyleBox["W",
        FontWeight->"Bold"], 
       RowBox[{"1", "/", "2"}]], " ", 
      StyleBox["G",
       FontWeight->"Bold"]}], 
     StyleBox[")",
      FontWeight->"Bold"]}]}], ",", 
   StyleBox[
    RowBox[{"  ", 
     StyleBox[" ",
      FontWeight->"Bold"]}]], 
   RowBox[{
    StyleBox["U",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       StyleBox["(",
        FontWeight->"Bold"], 
       RowBox[{
        SuperscriptBox[
         StyleBox["W",
          FontWeight->"Bold"], 
         RowBox[{"1", "/", "2"}]], " ", 
        StyleBox["G",
         FontWeight->"Bold"]}], 
       StyleBox[")",
        FontWeight->"Bold"]}], "\[Dagger]"], "=", 
     RowBox[{
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold"], "\[Dagger]"], 
      SuperscriptBox[
       StyleBox["W",
        FontWeight->"Bold"], 
       RowBox[{"1", "/", "2"}]]}]}]}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.7619079692114897`*^9, 3.761907974918037*^9}, {
  3.761908215695116*^9, 3.76190821696231*^9}, {3.761908279280464*^9, 
  3.761908301752779*^9}, {3.761908413916378*^9, 3.76190841903472*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"58dec0fb-510f-47c7-b002-0ccbda72f30e"],

Cell["Such that ", "Text",
 CellChangeTimes->{{3.7619079788290863`*^9, 3.7619079801775627`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d887c6f8-cc74-4c54-84c5-4e57728f7afa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["U",
     FontWeight->"Bold"], 
    StyleBox[" ",
     FontWeight->"Bold"], 
    SuperscriptBox[
     StyleBox["U",
      FontWeight->"Bold"], "\[Dagger]"]}], "=", 
   RowBox[{
    StyleBox["1",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["U",
       FontWeight->"Bold"], "\[Dagger]"], 
     StyleBox["U",
      FontWeight->"Bold"]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761907982937779*^9, 3.761907994567811*^9}, {
  3.761908225632834*^9, 3.761908229634859*^9}, {3.761908635095519*^9, 
  3.761908641396902*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"a86107d2-ea7d-465c-a461-93d88bc79f63"],

Cell[TextData[{
 "The matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U",
     FontWeight->"Bold"], "=", 
    RowBox[{
     SuperscriptBox[
      StyleBox["G",
       FontWeight->"Bold"], "\[Dagger]"], 
     SuperscriptBox[
      StyleBox["W",
       FontWeight->"Bold"], 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]],ExpressionUUID->
  "3ba073db-3c52-45f4-902c-f246e000ef6e"],
 " has elements:"
}], "Text",
 CellChangeTimes->{{3.7619087046344967`*^9, 3.761908738292207*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"2a74cd96-2d35-4671-aeb4-619c02c023eb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["U", 
    RowBox[{"i", ",", "\[Alpha]"}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Phi]", "i"], "\[Conjugate]"}], 
    RowBox[{"(", 
     SubscriptBox["x", "\[Alpha]"], ")"}], 
    SubsuperscriptBox["w", "\[Alpha]", 
     RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7619087142635307`*^9, 3.76190871602209*^9}, {
  3.761908752502289*^9, 3.761908785322524*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e2e7da41-b67a-415d-b56b-ca416001d100"],

Cell[TextData[{
 StyleBox["Orthogonality",
  FontWeight->"Bold"],
 " of the basis functions is expressed by:"
}], "Text",
 CellChangeTimes->{{3.761908947024971*^9, 3.761908954852539*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f1ea4282-0290-48fe-9c12-5a15f6c5b2c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      StyleBox["U",
       FontWeight->"Bold"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["U",
        FontWeight->"Bold"], "\[Dagger]"]}], ")"}], 
    RowBox[{"i", ",", "j"}]], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Phi]", "i"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubscriptBox["w", "\[Alpha]"]}]}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", ",", "j"}]], " "}]}], TraditionalForm]], "EquationNumbered",\

 CellChangeTimes->{{3.761908672042843*^9, 3.761908675771068*^9}, {
  3.761908893163396*^9, 3.76190894587868*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ed35b17a-0da9-470b-98b1-f623f8cab8bb"],

Cell[TextData[{
 "while ",
 StyleBox["completeness ",
  FontWeight->"Bold"],
 "of the basis function is expressed by:"
}], "Text",
 CellChangeTimes->{{3.761908962055339*^9, 3.761908973723352*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"c25910d5-3b6b-46fb-b62d-5bebbd78ed0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["U",
        FontWeight->"Bold"], "\[Dagger]"], 
      StyleBox["U",
       FontWeight->"Bold"]}], ")"}], 
    RowBox[{"\[Alpha]", ",", "\[Beta]"}]], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["w", "\[Alpha]"], 
         SubscriptBox["w", "\[Beta]"]}], ")"}], 
       RowBox[{"1", "/", "2"}]], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Beta]"], ")"}]}]}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761908978740584*^9, 3.761909101017585*^9}, {
  3.761909156763444*^9, 3.761909176088112*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f8f9bb44-f647-4b5a-8c48-8101a7807c3a"],

Cell[TextData[{
 "One could absorb the weights into the functions if one wished by defining a \
vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Psi]",
     FontWeight->"Bold"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     RowBox[{
      StyleBox["{",
       FontWeight->"Plain"], 
      SubscriptBox[
       StyleBox["\[Psi]",
        FontWeight->"Plain"], "\[Alpha]"], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       SqrtBox[
        SubscriptBox["w", "\[Alpha]"]], 
       RowBox[{"\[Psi]", "(", 
        SubscriptBox["x", "\[Alpha]"], ")"}]}], "}"}]}]}], TraditionalForm]],
  ExpressionUUID->"8a76f2a3-9bdc-4039-9213-6b65d40e861a"],
 "  Then:"
}], "Text",
 CellChangeTimes->{{3.7619091921521273`*^9, 3.7619092053013773`*^9}, {
  3.7619092372487392`*^9, 3.761909315216688*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"a97be746-512d-4011-8095-c506ea30c2ea"],

Cell[TextData[{
 "With this definition, the basis vectors ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["\[Phi]", 
     StyleBox["j",
      FontWeight->"Plain"]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "17c21b71-ddb0-490a-bf89-d2b486c922a3"],
 " are orthonormal and complete: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox[
      StyleBox["\[Phi]",
       FontWeight->"Bold"], "j", "\[Dagger]"], 
     SubscriptBox[
      StyleBox["\[Phi]",
       FontWeight->"Bold"], "i"]}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"j", ",", "i"}]]}], TraditionalForm]],ExpressionUUID->
  "f3180530-419e-461d-a087-1a7cd4f0dab3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "i"], 
     RowBox[{
      SubscriptBox[
       StyleBox["\[Phi]",
        FontWeight->"Bold"], "i"], " ", 
      SuperscriptBox[
       SubscriptBox[
        StyleBox["\[Phi]",
         FontWeight->"Bold"], "i"], "\[Dagger]"]}]}], "=", 
    StyleBox["1",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "787d9f25-5986-480a-93d6-414d9b6210d7"],
 ".  An arbitrary overlap is"
}], "Text",
 CellChangeTimes->{{3.761909435315411*^9, 3.761909628715301*^9}, {
  3.7619096989462547`*^9, 3.761909713373558*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"4f5f1292-c279-46aa-827e-7163877b9a0a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Phi]",
      FontWeight->"Bold"], "\[Dagger]"], 
    StyleBox["\[Psi]",
     FontWeight->"Bold"]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{"\[Phi]", "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      RowBox[{"\[Psi]", "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubscriptBox["w", "\[Alpha]"]}]}], "=", 
    TemplateBox[{"\[Phi]", "\[Psi]"},
     "BraKet"]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.7619100966408243`*^9, 3.761910145295095*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"58c4e7db-b844-4995-8115-e5a3154d43ea"],

Cell[TextData[{
 "The final equality is exact only if ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],ExpressionUUID->
  "deaa1429-1495-4144-bf39-12f3840df717"],
 " and \[Psi] are members of the basis set.  Otherwise, the quadrature is \
approximate."
}], "Text",
 CellChangeTimes->{{3.761910156650611*^9, 3.761910188373899*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"6aebb7a7-5c74-4a7f-942d-450cfe021783"],

Cell[CellGroupData[{

Cell["DVR functions", "Subsubsection",
 CellChangeTimes->{{3.7619102156015863`*^9, 3.7619102260345793`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"8fe39ba0-697a-4b42-a97f-9e3f05019bca"],

Cell["Finally, introduce the DVR functions:", "Text",
 CellChangeTimes->{{3.761910218846347*^9, 3.761910230727989*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"0be69012-5a67-4c61-a3a1-f2e1e13cbe0d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"]},
    "Ket"], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Phi]", "j"]},
      "Ket"], 
     SubscriptBox["U", 
      RowBox[{"j", ",", "\[Alpha]"}]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761910232705143*^9, 3.761910307129004*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"876e499d-c205-4e6f-ae1b-0dd4fe903821"],

Cell["Which suggests", "Text",
 CellChangeTimes->{{3.761910298272767*^9, 3.761910303452985*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"711c0807-8ff2-434a-9784-9beee6a3097e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["U", 
    RowBox[{"j", ",", "\[Alpha]"}]], "=", 
   TemplateBox[{
     SubscriptBox["\[Phi]", "j"], 
     SubscriptBox["\[Chi]", "\[Alpha]"]},
    "BraKet"]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761909210424638*^9, 3.761909233848865*^9}, {
  3.761910309048771*^9, 3.761910337601994*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"8cb4ed5d-42ad-4fc9-b6e8-9f8c657c414b"],

Cell[TextData[{
 "Or using our previous definition for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", 
     RowBox[{"i", ",", "\[Alpha]"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Phi]", "i"], "\[Conjugate]"}], 
     RowBox[{"(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], 
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{"1", "/", "2"}]]}]}], TraditionalForm]],ExpressionUUID->
  "7ce8d22e-df87-4332-9919-eda8417e2a82"],
 ","
}], "Text",
 CellChangeTimes->{{3.761910497640746*^9, 3.761910524457201*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3e13b001-da4f-49a3-be9f-a5c0e9d7a524"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"]},
    "Ket"], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Phi]", "j"]},
      "Ket"], 
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
     RowBox[{"(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], 
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{"1", "/", "2"}]]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761910363846676*^9, 3.761910383586598*^9}, {
  3.7619104405150948`*^9, 3.761910456845684*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"203bc98a-fc7d-4903-8ac6-a3e632eee828"],

Cell[TextData[{
 "Hitting from the left with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"x"},
    "Bra"], TraditionalForm]],ExpressionUUID->
  "50920fd5-4c2c-4945-afc7-e1db8f93f9aa"],
 " "
}], "Text",
 CellChangeTimes->{{3.761910527668191*^9, 3.7619105463334827`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"a725f8bc-9261-4f87-9c01-9bb4321bcee7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Chi]", "\[Alpha]"], "(", "x", ")"}], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "(", "x", ")"}], 
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
     RowBox[{"(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], 
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{"1", "/", "2"}]]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761910554997081*^9, 3.7619105754560432`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"9592d25e-0dbd-46f0-9bcb-d09c9cea810a"],

Cell[TextData[{
 "Because the DVR functions are obtained by a unitary transformation of \
orthogonal functions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"]},
     "Ket"], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"]},
       "Ket"], 
      SubscriptBox["U", 
       RowBox[{"j", ",", "\[Alpha]"}]]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.761910232705143*^9, 3.761910307129004*^9}},
  ExpressionUUID->"cd32ab6b-a8bd-43b4-87a7-ee4ed81e6346"],
 ", they themselves are orthogonal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"], 
      SubscriptBox["\[Chi]", "\[Beta]"]},
     "BraKet"], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}], TraditionalForm]],
  ExpressionUUID->"847ed977-ddea-4ba0-9c0a-537d27555844"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.761910646917968*^9, 3.76191069862921*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ab3b5e4c-c502-4c91-a567-e4228d98d850"],

Cell[TextData[{
 "Multiplying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "\[Alpha]"], "(", "x", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.761910554997081*^9, 3.7619105754560432`*^9}},
  ExpressionUUID->"bf36f1b1-aac4-455f-840e-71c6bad88180"],
 " by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["w", "\[Beta]", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "5df654b8-91cc-4a3e-9750-43e9d05052c9"],
 "  and evaluating ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    SubscriptBox["x", "\[Beta]"]}], TraditionalForm]],ExpressionUUID->
  "c3a62e1e-7d3c-4f3c-9a98-887c3efba737"],
 " reveals the following ",
 StyleBox["remarkable property:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.761910701686452*^9, 3.761910771389092*^9}, {
   3.761910805052759*^9, 3.761910809512164*^9}, {3.761910893388279*^9, 
   3.761910896135336*^9}, 3.761910969123221*^9},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"2ced67c4-e469-4d31-9811-c2c9939d5a83"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["w", "\[Beta]", 
     RowBox[{"1", "/", "2"}]], 
    RowBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"], "(", 
     SubscriptBox["x", "\[Beta]"], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Beta]"], ")"}], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubsuperscriptBox["w", "\[Beta]", 
       RowBox[{"1", "/", "2"}]], 
      SubsuperscriptBox["w", "\[Alpha]", 
       RowBox[{"1", "/", "2"}]]}]}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.76191077615653*^9, 3.7619108226583242`*^9}, {
  3.7619108805622053`*^9, 3.761910884482357*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"8a35555e-a520-4818-b67e-f3dd0c4169cb"],

Cell[TextData[{
 "This property of DVR functions is called the ",
 StyleBox["discrete \[Delta] property:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.761910971716614*^9, 3.7619109866443243`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"43e89c70-9a61-49e3-a4f5-3389ac302473"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Chi]", "\[Alpha]"], "(", 
    SubscriptBox["x", "\[Beta]"], ")"}], "=", 
   RowBox[{
    SubscriptBox["\[Delta]", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
    SubsuperscriptBox["w", "\[Alpha]", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761910992896945*^9, 3.761911004036776*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"4e7a2e48-17ef-49d0-8ab2-e399e962bc8b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"], 
     SubscriptBox["\[Chi]", "\[Beta]"]},
    "BraKet"], "=", 
   SubscriptBox["\[Delta]", "\[Alpha]\[Beta]"]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761913047985683*^9, 3.761913073777946*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"fb1b6987-6105-4697-a7d6-18ef143e83f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "ca9d63d6-9398-4eb1-a58c-754269d059e1"],
 " is a \[OpenCurlyDoubleQuote]normalized projection\[CloseCurlyDoubleQuote] \
of the position eigenstate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     SubscriptBox["x", "\[Alpha]"]},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "5f555dc0-1ad7-41ea-bbcb-d5dc75908c75"],
 "."
}], "Subsubsection",
 CellChangeTimes->{{3.761913136644108*^9, 3.761913168786772*^9}, {
  3.761914076278528*^9, 3.7619141109683657`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e6dbcd5b-adc4-4df5-8084-f7ecb55a9cc3"],

Cell[TextData[{
 "The delta-function picking off ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "2d248e9c-22bd-468c-8439-13629d5102ef"],
 " is:"
}], "Text",
 CellChangeTimes->{{3.761913181062509*^9, 3.761913195266204*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"03bc3494-be11-43cb-b828-03ad256cfa1a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Delta]", "(", 
    RowBox[{"x", "-", 
     SubscriptBox["x", "\[Alpha]"]}], ")"}], "=", 
   TemplateBox[{"x", 
     SubscriptBox["x", "\[Alpha]"]},
    "BraKet"]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761913196978956*^9, 3.7619132042412357`*^9}, {
   3.761913282887817*^9, 3.761913297741625*^9}, 3.7619134577244663`*^9},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"199e61f7-c408-421d-abd9-774dee9af122"],

Cell["The projection operator onto the finite basis is:", "Text",
 CellChangeTimes->{{3.761913207837184*^9, 3.7619132158252*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"bde2c270-ba17-40f7-98ea-ff61e887c48e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["P", "^"], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}]], "n"], 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Phi]", "j"]},
      "Ket"], 
     TemplateBox[{
       SubscriptBox["\[Phi]", "j"]},
      "Bra"]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761913218064891*^9, 3.7619132447760487`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"7a2a28a0-2303-4591-920c-b689ce78596b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["P", "^"], 
    TemplateBox[{
      SubscriptBox["x", "\[Alpha]"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"]},
       "Ket"], 
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"], 
        SubscriptBox["x", "\[Alpha]"]},
       "BraKet"]}]}], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"]},
       "Ket"], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761913402085458*^9, 3.761913521101956*^9}, {
  3.761914242185171*^9, 3.761914258307654*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"56440c17-7b89-419c-9488-d0c660d4785b"],

Cell["Therefore,", "Text",
 CellChangeTimes->{{3.761913537200323*^9, 3.761913538669733*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"fed8c897-fe5b-402d-b692-afb26e320f93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     OverscriptBox["P", "^"], 
     TemplateBox[{
       SubscriptBox["x", "\[Alpha]"]},
      "Ket"]}], 
    RowBox[{"\[LeftDoubleBracket]", 
     RowBox[{
      OverscriptBox["P", "^"], 
      TemplateBox[{
        SubscriptBox["x", "\[Alpha]"]},
       "Ket"]}], "\[RightDoubleBracket]"}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      OverscriptBox[
       UnderscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}]], "n"], 
      RowBox[{
       TemplateBox[{
         SubscriptBox["\[Phi]", "j"]},
        "Ket"], 
       RowBox[{
        SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
       RowBox[{"(", 
        SubscriptBox["x", "\[Alpha]"], ")"}]}]}], 
     SqrtBox[
      RowBox[{
       UnderscriptBox["\[Sum]", "j"], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Phi]", "j"], "(", 
         SubscriptBox["x", "\[Alpha]"], ")"}], 
        RowBox[{
         SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
        RowBox[{"(", 
         SubscriptBox["x", "\[Alpha]"], ")"}]}]}]]], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       OverscriptBox[
        UnderscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}]], "n"], 
       RowBox[{
        TemplateBox[{
          SubscriptBox["\[Phi]", "j"]},
         "Ket"], 
        RowBox[{
         SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
        RowBox[{"(", 
         SubscriptBox["x", "\[Alpha]"], ")"}]}]}], 
      SqrtBox[
       RowBox[{"1", "/", 
        SubscriptBox["w", "\[Alpha]"]}]]], "=", 
     RowBox[{
      RowBox[{
       OverscriptBox[
        UnderscriptBox["\[Sum]", 
         RowBox[{"j", "=", "1"}]], "n"], 
       RowBox[{
        TemplateBox[{
          SubscriptBox["\[Phi]", "j"]},
         "Ket"], 
        RowBox[{
         SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
        RowBox[{"(", 
         SubscriptBox["x", "\[Alpha]"], ")"}], 
        SqrtBox[
         SubscriptBox["w", "\[Alpha]"]]}]}], "=", 
      TemplateBox[{
        SubscriptBox["\[Chi]", "\[Alpha]"]},
       "Ket"]}]}]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761913546745268*^9, 3.761913560883727*^9}, {
  3.7619136301879187`*^9, 3.761913762412836*^9}, {3.761913819795845*^9, 
  3.761913825133593*^9}, {3.7619139287162523`*^9, 3.761913939542583*^9}, {
  3.761914027057768*^9, 3.7619140576894836`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"94c29714-8f3f-44f8-8cb8-48275d514b4d"],

Cell[TextData[{
 "One can think of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"x", 
      SubscriptBox["\[Chi]", "\[Alpha]"]},
     "BraKet"], "=", 
    RowBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"], "(", "x", ")"}]}], TraditionalForm]],
  ExpressionUUID->"30131ec0-a041-43dd-bc22-7bd63f9f9b29"],
 " as the best approximation to the delta function we can have in a finite \
basis. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"]},
     "Ket"], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"]},
       "Ket"], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubsuperscriptBox["w", "\[Alpha]", 
       RowBox[{"1", "/", "2"}]]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.761910363846676*^9, 3.761910383586598*^9}, {
   3.7619104405150948`*^9, 3.761910456845684*^9}},ExpressionUUID->
  "a253a4df-51c3-447b-a687-b900a6873e10"],
 " is like a unit position vector."
}], "Text",
 CellChangeTimes->{{3.7619141662839813`*^9, 3.761914199092785*^9}, 
   3.761914239284306*^9, {3.761914288060053*^9, 3.761914360379016*^9}, {
   3.7619145094513807`*^9, 3.761914545946705*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"2726aac6-d9bd-45f3-a188-3296479e00ae"],

Cell["Look, for example, at ", "Text",
 CellChangeTimes->{{3.761914361853001*^9, 3.761914369890382*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"bcb6ada2-b993-4660-ba73-30f864d5a6d3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"], "\[Psi]"},
    "BraKet"], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      SubsuperscriptBox["w", "\[Alpha]", 
       RowBox[{"1", "/", "2"}]], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"], "\[Psi]"},
       "BraKet"]}]}], "=", 
    RowBox[{
     RowBox[{
      OverscriptBox[
       UnderscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}]], "n"], 
      RowBox[{
       SubsuperscriptBox["w", "\[Alpha]", 
        RowBox[{"1", "/", "2"}]], 
       RowBox[{
        SubscriptBox["\[Phi]", "j"], "(", 
        SubscriptBox["x", "\[Alpha]"], ")"}], 
       TemplateBox[{
         SubscriptBox["\[Phi]", "j"]},
        "Bra"], 
       RowBox[{
        OverscriptBox[
         UnderscriptBox["\[Sum]", 
          RowBox[{"k", "=", "1"}]], "\[Infinity]"], 
        RowBox[{
         SubscriptBox["a", "k"], 
         TemplateBox[{
           SubscriptBox["\[Phi]", "k"]},
          "Ket"]}]}]}]}], "=", 
     RowBox[{
      RowBox[{
       OverscriptBox[
        UnderscriptBox["\[Sum]", 
         RowBox[{"k", "=", "1"}]], "\[Infinity]"], 
       RowBox[{
        OverscriptBox[
         UnderscriptBox["\[Sum]", 
          RowBox[{"j", "=", "1"}]], "n"], 
        RowBox[{
         SubsuperscriptBox["w", "\[Alpha]", 
          RowBox[{"1", "/", "2"}]], 
         RowBox[{
          SubscriptBox["\[Phi]", "j"], "(", 
          SubscriptBox["x", "\[Alpha]"], ")"}], 
         SubscriptBox["a", "k"], 
         SubscriptBox["\[Delta]", 
          RowBox[{"j", ",", "k"}]]}]}]}], "=", 
      RowBox[{
       RowBox[{
        OverscriptBox[
         UnderscriptBox["\[Sum]", 
          RowBox[{"k", "=", "1"}]], "n"], 
        RowBox[{
         SubsuperscriptBox["w", "\[Alpha]", 
          RowBox[{"1", "/", "2"}]], 
         RowBox[{
          SubscriptBox["\[Phi]", "k"], "(", 
          SubscriptBox["x", "\[Alpha]"], ")"}], 
         SubscriptBox["a", "k"]}]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubsuperscriptBox["w", "\[Alpha]", 
           RowBox[{"1", "/", "2"}]], "[", 
          RowBox[{
           OverscriptBox["P", "^"], "\[Psi]"}], "]"}], 
         RowBox[{"(", 
          SubscriptBox["x", "\[Alpha]"], ")"}]}], "=", 
        SubscriptBox["\[Psi]", "\[Alpha]"]}]}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761914378219487*^9, 3.761914471319578*^9}, {
   3.7619145765976562`*^9, 3.761914592031193*^9}, {3.761914705971025*^9, 
   3.761914735356165*^9}, {3.7619193499923697`*^9, 3.761919446989687*^9}, {
   3.7619194821356363`*^9, 3.761919529407527*^9}, 3.761919604571966*^9, {
   3.761919665739623*^9, 3.761919684561907*^9}, {3.761919725466207*^9, 
   3.761919746167284*^9}, {3.761920261679864*^9, 3.761920287820175*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"20af3f7f-83d8-4530-8493-f8af18656aa9"],

Cell[TextData[{
 "The final equality ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"], "\[Psi]"},
     "BraKet"], "=", 
    SubscriptBox["\[Psi]", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "65ead11e-5db5-439e-bbcf-0c98898c087f"],
 " is only exact if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["P", "^"], "\[Psi]"}], "=", "\[Psi]"}], TraditionalForm]],
  ExpressionUUID->"54ff8005-7e71-48c9-8128-0d8c93404a08"],
 " (i.e. if \[Psi] is in the basis).  "
}], "Text",
 CellChangeTimes->{{3.7619149907360487`*^9, 3.761915005615737*^9}, {
  3.761920114744841*^9, 3.761920120255991*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"42839769-301b-4708-bcf5-6aa01ab74ead"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Psi]", "\[Alpha]"], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{"1", "/", "2"}]], 
     RowBox[{"\[Psi]", "(", 
      SubscriptBox["x", "\[Alpha]"], ")"}]}], "=", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["\[Chi]", "\[Alpha]"], "\[Psi]"},
      "BraKet"], "+", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["w", "\[Alpha]", 
        RowBox[{"1", "/", "2"}]], "[", 
       RowBox[{
        OverscriptBox["Q", "^"], "\[Psi]"}], "]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.761920108978222*^9, 3.761920141236801*^9}, {
  3.761920178782793*^9, 3.761920205464355*^9}, {3.761920241385704*^9, 
  3.761920254891958*^9}, {3.761920297650424*^9, 3.761920300722808*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"a5cd2b2c-d076-4206-a93f-ea32692c9574"],

Cell[TextData[{
 "The error that is introduced by the truncation to a finite basis is usually \
acceptable because one gains a very efficient method for calculating matrix \
elements.  The potential matrix is diagonal in the DVR basis: (recall ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"]},
     "Ket"], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"j", "=", "1"}]], "n"], 
     RowBox[{
      TemplateBox[{
        SubscriptBox["\[Phi]", "j"]},
       "Ket"], 
      SubscriptBox["U", 
       RowBox[{"j", ",", "\[Alpha]"}]]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.761910232705143*^9, 3.761910307129004*^9}},
  ExpressionUUID->"3629ec07-c8d7-44c9-afb1-3aa33a145b99"],
 ")"
}], "Text",
 CellChangeTimes->{{3.761919832641733*^9, 3.76191991765464*^9}, {
  3.761920495248528*^9, 3.761920498770514*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"738f6aa0-6862-497a-a0a9-6d42b3afd760"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"]},
     "Bra"], "V", 
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Beta]"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"\[Integral]", 
     RowBox[{
      RowBox[{"\[DifferentialD]", "x"}], " ", 
      RowBox[{
       SubscriptBox["\[Chi]", "\[Alpha]"], "(", "x", ")"}], 
      RowBox[{"V", "(", "x", ")"}], 
      RowBox[{
       SubscriptBox["\[Chi]", "\[Beta]"], "(", "x", ")"}]}]}], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", "\[Gamma]"], 
      RowBox[{
       SubscriptBox["w", "\[Gamma]"], 
       RowBox[{
        SubscriptBox["\[Chi]", "\[Alpha]"], "(", 
        SubscriptBox["x", "\[Gamma]"], ")"}], 
       RowBox[{"V", "(", 
        SubscriptBox["x", "\[Gamma]"], ")"}], 
       RowBox[{
        SubscriptBox["\[Chi]", "\[Beta]"], "(", 
        SubscriptBox["x", "\[Gamma]"], ")"}]}]}], "=", 
     RowBox[{
      SubscriptBox["\[Delta]", 
       RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
      RowBox[{"V", "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}]}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.76191992774343*^9, 3.7619199542766237`*^9}, {
   3.7619203564849787`*^9, 3.761920446449533*^9}, {3.7619204829121923`*^9, 
   3.76192053706979*^9}, {3.7619207026748657`*^9, 3.761920749806046*^9}, {
   3.761921105846884*^9, 3.761921107358886*^9}, {3.761921144645567*^9, 
   3.76192117944855*^9}, 3.7619212506562443`*^9, {3.761926233658268*^9, 
   3.761926300775288*^9}, {3.7619263621675043`*^9, 3.7619264166544847`*^9}, 
   3.761926465844534*^9, {3.761926573897728*^9, 3.761926585503162*^9}, {
   3.761926702883642*^9, 3.761926738523583*^9}, {3.761926784716851*^9, 
   3.761926832751618*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"f616e8aa-7151-4596-b60b-477243b0b331"],

Cell[TextData[{
 "This is exact if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", 
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Beta]"]},
     "Ket"]}], TraditionalForm]],ExpressionUUID->
  "eed95490-2c35-43c9-ae60-a03549e415e6"],
 " is a state exactly described within the basis."
}], "Text",
 CellChangeTimes->{{3.761926899898741*^9, 3.761926909917347*^9}, {
  3.761926993766656*^9, 3.7619270044923887`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ae09d487-49b1-4aa4-9c6d-adcfaf117434"],

Cell[TextData[StyleBox["The following 5 statements are equivalent:",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.761927032236788*^9, 3.7619270406115503`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d6c75f6f-7810-457d-bac0-2b18ee4be5ae"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G",
     FontWeight->"Bold"], " ", 
    SuperscriptBox[
     StyleBox["G",
      FontWeight->"Bold"], "\[Dagger]"]}], TraditionalForm]],ExpressionUUID->
  "7b3f9fa1-c301-4c2d-a202-bf9bce1c94d0"],
 " is diagonal, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", 
     RowBox[{"\[Alpha]", ",", "j"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Phi]", "j"], "(", 
      SubscriptBox["x", "\[Alpha]"], ")"}], "=", 
     TemplateBox[{
       SubscriptBox["x", "\[Alpha]"], 
       SubscriptBox["\[Phi]", "j"]},
      "BraKet"]}]}], TraditionalForm]],ExpressionUUID->
  "ad1767ef-e051-4455-9810-457ad5c3ca46"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7619270548077297`*^9, 3.761927137852778*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3c7a4d93-7b47-4076-8ca7-0644b0dde06e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", 
     RowBox[{"j", ",", "\[Alpha]"}]], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["w", "\[Alpha]", 
       RowBox[{"1", "/", "2"}]], 
      RowBox[{
       SubsuperscriptBox["\[Phi]", "j", "*"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}]}], "=", 
     RowBox[{
      SubsuperscriptBox["w", "\[Alpha]", 
       RowBox[{"1", "/", "2"}]], 
      SubsuperscriptBox["G", 
       RowBox[{"j", ",", "\[Alpha]"}], "*"]}]}]}], TraditionalForm]],
  ExpressionUUID->"08507c6b-d023-4b90-9061-da6a69a66ea4"],
 " is ",
 StyleBox["unitary.",
  FontSlant->"Italic"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7619270548077297`*^9, 3.761927306141117*^9}, {
  3.761958157387038*^9, 3.761958158992474*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"5c664876-c7d7-4237-943d-2dfb70256854"],

Cell[TextData[{
 "Discrete orthogonality:  , ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Alpha]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Phi]", "i"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      SubscriptBox["w", "\[Alpha]"]}]}], "=", 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", ",", "j"}]], " "}], TraditionalForm]],
  CellChangeTimes->{{3.761908672042843*^9, 3.761908675771068*^9}, {
   3.761908893163396*^9, 3.76190894587868*^9}},ExpressionUUID->
  "b18fa8f2-7250-431f-96ab-962214568163"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7619270548077297`*^9, 3.761927318969688*^9}, {
  3.761927359553109*^9, 3.761927363906808*^9}, {3.7619274197465076`*^9, 
  3.7619274328069057`*^9}, {3.761927489986951*^9, 3.7619274954358797`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"e469853a-4412-46aa-9719-e11be0a006af"],

Cell[TextData[{
 "Discrete completeness: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "(", 
       SubscriptBox["x", "\[Alpha]"], ")"}], 
      RowBox[{
       SubscriptBox["\[Phi]", "j"], "\[Conjugate]"}], 
      RowBox[{"(", 
       SubscriptBox["x", "\[Beta]"], ")"}]}]}], "=", 
    RowBox[{
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{"-", "1"}]], 
     SubscriptBox["\[Delta]", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}]]}]}], TraditionalForm]],
  ExpressionUUID->"ae219265-6661-4d33-b32f-1db00f0ebf62"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7619270548077297`*^9, 3.761927318969688*^9}, {
  3.761927359553109*^9, 3.761927395084585*^9}, {3.761927496521557*^9, 
  3.76192751801965*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"51a63e7a-e3f1-4fad-9d04-f97a49a91924"],

Cell[TextData[{
 "Discrete ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]],ExpressionUUID->
  "a75077ac-52bc-4967-835e-7d584fb2a448"],
 " property: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Chi]", "\[Alpha]"], "(", 
     SubscriptBox["x", "\[Beta]"], ")"}], "=", 
    RowBox[{
     SubscriptBox["\[Delta]", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}]], 
     SubsuperscriptBox["w", "\[Alpha]", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]]}]}], TraditionalForm]],
  CellChangeTimes->{{3.761910992896945*^9, 3.761911004036776*^9}},
  ExpressionUUID->"c3f1a12b-e4c0-43e2-be72-334b0bd84a4a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{
      SubscriptBox["\[Chi]", "\[Alpha]"], 
      SubscriptBox["\[Chi]", "\[Beta]"]},
     "BraKet"], "=", 
    SubscriptBox["\[Delta]", "\[Alpha]\[Beta]"]}], TraditionalForm]],
  CellChangeTimes->{{3.761913047985683*^9, 3.761913073777946*^9}},
  ExpressionUUID->"f23409d8-a424-4476-8f3a-582a843d8040"],
 "."
}], "Item1Numbered",
 CellChangeTimes->{{3.7619270548077297`*^9, 3.761927318969688*^9}, {
  3.761927359553109*^9, 3.761927395084585*^9}, {3.761927496521557*^9, 
  3.761927564514255*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"26beca72-d1a7-4e49-8198-bcd21bde2fc3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["DVR with Gauss-Lobatto quadrature", "Subsection",
 CellChangeTimes->{{3.762007982478735*^9, 3.762007992756712*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"245d72f5-d2ff-44a1-8fb0-57bcaa16549f"],

Cell[TextData[{
 "Here, I\[CloseCurlyQuote]ll work through the properties of the Lobatto \
shape functions from D. E. Manolopoulos and R. E. Wyatt Chem. Phys. Lett. ",
 StyleBox["152",
  FontWeight->"Bold"],
 " 23 (1988).  These can be used to formulate a DVR with some convenient \
properties."
}], "Text",
 CellChangeTimes->{{3.762007994365142*^9, 3.762008128486454*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"94f1981e-2081-4872-8117-f7b86fcdd2c4"],

Cell["The M-point Lobatto quadrature rule:", "Text",
 CellChangeTimes->{{3.762008165095149*^9, 3.762008199968935*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"4c27ac7b-0d46-4955-8ac5-588f3de7ee74"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", "a", "b"], 
    RowBox[{
     RowBox[{"f", "(", "R", ")"}], 
     RowBox[{"\[DifferentialD]", "R"}]}]}], "\[TildeTilde]", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}]], 
     RowBox[{"M", "+", "1"}]], 
    RowBox[{
     SubscriptBox["w", "k"], 
     RowBox[{"f", "(", 
      SubscriptBox["R", "k"], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.762008177329588*^9, 3.762008283870071*^9}, {
  3.7620367714738417`*^9, 3.7620367735901117`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"ec6a59bc-b19c-4db4-94ad-609199248f55"],

Cell[TextData[{
 "Here, let (different from Manolopoulos and Wyatt) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "0"], "=", "a"}], TraditionalForm]],ExpressionUUID->
  "25d7770f-b97a-4afd-bbf1-5c0b996f267b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"M", "+", "1"}]], "=", "b"}], TraditionalForm]],ExpressionUUID->
  "74e80114-123a-46b4-84a4-cf11d8de77bb"],
 ".  The remaining nodes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "k"], TraditionalForm]],ExpressionUUID->
  "cad8260d-916c-4c27-9f8c-38d1c83f2719"],
 " and weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "k"], TraditionalForm]],ExpressionUUID->
  "e533bb1c-d0f4-4fe4-a37d-1081643fe779"],
 " are chosen so as to make the equation above exact for polynomials up to \
degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "M"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "34ecb76c-4207-4af4-b764-367cb148b23e"],
 ".  For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "69c1dfa3-4b73-4381-ba24-dc6a922332ab"],
 ", this equation reduces to the trapezoid rule, while for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "0ce0c287-2dc3-4d28-a43a-4381232757b3"],
 ", it reduces to Simpson\[CloseCurlyQuote]s rule. We\[CloseCurlyQuote]ll \
discuss how to generate these nodes and weights with Mathematica later. "
}], "Text",
 CellChangeTimes->{{3.76200828600025*^9, 3.762008421405158*^9}, {
  3.762008465453402*^9, 3.762008503783567*^9}, {3.76203678345884*^9, 
  3.7620368256682*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"d8dfc888-1b9b-4aeb-9b72-7bf6c9db2c07"],

Cell["\<\
The Lobatto shape functions are defined as the \
\[OpenCurlyDoubleQuote]Lagrangian interpolating polynomials\
\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.76200850920919*^9, 3.762008532717718*^9}, {
  3.762008591463722*^9, 3.762008592574114*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"5f2ea998-70e8-4f8f-8bac-88d0c7267ad9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Chi]", "i"], "(", "R", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["w", "i", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     RowBox[{
      OverscriptBox[
       UnderscriptBox["\[Product]", 
        RowBox[{
         RowBox[{"j", "\[NotEqual]", "i"}], ",", " ", 
         RowBox[{"j", "=", "0"}]}]], 
       RowBox[{"M", "+", "1"}]], 
      FractionBox[
       RowBox[{"R", "-", 
        SubscriptBox["R", "j"]}], 
       RowBox[{
        SubscriptBox["R", "i"], "-", 
        SubscriptBox["R", "j"]}]]}]}]}], ",", " ", 
   RowBox[{"i", "=", "0"}], ",", "1", ",", "...", ",", 
   RowBox[{"M", "+", "1"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.762008596895911*^9, 3.762008725278974*^9}, {
  3.762009258307585*^9, 3.762009272306983*^9}, {3.762037153778034*^9, 
  3.7620371602614527`*^9}, {3.762037305702058*^9, 3.762037307294724*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"3dce4a69-5851-45d2-b4aa-23432728b770"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "j"], ",", 
    SubscriptBox["R", "i"]}], TraditionalForm]],ExpressionUUID->
  "bbee02c7-9a97-43a1-8bad-7637141fdeb7"],
 " are the ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "b7bef06c-9d4a-4316-8756-e4a61e10d618"],
 "-point Lobatto quadrature nodes.  Note that these basis functions qualify \
as a DVR basis because:"
}], "Text",
 CellChangeTimes->{{3.762008728009542*^9, 3.762008810091486*^9}, {
  3.7620092821476793`*^9, 3.762009285546639*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"9230f853-3f26-45e3-ac68-98a0f34f398e"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Chi]", "i"], "(", 
     SubscriptBox["R", "j"], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["w", "i", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     SubscriptBox["\[Delta]", 
      RowBox[{"j", ",", "i"}]]}]}], TraditionalForm]],ExpressionUUID->
  "1c5d3306-c901-4500-96b6-e38c3428a86d"],
 ",  To see this clearly, look, for example, at the case for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "1837fa14-9490-4301-9eb0-7914668675c5"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Chi]", "1"], "(", "R", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["w", "1", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}]], 
      FractionBox[
       RowBox[{"R", "-", 
        SubscriptBox["R", "0"]}], 
       RowBox[{
        SubscriptBox["R", "1"], "-", 
        SubscriptBox["R", "0"]}]], 
      FractionBox[
       RowBox[{"R", "-", 
        SubscriptBox["R", "2"]}], 
       RowBox[{
        SubscriptBox["R", "1"], "-", 
        SubscriptBox["R", "2"]}]]}], "=", 
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {"0", 
            RowBox[{
             RowBox[{"R", "=", 
              SubscriptBox["R", "0"]}], ",", 
             SubscriptBox["R", "2"]}]},
           {
            SubsuperscriptBox["w", "1", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "2"}]], 
            RowBox[{"R", "=", 
             SubscriptBox["R", "1"]}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          
          GridBoxAlignment->{
           "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
            "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
          
          GridBoxItemSize->{
           "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
            "Rows" -> {{1.}}, "RowsIndexed" -> {}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.84]}, 
              Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}, "RowsIndexed" -> {}},
          Selectable->True]}
       },
       GridBoxAlignment->{
        "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}},
          "RowsIndexed" -> {}},
       GridBoxItemSize->{
        "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
         "RowsIndexed" -> {}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.35]}, 
           Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}, "RowsIndexed" -> {}}],
      "Piecewise",
      DeleteWithContents->True,
      Editable->False,
      SelectWithContents->True,
      Selectable->False]}]}], TraditionalForm]],ExpressionUUID->
  "f3f547e6-1b7b-4f53-b76d-822f18dac1f1"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7620088235227957`*^9, 3.762008829703274*^9}, {
  3.762008863771824*^9, 3.762008883297876*^9}, {3.762008972332232*^9, 
  3.762009012185944*^9}, {3.762009051887938*^9, 3.762009243793359*^9}, {
  3.762037315051412*^9, 3.7620373570670652`*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"c4933ede-9574-4471-8abb-d33a09c04767"],

Cell[TextData[{
 "The functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     SubscriptBox["w", "i"]], 
    RowBox[{
     SubscriptBox["\[Chi]", "i"], "(", "R", ")"}]}], TraditionalForm]],
  ExpressionUUID->"01491116-ea9d-46d5-9278-7a5d3b0d329d"],
 " form a complete polynomial basis of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "4a5a972c-d9f8-4b8e-b5e0-d83814c2e377"],
 ", because any polynomial of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", " ", 
    RowBox[{"M", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "ff95682e-d760-437b-953f-99eeb416b443"],
 " can be expressed as the linear combination: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", 
      RowBox[{"M", "+", "1"}]], "(", "R", ")"}], "=", 
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}]], 
      RowBox[{"M", "+", "1"}]], 
     RowBox[{
      SqrtBox[
       SubscriptBox["w", "i"]], 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", "R", ")"}], 
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"M", "+", "1"}]], "(", 
       SubscriptBox["R", "i"], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "5962ef14-4081-45b6-8d13-3d61817b6bcb"],
 ".  Specializing this to the case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"M", "+", "1"}]], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "263916cd-c74b-4641-af53-9c21fb54e94d"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}]], 
      RowBox[{"M", "+", "1"}]], 
     RowBox[{
      SubscriptBox["u", "i"], "(", "R", ")"}]}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"643dff46-6184-45fe-bfe1-fce07e8ee3fc"],
 ".  Testing with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "2"], "(", "R", ")"}], "=", 
    RowBox[{"1", "+", "R", "+", 
     SuperscriptBox["R", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "1b3773c7-7947-481c-80cd-cf3d743e79f0"],
 ":\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "2"], "(", "R", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "1"]}], 
        RowBox[{
         SubscriptBox["R", "0"], "-", 
         SubscriptBox["R", "1"]}]], 
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "2"]}], 
        RowBox[{
         SubscriptBox["R", "0"], "-", 
         SubscriptBox["R", "2"]}]], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["R", "0"], "+", 
         SuperscriptBox[
          SubscriptBox["R", "0"], "2"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "0"]}], 
        RowBox[{
         SubscriptBox["R", "1"], "-", 
         SubscriptBox["R", "0"]}]], 
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "2"]}], 
        RowBox[{
         SubscriptBox["R", "1"], "-", 
         SubscriptBox["R", "2"]}]], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["R", "1"], "+", 
         SuperscriptBox[
          SubscriptBox["R", "1"], "2"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "0"]}], 
        RowBox[{
         SubscriptBox["R", "2"], "-", 
         SubscriptBox["R", "0"]}]], 
       FractionBox[
        RowBox[{"R", "-", 
         SubscriptBox["R", "1"]}], 
        RowBox[{
         SubscriptBox["R", "2"], "-", 
         SubscriptBox["R", "1"]}]], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["R", "2"], "+", 
         SuperscriptBox[
          SubscriptBox["R", "2"], "2"]}], ")"}]}]}], "=", 
     RowBox[{"1", "+", "R", "+", 
      SuperscriptBox["R", "2"]}]}]}], TraditionalForm]],
  CellChangeTimes->{{3.762010015095292*^9, 3.7620101721295567`*^9}},
  ExpressionUUID->"a812557c-e801-4372-b296-953bf4e5dd8e"]
}], "Item1Numbered",
 CellChangeTimes->{{3.7620088235227957`*^9, 3.762008829703274*^9}, {
  3.762008863771824*^9, 3.762008883297876*^9}, {3.762008972332232*^9, 
  3.762009012185944*^9}, {3.762009051887938*^9, 3.762009251963601*^9}, {
  3.762009292041953*^9, 3.762009395825913*^9}, {3.762009984690125*^9, 
  3.762010010814315*^9}, {3.7620101202427387`*^9, 3.762010122554927*^9}, {
  3.762010330413232*^9, 3.7620104710864153`*^9}, {3.762037390511889*^9, 
  3.762037413847184*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"21b64a5c-13f8-4416-b97c-c1ee0af30a04"],

Cell[TextData[{
 "Differentiating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "i"], "(", "R", ")"}], TraditionalForm]],
  ExpressionUUID->"dec06ba1-7aae-4f81-96b6-33be324cb7ac"],
 " gives: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", "R", ")"}]}], 
     RowBox[{"\[DifferentialD]", "R"}]], "=", 
    RowBox[{
     SubsuperscriptBox["w", "i", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"k", "\[NotEqual]", "i"}]], 
      RowBox[{
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{
          SubscriptBox["R", "i"], "-", 
          SubscriptBox["R", "k"]}]], ")"}], 
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Product]", 
          RowBox[{
           RowBox[{"j", "\[NotEqual]", "i"}], ",", "k"}]], 
         FractionBox[
          RowBox[{"R", "-", 
           SubscriptBox["R", "j"]}], 
          RowBox[{
           SubscriptBox["R", "i"], "-", 
           SubscriptBox["R", "j"]}]]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"5490ef3d-30f6-45be-82c5-ba8755c56417"],
 ".  Evaluating at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    SubscriptBox["R", "i"]}], TraditionalForm]],ExpressionUUID->
  "0537875b-bc92-4409-a305-d2efab3a1a4a"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", 
       SubscriptBox["R", "i"], ")"}]}], 
     RowBox[{"\[DifferentialD]", "R"}]], "=", 
    RowBox[{
     SubsuperscriptBox["w", "i", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"k", "\[NotEqual]", "i"}]], 
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{
         SubscriptBox["R", "i"], "-", 
         SubscriptBox["R", "k"]}]], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"1a627d99-8189-4240-beda-142c3f238da6"],
 " while evaluating at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    SubscriptBox["R", "l"]}], TraditionalForm]],ExpressionUUID->
  "46124544-0dc5-4caa-9938-43ac6767541e"],
 " gives: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", 
       SubscriptBox["R", "l"], ")"}]}], 
     RowBox[{"\[DifferentialD]", "R"}]], "=", 
    RowBox[{
     SubsuperscriptBox["w", "i", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"k", "\[NotEqual]", "i"}]], 
      RowBox[{
       RowBox[{"(", 
        FractionBox["1", 
         RowBox[{
          SubscriptBox["R", "i"], "-", 
          SubscriptBox["R", "k"]}]], ")"}], 
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Product]", 
          RowBox[{
           RowBox[{"j", "\[NotEqual]", "i"}], ",", "k"}]], 
         FractionBox[
          RowBox[{
           SubscriptBox["R", "l"], "-", 
           SubscriptBox["R", "j"]}], 
          RowBox[{
           SubscriptBox["R", "i"], "-", 
           SubscriptBox["R", "j"]}]]}], ")"}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f3392dbd-b98c-41cb-a44e-d9b67711109e"],
 "."
}], "Item1Numbered",
 CellChangeTimes->{{3.7620088235227957`*^9, 3.762008829703274*^9}, {
  3.762008863771824*^9, 3.762008883297876*^9}, {3.762008972332232*^9, 
  3.762009012185944*^9}, {3.762009051887938*^9, 3.762009251963601*^9}, {
  3.762009292041953*^9, 3.762009395825913*^9}, {3.762009984690125*^9, 
  3.762010010814315*^9}, {3.7620101202427387`*^9, 3.762010122554927*^9}, {
  3.762010330413232*^9, 3.762010431220471*^9}, {3.762010564161125*^9, 
  3.76201060359896*^9}, {3.76201064262075*^9, 3.762010735799502*^9}, {
  3.762010781954269*^9, 3.7620108353315983`*^9}, {3.762010868853477*^9, 
  3.762010963650329*^9}, {3.7620111631624327`*^9, 3.7620111829846087`*^9}, {
  3.762011583514689*^9, 3.762011588852275*^9}, {3.762037445791423*^9, 
  3.76203752169394*^9}, {3.803177136506754*^9, 3.803177143410952*^9}, {
  3.8032042656052427`*^9, 3.803204265890417*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"5c25555d-0364-4c15-93e3-e77a91783063"],

Cell[TextData[{
 "For the purpose of numerical calculations, the equations in 3. can be \
streamlined to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", 
       SubscriptBox["R", "i"], ")"}]}], 
     RowBox[{"\[DifferentialD]", "R"}]], "=", 
    FractionBox[
     RowBox[{
      SubscriptBox["\[Delta]", 
       RowBox[{"i", ",", "0"}]], "-", 
      SubscriptBox["\[Delta]", 
       RowBox[{"i", ",", 
        RowBox[{"M", "+", "1"}]}]]}], 
     RowBox[{"2", 
      SubsuperscriptBox["w", "i", 
       RowBox[{"3", "/", "2"}]]}]]}], TraditionalForm]],ExpressionUUID->
  "cfde43b6-a0e7-4d17-b74e-475ba9513ec7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["\[Chi]", "i"], "(", 
       SubscriptBox["R", "j"], ")"}]}], 
     RowBox[{"\[DifferentialD]", "R"}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       FractionBox[
        SubscriptBox["w", "i"], 
        SubscriptBox["w", "j"]]]}], 
     FractionBox[
      RowBox[{"\[DifferentialD]", 
       RowBox[{
        SubscriptBox["\[Chi]", "j"], "(", 
        SubscriptBox["R", "i"], ")"}]}], 
      RowBox[{"\[DifferentialD]", "R"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"for", " ", "j"}], "\[NotEqual]", "i"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"a538de48-d144-48a7-bd88-6e94c5488954"],
 ".  Manalopolous and Wyatt claim that these equations can be proven by \
integrating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Chi]", "i"], "'"}], 
     RowBox[{"(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[Chi]", "j"], "(", "R", ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Chi]", "i"], "(", "R", ")"}], 
     RowBox[{
      SubscriptBox["\[Chi]", "j"], "'"}], 
     RowBox[{"(", "R", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "11bba029-770b-468c-9af2-460c73667ad6"],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{
     RowBox[{"a", " ", "to", " ", "R"}], "=", "b"}]}], TraditionalForm]],
  ExpressionUUID->"f2c987b1-699c-4dc1-aae7-d0836ce2cd1a"],
 " both formally and using the quadrature rule.  I won\[CloseCurlyQuote]t go \
through that here."
}], "Item1Numbered",
 CellChangeTimes->{{3.7620088235227957`*^9, 3.762008829703274*^9}, {
  3.762008863771824*^9, 3.762008883297876*^9}, {3.762008972332232*^9, 
  3.762009012185944*^9}, {3.762009051887938*^9, 3.762009251963601*^9}, {
  3.762009292041953*^9, 3.762009395825913*^9}, {3.762009984690125*^9, 
  3.762010010814315*^9}, {3.7620101202427387`*^9, 3.762010122554927*^9}, {
  3.762010330413232*^9, 3.762010431220471*^9}, {3.762010564161125*^9, 
  3.76201060359896*^9}, {3.76201064262075*^9, 3.762010735799502*^9}, {
  3.762010781954269*^9, 3.7620108353315983`*^9}, {3.762010868853477*^9, 
  3.762010963650329*^9}, {3.7620111631624327`*^9, 3.7620111829846087`*^9}, {
  3.762011583514689*^9, 3.76201167890795*^9}, {3.7620118036207657`*^9, 
  3.762011859539068*^9}, {3.762011893143111*^9, 3.762011986494491*^9}, {
  3.762037648064176*^9, 3.762037685977306*^9}, {3.762037723843741*^9, 
  3.762037756646413*^9}},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"885031fd-4801-4c18-86f3-8bc456328c16"]
}, Open  ]],

Cell["Okay, let\[CloseCurlyQuote]s code up what these look like!", "Text",
 CellChangeTimes->{{3.762012474244833*^9, 3.762012492095817*^9}, {
  3.7620370989681053`*^9, 3.762037102239688*^9}},
