Cell[TextData[{
 "To re-scale these to an arbitrary range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"a", ",", "b"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "293ecb21-2483-4293-9c94-aecb74179360"],
 " we multiply the abscissa by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], "\[Rule]", 
    RowBox[{"a", "+", 
     RowBox[{
      SubscriptBox["x", "i"], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "122298d5-bc78-43df-bc26-a818941b1e55"]
}], "Text",
 CellChangeTimes->{{3.7620159236025867`*^9, 3.762015998718416*^9}},
