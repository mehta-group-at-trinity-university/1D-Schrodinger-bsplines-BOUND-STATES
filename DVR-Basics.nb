Cell[TextData[{
 "\[LineSeparator]\[LineSeparator]To re-scale these to an arbitrary range ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"a", ",", "b"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "2c1614b0-10c9-40fa-b0b5-3a985aa0e6c3"],
 " we multiply the abscissa by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], "\[Rule]", 
    RowBox[{"a", "+", 
     RowBox[{
      SubscriptBox["x", "i"], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "53f36bc7-e3f5-476b-8f5a-3df3b9681255"]
}], "Text",
 CellChangeTimes->{{3.7620159236025867`*^9, 3.762015998718416*^9}, 
   3.803219749284275*^9, 3.803220582942863*^9},
 TextAlignment->Left,
 TextJustification->0.,ExpressionUUID->"0d07dfd5-0ab7-40d9-a838-c739b556cbef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"-", "5"}]}], ";", 
