Cell["\<\
Now it might be faster to evaluate the cardinal function on the primitive \
interval and then scale it:\
\>", "Text",
 CellChangeTimes->{{3.762099987210894*^9, 
  3.7621000143744707`*^9}},ExpressionUUID->"7c059c6c-08c4-440e-aef4-\
8913ce8c64db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cardinalc", "[", 
    RowBox[{"lxn_", ",", "x_"}], "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["x", "2"]}], ")"}]}], 
         RowBox[{"DP", "[", 
          RowBox[{"A", ",", "x"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"A", 
         RowBox[{"(", 
          RowBox[{"A", "-", "1"}], ")"}], 
         RowBox[{"LegendreP", "[", 
          RowBox[{
