    RowBox[{"b", "-", "a"}], ")"}], "wn"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"xnodes", 
    RowBox[{"(", 
     RowBox[{"b", "-", "a"}], ")"}]}], "+", "a"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"6", 
    RowBox[{"\[Pi]", "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Timing", "[", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      RowBox[{"X", "[", 
       RowBox[{"a", ",", "b"}], "]"}], "]"}], "2"], ".", 
    RowBox[{"W", "[", 
     RowBox[{"a", ",", "b"}], "]"}]}], "]"}], "-", 
  RowBox[{"Timing", "[", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", "x", "]"}], "2"], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}], "]"}]}]}], "Input",
