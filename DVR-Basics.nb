Cell[CellGroupData[{

Cell["States of the spherical oscillator", "Subsection",
 CellChangeTimes->{{3.803227263673937*^9, 
  3.803227267820857*^9}},ExpressionUUID->"a94f6e0c-f578-40cc-89a6-\
96bc5eca0adc"],

Cell["The radial solutions are: ", "Text",
 CellChangeTimes->{{3.8032272585409117`*^9, 
  3.8032272761491003`*^9}},ExpressionUUID->"06259bf7-c803-4d94-bfeb-\
a15d7d042fba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"l_", ",", "n_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox[
     RowBox[{"2", 
      RowBox[{"Gamma", "[", 
       RowBox[{"n", "+", "1"}], "]"}]}], 
     RowBox[{"Gamma", "[", 
      RowBox[{"n", "+", "l", "+", 
       RowBox[{"3", "/", "2"}]}], "]"}]]], 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["r", "2"]}], "/", "2"}]], 
   SuperscriptBox["r", "l"], 
   RowBox[{"LaguerreL", "[", 
    RowBox[{"n", ",", 
     RowBox[{"l", "+", 
      FractionBox["1", "2"]}], ",", 
     SuperscriptBox["r", "2"]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.803227129784095*^9, 
  3.803227209683387*^9}},ExpressionUUID->"40e3866d-adfe-4c53-a187-\
5e1136940931"],

Cell[TextData[{
 "The angular solutions, are of course, the spherical harmonics: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Y", 
     RowBox[{"l", ",", "m"}]], "(", 
    RowBox[{"\[Theta]", ",", "\[Phi]"}]}], TraditionalForm]],ExpressionUUID->
  "7d5a2ae6-ef88-4810-b376-e124bbe7266a"],
 "), but we must take linear combinations of these to satisfy the boundary \
conditions on the hypersphere."
}], "Text",
 CellChangeTimes->{{3.803227281902995*^9, 
  3.8032273431248302`*^9}},ExpressionUUID->"ff6a3da8-7bf1-45f8-846f-\
b6551b29126d"],

Cell[" ", "Text",
 CellChangeTimes->{
  3.8032273183566933`*^9},ExpressionUUID->"7ace2552-d76f-41e9-a9a9-\
9aeaebcab10e"],

