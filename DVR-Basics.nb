Cell["So it nails it apart from an overall normalization. ", "Text",
 CellChangeTimes->{{3.803175528436654*^9, 
  3.803175538233968*^9}},ExpressionUUID->"9e68dd22-1ba6-448d-9298-\
aaf05f60fa24"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Using \[OpenCurlyDoubleQuote]glued\[CloseCurlyDoubleQuote] DVRs", \
"Subsection",
 CellChangeTimes->{{3.762042941814825*^9, 3.7620429439256353`*^9}, {
  3.762086838342382*^9, 
  3.76208686455162*^9}},ExpressionUUID->"09846a05-1863-4384-bff6-\
1514ab12dd36"],

Cell[TextData[{
 "One problem with the current implementation is that the entire domain must \
be treated with one DVR basis so that increasing the accuracy of the \
calculation can only be accomplished by increasing the ",
 StyleBox["order",
  FontSlant->"Italic"],
 " of the polynomial.  It would be nice if we could \
\[OpenCurlyDoubleQuote]stitch\[CloseCurlyDoubleQuote] together different \
segments of the domain and use a lower order polynomial for each segment.  \
The scheme for this is given in the paper by Simoni et al, J. Chem. Phys. \
146, 244106 (2017).  Again, the notation presented there is a little \
different from what is above, and I will attempt to make the translation to \
our notation here."
}], "Text",
 CellChangeTimes->{{3.7620429472467117`*^9, 3.76204295674897*^9}, {
  3.762086867687929*^9, 3.762086993546205*^9}, {3.762087169848297*^9, 
  3.762087283868786*^9}},ExpressionUUID->"57c8f988-0f5f-454f-b37b-\
5abed6c28461"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s consider again a domain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"a", ",", "b"}], "]"}], TraditionalForm]],ExpressionUUID->
  "8d2427f9-c47a-428e-adac-71166af955b0"],
 " where in we wish to solve the Schrodinger equation.  I\[CloseCurlyQuote]ll \
work through the details for the bound state first, reserving the scattering \
calculation for later."
}], "Text",
 CellChangeTimes->{{3.762087314905993*^9, 3.7620873598835278`*^9}, {
  3.762087393170356*^9, 
  3.7620874043457203`*^9}},ExpressionUUID->"dd7cb415-f186-4544-b9d1-\
596f443453dd"],

Cell["\<\
The goal is to implement a lower-order DVR in smaller \
\[OpenCurlyDoubleQuote]elements\[CloseCurlyDoubleQuote] of the total domain, \
and stitch together the different elements using the \
\[OpenCurlyDoubleQuote]gluing\[CloseCurlyDoubleQuote] functions, which are \
just DVR functions at the element boundaries.\
\>", "Text",
 CellChangeTimes->{{3.762087412042501*^9, 
  3.762087476870326*^9}},ExpressionUUID->"59e97a4c-506f-4e1d-bb39-\
cc1d3dcc4350"],

Cell[TextData[{
 "Let us partition the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"a", ",", "b"}], "]"}], TraditionalForm]],ExpressionUUID->
  "98d4c47c-bc96-4bde-a783-c6677d274c70"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "8ee83e45-4dc5-4e50-9f63-7df8f2fd92e2"],
 " sub-intervals, and for each sub-interval ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "710dffaa-301c-4383-98f2-f629a155d0e7"],
 " we generate a set of abscissa and weights ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubsuperscriptBox["x", "\[Alpha]", 
      RowBox[{"(", "n", ")"}]], ",", 
     SubscriptBox["w", "\[Alpha]"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "40b6f794-4919-4092-b874-f784230aa9bc"],
 "  To keep things simple, I\[CloseCurlyQuote]ll assume that the number of \
abscissa, and therefore the weights are the same for each sub-interval. If we \
seek a more accurate solution in a particular part of the domain then we must \
create smaller sub-intervals for that region."
}], "Text",
 CellChangeTimes->{{3.762089783089346*^9, 3.762089910361491*^9}, {
  3.762097097630394*^9, 3.762097183667049*^9}, {3.762097445340879*^9, 
  3.762097480989234*^9}},ExpressionUUID->"68b27e17-25aa-473f-833c-\
4045d8b18079"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "="}], TraditionalForm]],ExpressionUUID->
  "5f6e8f61-6c02-4322-85aa-4c0841c100fe"],
 " (the number of abscissa per sub-interval), including the end-points which \
are common to neighboring sub-intervals. The quadrature rule:"
}], "Text",
 CellChangeTimes->{{3.762097224861013*^9, 3.7620972451738977`*^9}, {
  3.7620972913254957`*^9, 
  3.7620973636059017`*^9}},ExpressionUUID->"07550383-b7a6-43a0-b5cb-\
2332e2cd6018"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     SubsuperscriptBox["x", "1", 
      RowBox[{"(", "n", ")"}]], 
     SubsuperscriptBox["x", "P", 
      RowBox[{"(", "n", ")"}]]], 
    RowBox[{
     RowBox[{"\[DifferentialD]", "x"}], " ", 
     RowBox[{"f", "(", "x", ")"}]}]}], "=", 
   RowBox[{
    OverscriptBox[
     UnderscriptBox["\[Sum]", 
      RowBox[{"\[Alpha]", "=", "1"}]], "P"], 
    RowBox[{
     SubscriptBox["w", "\[Alpha]"], 
     RowBox[{"f", "(", 
      SubsuperscriptBox["x", "\[Alpha]", 
       RowBox[{"(", "n", ")"}]], ")"}]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.762097366911737*^9, 
  3.762097426697418*^9}},ExpressionUUID->"053cc5c9-cd7f-4043-936e-\
21df462ab2f3"],

Cell[TextData[{
 "is exact for polynomial functions up to order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "P"}], "-", "3"}], TraditionalForm]],ExpressionUUID->
  "7a31c138-1528-4d17-99ba-d1221d95a6bc"],
 ". Let the \[OpenCurlyDoubleQuote]Lobatto shape functions\
\[CloseCurlyDoubleQuote] be defined as:"
}], "Text",
 CellChangeTimes->{{3.76209749566039*^9, 3.762097527930778*^9}, {
  3.7620976636644993`*^9, 
  3.762097690140945*^9}},ExpressionUUID->"164dc5bc-6b54-40fa-8059-\
20d8618a6877"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["C", "i", 
     RowBox[{"(", "n", ")"}]], "(", "x", ")"}], "=", 
   RowBox[{
    SubscriptBox["c", "i"], "(", 
    RowBox[{
     RowBox[{"2", " ", 
      FractionBox[
       RowBox[{"x", "-", 
        SubsuperscriptBox["x", "1", 
         RowBox[{"(", "n", ")"}]]}], 
       RowBox[{
        SubsuperscriptBox["x", "P", 
         RowBox[{"(", "n", ")"}]], "-", 
        SubsuperscriptBox["x", "1", 
         RowBox[{"(", "n", ")"}]]}]]}], "-", "1"}], ")"}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.762097693557176*^9, 3.762097701730957*^9}, {
  3.762101314838111*^9, 
  3.762101370463422*^9}},ExpressionUUID->"9693f5da-6279-4419-af61-\
1e5ab77807ba"],

Cell[TextData[{
 "The cardinal function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "i"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "37bc1963-f6e6-46b6-b783-fde0b90ef89e"],
 " is defined as:"
}], "Text",
 CellChangeTimes->{{3.7620978669063797`*^9, 
  3.762097886104697*^9}},ExpressionUUID->"3a6f3fe1-90df-40fa-857b-\
17b60a240ba0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["c", "i"], "(", "x", ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}], ")"}]}], 
     RowBox[{
      RowBox[{"A", "(", 
       RowBox[{"A", "-", "1"}], ")"}], 
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"A", "-", "1"}]], "(", 
       SubscriptBox["x", "i"], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "i"]}], ")"}]}]], 
    FractionBox[
     RowBox[{"\[DifferentialD]", 
      RowBox[{
       SubscriptBox["P", 
        RowBox[{"A", "-", "1"}]], "(", "x", ")"}]}], 
     RowBox[{"\[DifferentialD]", "x"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.762097888200904*^9, 3.76209790327212*^9}, {
  3.762097981054048*^9, 3.762098036225716*^9}, {3.762098127018394*^9, 
  3.762098135041731*^9}},ExpressionUUID->"4f4eeb9d-248b-47ca-9c98-\
a5cbebf81303"],

Cell[TextData[{
 "Here, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"M", "+", "2"}]}], TraditionalForm]],ExpressionUUID->
  "293b4cdb-3ecd-4bbe-a235-12b0a429a0ad"],
 " from earlier, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "i"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "6d06a6f9-8008-4957-9d9e-622b0a2c66f7"],
 " are exactly the same as the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Chi]", "i", "GL"], "(", "x", ")"}], 
   TraditionalForm]],ExpressionUUID->"dcb23da5-d7eb-499a-9313-39fae4c98725"],
 " we had earlier. Let\[CloseCurlyQuote]s do some tests to make sure:"
}], "Text",
 CellChangeTimes->{{3.7621013969054193`*^9, 
  3.7621014645748463`*^9}},ExpressionUUID->"56fd1f11-e75b-4d25-9ca7-\
6172a9d0285c"],

