Cell[BoxData[
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"-", "7"}]}], ";", 
  RowBox[{"b", "=", "7"}], ";", 
  RowBox[{"xn", "=", 
   RowBox[{
    RowBox[{"xnodes", 
