Cell[BoxData[
 RowBox[{
  RowBox[{"M", "=", "40"}], ";", 
  RowBox[{"precision", "=", "20"}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xnodes", ",", "wn", ",", "errwn"}], "}"}], "=", 
