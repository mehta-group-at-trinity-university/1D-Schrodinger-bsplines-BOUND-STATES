Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline22", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "lk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"BSplineBasis", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"BSOrder", ",", 
          RowBox[{"Knots", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "result"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.67326147311099*^9, 3.673261482023984*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"7b9dc3c3-2dca-458d-b755-31bda8754126"],

