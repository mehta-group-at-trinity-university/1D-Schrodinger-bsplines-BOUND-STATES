Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline00", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "lk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"BSplineBasis", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"BSOrder", ",", 
          RowBox[{"Knots", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;", 
             RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "result"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.673258785456602*^9, 3.673258885654035*^9}, {
