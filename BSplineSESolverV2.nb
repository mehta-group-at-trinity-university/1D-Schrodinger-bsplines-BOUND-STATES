e8fbd6c00443"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline10", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "lk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"result", "=", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], "}"}], ",", "0", 
           ",", "x"}], "]"}], "+", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", 
                RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], "}"}], ",", "1", 
           ",", "x"}], "]"}]}]}], ",", 
       RowBox[{"result", "=", 
        RowBox[{"BSplineBasis", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"BSOrder", ",", 
            RowBox[{"Knots", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", 
               RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "result"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.673261787970378*^9, 3.673261844480548*^9}, {
  3.677430903679055*^9, 3.677430903745297*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"bd79d665-16e8-4fb9-b77b-5863ef488db4"],

