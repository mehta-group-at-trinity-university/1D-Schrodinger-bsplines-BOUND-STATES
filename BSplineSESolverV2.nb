Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline11", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "lk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"result", "=", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", "0", 
           ",", "x"}], "]"}], "+", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", "1", 
           ",", "x"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"n", "\[Equal]", 
        RowBox[{"xDim", "[", 
         RowBox[{"BSOrder", ",", "xNumPoints", ",", "1", ",", "1"}], "]"}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"result", "=", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"n", "+", "1"}], ",", "x"}], "]"}], "+", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", "n", 
           ",", "x"}], "]"}]}]}], ",", "True", ",", "\[IndentingNewLine]", 
       RowBox[{"result", "=", 
        RowBox[{"BSplineBasis", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"BSOrder", ",", 
            RowBox[{"Knots", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", "n", ",",
           "x"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "result"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.6732639948256693`*^9, 3.6732640190021276`*^9}, {
  3.673264063511159*^9, 3.6732641045569973`*^9}, {3.673264141973093*^9, 
