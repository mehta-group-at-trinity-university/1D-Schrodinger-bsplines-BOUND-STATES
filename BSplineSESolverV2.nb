Cell[BoxData[
 RowBox[{
  RowBox[{"xDim", "[", 
   RowBox[{"Order_", ",", "xNumPoints_", ",", "LBC_", ",", "RBC_"}], "]"}], ":=", 
  RowBox[{"Which", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LBC", "\[Equal]", "2"}], "&&", 
     RowBox[{"RBC", "\[Equal]", "2"}]}], ",", 
    RowBox[{"xNumPoints", "+", "Order", "-", "1"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LBC", "\[NotEqual]", "2"}], "&&", 
     RowBox[{"RBC", "\[Equal]", "2"}]}], ",", 
    RowBox[{"xNumPoints", "+", "Order", "-", "2"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LBC", "\[Equal]", "2"}], "&&", 
     RowBox[{"RBC", "\[NotEqual]", "2"}]}], ",", 
    RowBox[{"xNumPoints", "+", "Order", "-", "2"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LBC", "!=", "2"}], "&&", 
     RowBox[{"RBC", "\[NotEqual]", "2"}]}], ",", 
    RowBox[{"xNumPoints", "+", "Order", "-", "3"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.672844018140184*^9, 3.672844029424863*^9}, {
