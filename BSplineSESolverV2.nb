Cell[BoxData[
 RowBox[{
  RowBox[{"MakexBounds", "[", 
   RowBox[{"LBC_", ",", "RBC_", ",", "xNumPoints_", ",", "Knots_"}], "]"}], 
  ":="}]], "Input",
