Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline01", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "lk"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[Equal]", 
        RowBox[{"xDim", "[", 
         RowBox[{"BSOrder", ",", "xNumPoints", ",", "0", ",", "1"}], "]"}]}], 
       ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"result", "=", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", "n", 
           ",", "x"}], "]"}], "+", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", 
             RowBox[{"Knots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], ",", 
       RowBox[{"result", "=", 
        RowBox[{"BSplineBasis", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"BSOrder", ",", 
            RowBox[{"Knots", "[", 
             RowBox[{"[", 
              RowBox[{"2", ";;", "lk"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "result"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.6732615123312407`*^9, 3.673261515894606*^9}, {
   3.6732615535103617`*^9, 3.673261585188558*^9}, {3.6732617536668262`*^9, 
