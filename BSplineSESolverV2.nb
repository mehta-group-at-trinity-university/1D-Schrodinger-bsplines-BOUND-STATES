Cell["\<\
Now, we define a function to give the basis function for each left/right \
boundary condition.\
\>", "Text",
 CellChangeTimes->{{3.673274959375801*^9, 
  3.6732749856648684`*^9}},ExpressionUUID->"7c699580-b9ea-47c5-8cd9-\
01e4830c2323"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "n_", ",", "x_", ",", 
    "LBC_", ",", "RBC_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "kn", ",", "lk", ",", "xd"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xd", "=", 
      RowBox[{"xDim", "[", 
       RowBox[{"BSOrder", ",", "xNumPoints", ",", "LBC", ",", "RBC"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "2"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "2"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", "Knots"}], ";", "\[IndentingNewLine]", "\t", 
        RowBox[{"result", "=", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
           RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "1"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "1"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", "Knots"}], ";", "\[IndentingNewLine]", "\t", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
             "]"}], "+", 
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "1", ",", "x"}], 
             "]"}]}]}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"n", "\[Equal]", "xd"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
              RowBox[{"xd", "+", "1"}], ",", "x"}], "]"}], "+", 
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "xd", ",", "x"}], 
             "]"}]}]}], ",", "\[IndentingNewLine]", "\t", "True", ",", 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "n", ",", "x"}], 
            "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "0"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "0"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
         RowBox[{"Knots", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", 
            RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"result", "=", 
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
           RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "0"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "1"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
         RowBox[{"Knots", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", "lk"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "\[Equal]", "xd"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "xd", ",", "x"}], 
             "]"}], "+", 
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
              RowBox[{"xd", "-", "1"}], ",", "x"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
             RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "1"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "0"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
         RowBox[{"Knots", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
             "]"}], "+", 
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "1", ",", "x"}], 
             "]"}]}]}], ",", " ", 
          RowBox[{"result", "=", 
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "n", ",", "x"}], 
            "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "0"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "2"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
         RowBox[{"Knots", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", "lk"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"result", "=", 
         RowBox[{"BSplineBasis", "[", 
