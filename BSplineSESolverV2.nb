Cell["\<\
For the \[OpenCurlyDoubleQuote]3\[CloseCurlyDoubleQuote] boundary condition \
we wish to allow for arbitrary log-derivative at the boundary.  We therefore \
let the (first) last B-spline be an arbitrary linear combination of the \
(first two) last two B-splines implied by the full knot sequence.  For \
example, at the left boundary:\
\>", "Text",
 CellChangeTimes->{{3.878901305666473*^9, 3.878901403239341*^9}, {
  3.8789120798225594`*^9, 
  3.878912084560514*^9}},ExpressionUUID->"2a67d3e9-f7a0-49a8-83b2-\
6f30dd8ab47f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Psi]", "'"}], 
       RowBox[{"(", "x", ")"}]}], 
      RowBox[{"\[Psi]", "(", "x", ")"}]], ")"}], 
    RowBox[{"x", "=", 
     SubscriptBox["x", "l"]}]], "=", 
   RowBox[{
    SubscriptBox["K", "l"], "=", 
    SubscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{
         SubscriptBox["C", "1"], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{
            SubscriptBox["B", "1"], "(", "x", ")"}]}], 
          RowBox[{"\[PartialD]", "x"}]]}], "+", 
        RowBox[{
         SubscriptBox["C", "2"], 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{
            SubscriptBox["B", "2"], "(", "x", ")"}]}], 
          RowBox[{"\[PartialD]", "x"}]]}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["C", "1"], 
         RowBox[{
          SubscriptBox["B", "1"], "(", "x", ")"}]}], "+", 
        RowBox[{
         SubscriptBox["C", "2"], 
         RowBox[{
          SubscriptBox["B", "2"], "(", "x", ")"}]}]}]], ")"}], 
     RowBox[{"x", "=", 
      SubscriptBox["x", "l"]}]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.878912027026153*^9, 
  3.878912225468357*^9}},ExpressionUUID->"ecf4029b-2465-4893-b978-\
ff9387fca4df"],

Cell[TextData[{
 "Now we use the fact that only ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["B", "1"], "(", 
     SubscriptBox["x", "l"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"6d92e5dd-2a3b-4db0-a5f0-c14bb51e61fa"],
 ", while ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]],ExpressionUUID->
  "e6d23cb5-2b14-4f03-a917-d5ef24f4b9e1"],
 " and indeed all other ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "n"], TraditionalForm]],ExpressionUUID->
  "66aa63c8-0bd3-49ee-8e09-55ea6da48113"],
 " vanish at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     SubscriptBox["x", "l"], "."}]}], TraditionalForm]],ExpressionUUID->
  "593d5931-f381-4f8a-98a7-223e72b52507"]
}], "Text",
 CellChangeTimes->{{3.878912238082364*^9, 
  3.878912349330803*^9}},ExpressionUUID->"ae702740-447d-4d1d-bfd8-\
be327d7918a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["K", "l"], "=", 
   SubscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["C", "1"], "/", 
         SubscriptBox["C", "2"]}], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{
           SubscriptBox["B", "1"], "(", "x", ")"}]}], 
         RowBox[{"\[PartialD]", "x"}]]}], "+", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{
          SubscriptBox["B", "2"], "(", "x", ")"}]}], 
        RowBox[{"\[PartialD]", "x"}]]}], 
      RowBox[{
       RowBox[{
        SubscriptBox["C", "1"], "/", 
        SubscriptBox["C", "2"]}], 
       RowBox[{
        SubscriptBox["B", "1"], "(", "x", ")"}]}]], ")"}], 
    RowBox[{"x", "=", 
     SubscriptBox["x", "l"]}]]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.8789123571534443`*^9, 3.878912375692416*^9}, {
  3.87891247658392*^9, 
  3.878912484723135*^9}},ExpressionUUID->"3379823a-1e7e-4446-9b26-\
76913f27a930"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SubscriptBox["C", "1"], 
    SubscriptBox["C", "2"]], "=", 
   RowBox[{
    SubscriptBox["C", "l"], "=", 
    FractionBox[
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{
        SubscriptBox["B", "2"], "(", 
        SubscriptBox["x", "l"], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["K", "l"], 
        RowBox[{
         SubscriptBox["B", "1"], "(", 
         SubscriptBox["x", "l"], ")"}]}], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{
          SubscriptBox["B", "1"], "(", 
          SubscriptBox["x", "l"], ")"}]}], 
        RowBox[{"\[PartialD]", "x"}]]}], ")"}]]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.8789123571534443`*^9, 3.878912375692416*^9}, {
  3.87891247658392*^9, 3.878912555098546*^9}, {3.878982206255013*^9, 
  3.8789822095598707`*^9}},ExpressionUUID->"69284c81-b3d5-4da4-926e-\
b5b84afeb51b"],

Cell["This amounts to letting the left-most B-spline be ", "Text",
 CellChangeTimes->{{3.878912624064742*^9, 
  3.8789126446111794`*^9}},ExpressionUUID->"5b5635de-89d8-4532-9646-\
19dde9e5850f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox[
      SubscriptBox["B", "l"], "~"], "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["C", "l"], " ", 
      SubscriptBox["B", "1"]}], "+", 
     SubscriptBox["B", "2"]}]}], ",", "   ", 
   RowBox[{
    SubscriptBox["C", "l"], "=", 
    FractionBox[
     SubscriptBox["C", "1"], 
     SubscriptBox["C", "2"]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.878912624064742*^9, 3.878912694008699*^9}, {
  3.878912771238472*^9, 3.8789127715008097`*^9}, {3.878912836937345*^9, 
  3.8789128399466476`*^9}},ExpressionUUID->"58b28fa0-a9f8-4a34-97e7-\
15e036f36144"],

Cell["Similarly for the right-most B-spline", "Text",
 CellChangeTimes->{{3.87891271391432*^9, 
  3.878912730922635*^9}},ExpressionUUID->"452f9e08-00f5-42b0-9c39-\
36d2c0ebc128"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     OverscriptBox[
      SubscriptBox["B", "r"], "~"], "(", "x", ")"}], "=", 
    RowBox[{
     SubscriptBox["B", 
      RowBox[{"N", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["C", "r"], 
      RowBox[{
       SubscriptBox["B", "N"], "(", "x", ")"}]}]}]}], ",", "  ", 
   RowBox[{
    SubscriptBox["C", "r"], "=", 
    FractionBox[
     SubscriptBox["C", "N"], 
     SubscriptBox["C", 
      RowBox[{"N", "-", "1"}]]]}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.8789127602206707`*^9, 3.8789127891383944`*^9}, {
  3.878912833322576*^9, 
  3.878912858132457*^9}},ExpressionUUID->"eea80187-81aa-46e7-b8d8-\
b4ad5a311fb8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["K", "r"], "=", 
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Psi]", "'"}], 
        RowBox[{"(", "x", ")"}]}], 
       RowBox[{"\[Psi]", "(", "x", ")"}]], ")"}], 
     RowBox[{"x", "=", 
      SubscriptBox["x", "r"]}]], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       FractionBox[
        SubsuperscriptBox[
         OverscriptBox["B", "~"], "r", "'"], 
        SubscriptBox[
         OverscriptBox["B", "~"], "r"]], ")"}], 
      SubscriptBox["x", "r"]], "=", 
     FractionBox[
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", 
         RowBox[{
          SubscriptBox["B", 
           RowBox[{"N", "-", "1"}]], "(", 
          SubscriptBox["x", "r"], ")"}]}], 
        RowBox[{"\[PartialD]", "x"}]], "+", 
       RowBox[{
        SubscriptBox["C", "r"], 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{
           SubscriptBox["B", "N"], "(", 
           SubscriptBox["x", "r"], ")"}]}], 
         RowBox[{"\[PartialD]", "x"}]]}]}], 
      RowBox[{
       RowBox[{
        SubscriptBox["B", 
         RowBox[{"N", "-", "1"}]], "(", 
        SubscriptBox["x", "r"], ")"}], "+", 
       RowBox[{
        SubscriptBox["C", "r"], 
        RowBox[{
         SubscriptBox["B", "N"], "(", 
         SubscriptBox["x", "r"], ")"}]}]}]]}]}]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.8789127602206707`*^9, 3.8789127891383944`*^9}, {
  3.878912833322576*^9, 
  3.878913041549418*^9}},ExpressionUUID->"d0d29745-d5f1-4c44-93dd-\
4701e4cfa3a5"],

Cell[TextData[{
 "But now only ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "N"], TraditionalForm]],ExpressionUUID->
  "55ceef7f-0190-4fc5-9f33-e315612a9d51"],
 " is nonzero at the right boundary"
}], "Text",
 CellChangeTimes->{{3.87891305065443*^9, 
  3.87891306575462*^9}},ExpressionUUID->"4cc738d7-f2d8-4919-b2b0-\
f647419348c7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["K", "r"], "=", 
   FractionBox[
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{
        SubscriptBox["B", 
         RowBox[{"N", "-", "1"}]], "(", 
        SubscriptBox["x", "r"], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]], "+", 
     RowBox[{
      SubscriptBox["C", "r"], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         SubscriptBox["B", "N"], "(", 
         SubscriptBox["x", "r"], ")"}]}], 
       RowBox[{"\[PartialD]", "x"}]]}]}], 
    RowBox[{
     SubscriptBox["C", "r"], 
     RowBox[{
      SubscriptBox["B", "N"], "(", 
      SubscriptBox["x", "r"], ")"}]}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.87891271391432*^9, 3.8789127208820744`*^9}, {
  3.8789130729126043`*^9, 3.878913090120364*^9}, {3.878913121604788*^9, 
  3.878913124689639*^9}},ExpressionUUID->"e077a6df-047c-4903-a859-\
bb9ddae7aca5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["C", "r"], "=", 
   FractionBox[
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{
       SubscriptBox["B", 
        RowBox[{"N", "-", "1"}]], "(", 
       SubscriptBox["x", "r"], ")"}]}], 
     RowBox[{"\[PartialD]", "x"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["K", "r"], 
       RowBox[{
        SubscriptBox["B", "N"], "(", 
        SubscriptBox["x", "r"], ")"}]}], "-", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         SubscriptBox["B", "N"], "(", 
         SubscriptBox["x", "r"], ")"}]}], 
       RowBox[{"\[PartialD]", "x"}]]}], ")"}]]}], 
  TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.878913129675468*^9, 
  3.878913179059165*^9}},ExpressionUUID->"868ed686-4aed-48ee-8f8e-\
0af6446ca2f3"],

Cell[TextData[{
 "Note that alternatively, one may rescale ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["B", "~"], "r"], TraditionalForm]],ExpressionUUID->
  "3d10b4fd-80a6-4890-956a-db81a744ad73"],
 " by dividing by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "r"], TraditionalForm]],ExpressionUUID->
  "285db2a6-ccc2-4ae3-9fb2-4779eb7f8d6f"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox[
       SubscriptBox["B", "r"], "~"], "(", "x", ")"}], "\[Rule]", " ", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SubscriptBox["C", "r"]], 
       SubscriptBox["B", 
        RowBox[{"N", "-", "1"}]]}], "+", 
      RowBox[{
       SubscriptBox["B", "N"], "(", "x", ")"}]}]}], ","}], TraditionalForm]],
  ExpressionUUID->"f42f5da1-c684-4e49-8268-da42543dba4f"],
 " which simply amounts to changing the overall scale of the basis function.  \
This ends up being more numerically stable, since it still ensures that the \
value of the basis function approaches 1 at the edge."
}], "Text",
 CellChangeTimes->{{3.878981836829411*^9, 
  3.878981837724607*^9}},ExpressionUUID->"fdbda023-286d-45e4-b630-\
a58834705de7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyBSpline33", "[", 
   RowBox[{
   "BSOrder_", ",", "xNumPoints_", ",", "Knots_", ",", "Kl_", ",", "Kr_", ",",
     "n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "result", ",", "lk", ",", "xd", ",", "kn", ",", "Cl", ",", "Cr", ",", 
      "xL", ",", "xR"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lk", "=", 
      RowBox[{"Length", "[", "Knots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xL", "=", 
      RowBox[{"Knots", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xR", "=", 
      RowBox[{"Knots", "[", 
       RowBox[{"[", "lk", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"kn", "=", 
      RowBox[{"Knots", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "lk"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xd", "=", 
      RowBox[{"xDim", "[", 
       RowBox[{"BSOrder", ",", "xNumPoints", ",", "1", ",", "1"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Cl", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "1", ",", "x"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "1"}], "}"}]}], "]"}], 
        RowBox[{
         RowBox[{"Kl", " ", 
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
           "]"}]}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]], "/.", 
       RowBox[{"x", "\[Rule]", "xL"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Cr", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "xd", ",", "x"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "1"}], "}"}]}], "]"}], 
        RowBox[{
         RowBox[{"Kr", " ", 
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
            RowBox[{"xd", "+", "1"}], ",", "x"}], "]"}]}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
             RowBox[{"xd", "+", "1"}], ",", "x"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]], "/.", 
       RowBox[{"x", "\[Rule]", "xR"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"result", "=", " ", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
          "]"}], "+", 
         RowBox[{
          FractionBox["1", "Cl"], 
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "1", ",", "x"}], 
           "]"}]}]}]}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"n", "\[Equal]", "xd"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"result", "=", " ", 
        RowBox[{
         RowBox[{"BSplineBasis", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
           RowBox[{"xd", "+", "1"}], ",", "x"}], "]"}], "+", 
         RowBox[{
          FractionBox["1", "Cr"], 
          RowBox[{"BSplineBasis", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "xd", ",", "x"}], 
           "]"}]}]}]}], ",", "\[IndentingNewLine]", "\t", "True", ",", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"result", "=", 
        RowBox[{"BSplineBasis", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "n", ",", "x"}], 
         "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.878169956063651*^9, 3.878169964185831*^9}, {
  3.878169995920021*^9, 3.8781700075838213`*^9}, {3.878170059036903*^9, 
  3.878170079891913*^9}, {3.878170111390243*^9, 3.878170112181596*^9}, {
  3.8789818763912563`*^9, 3.8789818811048117`*^9}, {3.878981976863653*^9, 
  3.878981982163548*^9}, {3.87898201448976*^9, 3.87898201618332*^9}, {
  3.878982085906081*^9, 3.8789821069262543`*^9}, {3.878982174594816*^9, 
