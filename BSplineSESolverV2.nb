7d7ffc2a9ab3"],

Cell[TextData[{
 "First we\[CloseCurlyQuote]ll treat bound states for which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "(", "x", ")"}], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"eb8fb7f0-94ce-4aed-bd94-bb31c0dad884"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Rule]", 
    RowBox[{"\[PlusMinus]", "\[Infinity]"}]}], TraditionalForm]],
  ExpressionUUID->"64702d65-1407-4700-91b3-4514178a7803"],
 ".  Solving the system in a box we will allow four kinds of boundary \
conditions at each boundary.  For example, at the left boundary:"
}], "Text",
 CellChangeTimes->{{3.67283601891809*^9, 
  3.6728361874012947`*^9}},ExpressionUUID->"984ac6f0-f69e-4f62-a94e-\
3f90a3c887a0"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\[Piecewise]", GridBox[{
        {
         RowBox[{"LBC", "=", "0"}], 
         RowBox[{
          RowBox[{"\[Psi]", "(", 
           SubscriptBox["x", "left"], ")"}], "=", "0"}]},
        {
         RowBox[{"LBC", "=", "1"}], 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"\[DifferentialD]", "\[Psi]"}], 
             RowBox[{"\[DifferentialD]", "x"}]], ")"}], 
           SubscriptBox["x", "left"]], "=", "0"}]},
        {
         RowBox[{"LBC", "=", "2"}], 
         RowBox[{"open", " ", "BC", " ", 
          RowBox[{"(", 
           RowBox[{"no", " ", "constraints"}], ")"}]}]},
        {
         RowBox[{"LBC", "=", "3"}], 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "\[Psi]"], 
             FractionBox[
              RowBox[{"\[DifferentialD]", "\[Psi]"}], 
              RowBox[{"\[DifferentialD]", "x"}]]}], ")"}], "xleft"], "=", 
          SubscriptBox["k", "left"]}]}
       },
       AllowedDimensions->{2, Automatic},
       Editable->True,
       GridBoxAlignment->{
        "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}},
          "RowsIndexed" -> {}},
