Cell["\<\
Our first goal is to construct the basis set.  We start with the knot set:\
\>", "Text",
 CellChangeTimes->{{3.6728366036129227`*^9, 
  3.672836628502179*^9}},ExpressionUUID->"9ff121a3-f5b5-489a-bd08-\
0cb0de61766f"],

Cell["Let\[CloseCurlyQuote]s initialize some parameters:", "Text",
 CellChangeTimes->{{3.672844037355936*^9, 
  3.672844050568676*^9}},ExpressionUUID->"9f6d0531-c6d5-47fe-b5ff-\
0683519bf509"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xLinearGrid", "[", 
    RowBox[{"xLeft_", ",", "xRight_", ",", "xNumPoints_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dx", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"xRight", "-", "xLeft"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"xNumPoints", "-", "1"}], ")"}]]}], "}"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"xLeft", ",", "xRight", ",", "dx"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MakeKnots", "[", 
   RowBox[{"LBC_", ",", "RBC_", ",", "xGrid_", ",", "BSOrder_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kn", ",", 
      RowBox[{"xNumPoints", "=", 
       RowBox[{"Length", "[", "xGrid", "]"}]}], ",", 
      RowBox[{"xL", "=", 
       RowBox[{"xGrid", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"xR", "=", 
       RowBox[{"xGrid", "[", 
        RowBox[{"[", 
         RowBox[{"Length", "[", "xGrid", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
    
    RowBox[{
     RowBox[{"kn", "=", 
      RowBox[{"PadRight", "[", 
       RowBox[{
        RowBox[{"PadLeft", "[", 
         RowBox[{"xGrid", ",", 
          RowBox[{"xNumPoints", "+", "BSOrder"}], ",", "xL"}], "]"}], ",", 
        RowBox[{"xNumPoints", "+", 
         RowBox[{"2", "BSOrder"}]}], ",", "xR"}], "]"}]}], ";", "kn"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.672835952404675*^9, 3.672835965450815*^9}, {
   3.672836669859049*^9, 3.6728368818032293`*^9}, {3.672836947729776*^9, 
   3.67283701673501*^9}, {3.6728371951201887`*^9, 3.6728372740193768`*^9}, {
   3.67283734639459*^9, 3.6728373515431223`*^9}, {3.672837453925242*^9, 
