Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LBC", "=", "2"}], ";", 
  RowBox[{"RBC", "=", "1"}], ";", 
  RowBox[{"BSOrder", "=", "3"}], ";", 
  RowBox[{"xNumPoints", "=", "11"}], ";", 
  RowBox[{"xLeft", "=", "0"}], ";", 
  RowBox[{"xRight", "=", "10"}], ";", 
  RowBox[{"xGrid", "=", 
   RowBox[{"xLinearGrid", "[", 
