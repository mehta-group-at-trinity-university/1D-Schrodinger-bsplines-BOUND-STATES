           RowBox[{"{", 
            RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
           RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "2"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "0"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
         RowBox[{"Knots", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"lk", "-", "1"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"result", "=", 
           RowBox[{
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "0", ",", "x"}], 
             "]"}], "+", 
            RowBox[{"BSplineBasis", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", "1", ",", "x"}], 
             "]"}]}]}], ",", 
          RowBox[{"result", "=", 
           RowBox[{"BSplineBasis", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"BSOrder", ",", "kn"}], "}"}], ",", 
             RowBox[{"n", "-", "1"}], ",", "x"}], "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"LBC", "\[Equal]", "1"}], "&&", 
        RowBox[{"RBC", "\[Equal]", "2"}]}], ",", "\[IndentingNewLine]", "\t", 
       
       RowBox[{
        RowBox[{"kn", "=", 
